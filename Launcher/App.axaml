<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             xmlns:v="using:VuluLauncher.Views"
             x:Class="VuluLauncher.App"
             RequestedThemeVariant="Dark">

    <!-- Sayfa modelinden görünüme: sekme içeriği ContentControl'e model olarak verilir -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel"><v:HomeView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="vm:DiscoverViewModel"><v:DiscoverView /></DataTemplate>
        <DataTemplate DataType="vm:ServersViewModel"><v:ServersView /></DataTemplate>
        <DataTemplate DataType="vm:SocialViewModel"><v:SocialView /></DataTemplate>
        <DataTemplate DataType="vm:ProfileViewModel"><v:ProfileView /></DataTemplate>
        <DataTemplate DataType="vm:AdminViewModel"><v:AdminView /></DataTemplate>
        <DataTemplate DataType="vm:PlaceholderViewModel"><v:PlaceholderView /></DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- ── Meşale renkleri (css/mesale.css ile aynı) ─────────────── -->
            <Color x:Key="BgColor">#0B0A09</Color>
            <Color x:Key="AccentColor">#F2A33A</Color>
            <SolidColorBrush x:Key="Bg" Color="#0B0A09" />
            <SolidColorBrush x:Key="Panel" Color="#14100C" />
            <!-- Sayfa yan panelleri: arkadaki bulanık zemin görünsün, panel hafif koyu bir camla ayrılsın -->
            <SolidColorBrush x:Key="SidePanel" Color="#6B000000" />
            <SolidColorBrush x:Key="Surface" Color="#1B1510" />
            <SolidColorBrush x:Key="Raised" Color="#281F17" />
            <SolidColorBrush x:Key="Card" Color="#D61A140F" />
            <SolidColorBrush x:Key="Glass" Color="#DB14100C" />
            <SolidColorBrush x:Key="Hover" Color="#12FFE2BA" />
            <SolidColorBrush x:Key="Line" Color="#1AFFD8A0" />
            <SolidColorBrush x:Key="LineStrong" Color="#33FFD8A0" />
            <SolidColorBrush x:Key="ButtonBg" Color="#EB261E17" />
            <SolidColorBrush x:Key="ButtonLine" Color="#4DFFD8A0" />
            <SolidColorBrush x:Key="Text" Color="#F3ECE2" />
            <SolidColorBrush x:Key="Muted" Color="#C9BDAF" />
            <SolidColorBrush x:Key="Dim" Color="#A1958A" />
            <SolidColorBrush x:Key="Accent" Color="#F2A33A" />
            <SolidColorBrush x:Key="AccentHi" Color="#FFC873" />
            <SolidColorBrush x:Key="AccentSoft" Color="#29F2A33A" />
            <SolidColorBrush x:Key="AccentInk" Color="#1A0E02" />
            <!-- Ana düğme: yukarıdan aşağı koyulaşan amber (mesale.css .btn-primary) -->
            <LinearGradientBrush x:Key="PrimaryFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#EDA23A" />
                <GradientStop Offset="1" Color="#D9852A" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PrimaryFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#F5B04C" />
                <GradientStop Offset="1" Color="#E39236" />
            </LinearGradientBrush>
            <!-- Giriş ekranının zemini: ortada sıcak bir ışık (Ufkun öbür ucu'nda saydam: arkadaki sahne görünür) -->
            <RadialGradientBrush x:Key="LoginBg" Center="50%,45%" GradientOrigin="50%,45%" RadiusX="60%" RadiusY="55%">
                <GradientStop Color="#3A2410" Offset="0" />
                <GradientStop Color="#160F09" Offset="0.55" />
                <GradientStop Color="#0B0A09" Offset="1" />
            </RadialGradientBrush>
            <!-- Profil kapağı yoksa -->
            <LinearGradientBrush x:Key="BannerFallback" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#3A2410" Offset="0" />
                <GradientStop Color="#14100C" Offset="1" />
            </LinearGradientBrush>
            <!-- Seçili sekmenin üstten gelen ışığı -->
            <RadialGradientBrush x:Key="TabGlow" Center="50%,0%" GradientOrigin="50%,0%" RadiusX="62%" RadiusY="90%">
                <GradientStop Offset="0" Color="#33F2A33A" />
                <GradientStop Offset="1" Color="#00F2A33A" />
            </RadialGradientBrush>
            <!-- Başlık çubuğu (tema değişince rengi değişir) -->
            <SolidColorBrush x:Key="TitleBarBg" Color="#E60B0A09" />
            <SolidColorBrush x:Key="Ok" Color="#9CC3DE" />
            <SolidColorBrush x:Key="Warn" Color="#FFC873" />
            <SolidColorBrush x:Key="Error" Color="#E8693A" />

            <FontFamily x:Key="Sans">avares://vulu Launcher/Assets/Fonts#IBM Plex Sans</FontFamily>
            <FontFamily x:Key="Mono">avares://vulu Launcher/Assets/Fonts#IBM Plex Mono</FontFamily>
            <FontFamily x:Key="Script">avares://vulu Launcher/Assets/Fonts#Great Vibes</FontFamily>
            <FontFamily x:Key="Pixel">avares://vulu Launcher/Assets/Fonts#Silkscreen</FontFamily>

            <!-- Fluent temasının vurgu rengi (seçim, odak, kaydırma çubuğu) Meşale'ye çekilir -->
            <Color x:Key="SystemAccentColor">#F2A33A</Color>
            <Color x:Key="SystemAccentColorLight1">#FFC873</Color>
            <Color x:Key="SystemAccentColorDark1">#C27E3E</Color>
            <!-- Yuvarlak profil resmi; yoksa baş harf, çevrimiçiyse nokta -->
        <DataTemplate x:Key="Avatar" x:DataType="vm:PersonItem">
            <Panel Width="34" Height="34">
                <Border Background="{StaticResource Raised}" CornerRadius="17" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <Ellipse Classes="dot" Classes.playing="{Binding IsPlaying}" IsVisible="{Binding IsOnline}" Width="10" Height="10"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{StaticResource Panel}" StrokeThickness="2" />
            </Panel>
        </DataTemplate>
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

            <!-- Aç/kapa düğmesi: açıkken Meşale turuncusu -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#F2A33A" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFC873" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#C27E3E" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#1A0E02" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#1A0E02" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#1A0E02" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#4DFFD8A0" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#C9BDAF" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector=":is(TopLevel)">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <!-- Yazı rengi pencereden miras alınır; düğme içindeki yazı düğmenin rengini (üstüne gelince de) alır -->
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource Muted}" /></Style>
        <Style Selector="TextBlock.dim"><Setter Property="Foreground" Value="{StaticResource Dim}" /></Style>
        <!-- Sayfa başlığı (mesale.css .page-head h1: ince, büyük) -->
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="LetterSpacing" Value="-1" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- ── Düğmeler ─────────────────────────────────────────────── -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- Basınca 1 piksel iner (web: .btn:active translateY(1px)); Fluent'in küçülmesi yerine -->
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.06" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="translateY(1px)" />
        </Style>
        <!-- Renkler anında değil, web'deki gibi kısa bir geçişle değişir -->
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Raised}" />
        </Style>
        <!-- Devre dışı: rengini korur, solar (web: .btn:disabled opacity .45) -->
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource PrimaryFill}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="inset 0 1 0 0 #4DFFECC8" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryFillHover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
            <Setter Property="BoxShadow" Value="inset 0 1 0 0 #5CFFECC8" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryFill}" />
        </Style>

        <!-- Düz düğme: yalnızca simge ya da metin (başlık çubuğu, bağlantılar) -->
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Hover}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Tehlikeli işlem (sil, temizle) -->
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{StaticResource Error}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Error}" />
            <Setter Property="Foreground" Value="{StaticResource Error}" />
        </Style>
        <Style Selector="Button.primary.danger">
            <Setter Property="Background" Value="{StaticResource Error}" />
            <Setter Property="BorderBrush" Value="{StaticResource Error}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary.danger /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="Button.primary.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F07A4E" />
            <Setter Property="BorderBrush" Value="#F07A4E" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Seçenek grubu (web: .segmented): çerçeveli kutu içinde çizgisiz düğmeler; seçili olan koyu zeminli,
             altında turuncu çizgi. Grup ItemsControl.segmented ya da Border.segmented ile çizilir. -->
        <Style Selector="ItemsControl.segmented">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.segmented">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.seg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Hover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="Button.seg.active">
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="Button.seg.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="inset 0 -2 0 0 #F2A33A" />
        </Style>
        <Style Selector="Button.seg.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="BoxShadow" Value="inset 0 -2 0 0 #F2A33A" />
        </Style>
        <!-- Tek tek seçilen düğmeler (roller, türler): kendi kenarı olan çip -->
        <Style Selector="Button.seg.loose">
            <Setter Property="Background" Value="{StaticResource ButtonBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Padding" Value="11,5" />
        </Style>
        <Style Selector="Button.seg.loose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
        </Style>
        <Style Selector="Button.seg.loose.active">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
        </Style>
        <Style Selector="Button.seg.loose.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="Button.seg.loose.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>

        <!-- Ekran görüntüleri üstüne gelince hafifçe yakınlaşır (web: .shot:hover img scale 1.04) -->
        <Style Selector="Border.zoom > Image">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover Border.zoom > Image">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>

        <!-- Kartlar: üstüne gelince kenar yumuşakça belirginleşir -->
        <Style Selector="Border.card, Border.row-card">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Ellipse.dot"><Setter Property="Fill" Value="#A1958A" /></Style>
        <Style Selector="Ellipse.dot.playing"><Setter Property="Fill" Value="#5FC46A" /></Style>

        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>

        <!-- Simgeler: 24×24 SVG yolları, çizgi olarak çizilir -->
        <Style Selector="PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Path.icon">
            <Setter Property="Stroke" Value="{StaticResource Muted}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
        </Style>

        <Style Selector="Path.icon">
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Stroke" Duration="0:0:0.12" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover Path.icon"><Setter Property="Stroke" Value="{StaticResource Text}" /></Style>
        <Style Selector="Button.close:pointerover Path.icon"><Setter Property="Stroke" Value="White" /></Style>
        <Style Selector="Button.tab.active Path.icon"><Setter Property="Stroke" Value="{StaticResource AccentHi}" /></Style>
        <Style Selector="Button.tab.glow Path.icon"><Setter Property="Stroke" Value="{StaticResource AccentHi}" /></Style>

        <!-- ── Metin kutuları ───────────────────────────────────────── -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonLine}" />
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.12" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <Style Selector="ProgressBar">
            <!-- Değer atlamaz, akar (web: .bar-fill transition width .3s) -->
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Value" Duration="0:0:0.3" Easing="CubicEaseOut" /></Transitions>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="Height" Value="4" />
        </Style>
    </Application.Styles>
</Application>
