<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             xmlns:v="using:VuluLauncher.Views"
             x:Class="VuluLauncher.Views.ContentSearchView"
             x:DataType="vm:ContentSearchViewModel">
    <!-- CurseForge / Modrinth araması: Yeni paket'te modpack, İçerik ekle'de mod, kaynak paketi ve shader -->
    <UserControl.Styles>
        <StyleInclude Source="avares://vulu Launcher/Views/CatalogStyles.axaml" />
        <Style Selector="TextBlock.fhead"><Setter Property="FontSize" Value="11.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource Dim}" /></Style>
        <Style Selector="Button.catrow">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" /><Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="Button.catrow:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource Hover}" /><Setter Property="Foreground" Value="{StaticResource Text}" /></Style>
        <Style Selector="Button.catrow.active"><Setter Property="Foreground" Value="{StaticResource AccentHi}" /></Style>
        <Style Selector="Button.catrow Border.check"><Setter Property="BorderBrush" Value="{StaticResource LineStrong}" /><Setter Property="BorderThickness" Value="1.5" /><Setter Property="Background" Value="Transparent" /></Style>
        <Style Selector="Button.catrow.active Border.check"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /><Setter Property="Background" Value="{StaticResource Accent}" /></Style>
    </UserControl.Styles>
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBox x:Name="QueryBox" Text="{Binding Query}" Watermark="{Binding SearchHint}" Height="40" VerticalContentAlignment="Center" FontSize="14" />
            <ItemsControl Grid.Column="1" Classes="segmented" ItemsSource="{Binding Types}" IsVisible="{Binding HasTypes}" Margin="10,0,0,0" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Choice">
                        <Button Classes="seg" Classes.active="{Binding IsSelected}" Content="{Binding Label}"
                                Command="{Binding $parent[UserControl].((vm:ContentSearchViewModel)DataContext).SelectTypeCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <!-- Sağda süzgeç paneli: sıralama, sürüm, yükleyici, açık kaynak ve gruplanmış kategoriler (işaretlenebilir liste) -->
        <Border DockPanel.Dock="Right" Width="250" Margin="14,0,8,8" Padding="14,12" CornerRadius="{DynamicResource OverlayCornerRadius}"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Text="Süzgeçler" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="clink" Content="{Binding ClearText}" IsVisible="{Binding CanClear}" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Center" />
                </Grid>
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
                    <TextBlock Text="Sırala" Classes="fhead" />
                    <ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Minecraft sürümü" Classes="fhead" IsVisible="{Binding FreeBrowse}" Margin="0,6,0,0" />
                    <ComboBox IsVisible="{Binding FreeBrowse}" ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" MaxDropDownHeight="360" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Yükleyici" Classes="fhead" IsVisible="{Binding ShowLoader}" Margin="0,6,0,0" />
                    <ComboBox IsVisible="{Binding ShowLoader}" ItemsSource="{Binding LoaderOptions}" SelectedItem="{Binding Loader}" HorizontalAlignment="Stretch" />
                    <CheckBox Content="Yalnızca açık kaynak" IsChecked="{Binding OpenSource}" IsVisible="{Binding !IsCurseForge}" Margin="0,6,0,0" />
                </StackPanel>
                <ScrollViewer>
                    <StackPanel Spacing="4">
                        <v:Loading Text="Kategoriler yükleniyor…" HorizontalAlignment="Left" IsVisible="{Binding FiltersLoading}" />
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryGroup">
                                    <StackPanel Margin="0,0,0,12" Spacing="1">
                                        <TextBlock Text="{Binding Title}" Classes="fhead" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Chips}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CategoryChip">
                                                    <Button Classes="catrow" Classes.active="{Binding IsSelected}"
                                                            Command="{Binding $parent[UserControl].((vm:ContentSearchViewModel)DataContext).ToggleCategoryCommand}" CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                                            <Border Classes="check" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center">
                                                                <Path Data="M5 12l4 4 10-10" Stroke="{StaticResource AccentInk}" StrokeThickness="2.6" StrokeLineCap="Round" StrokeJoin="Round"
                                                                      Width="10" Height="10" Stretch="Uniform" IsVisible="{Binding IsSelected}" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Classes="dim" FontSize="12.5" Margin="0,0,0,10" TextWrapping="Wrap" />
        <ScrollViewer>
            <StackPanel Margin="0,0,0,8" Spacing="8">
                <v:EmptyState IsVisible="{Binding SearchError, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,30,12,0" Icon="!" Title="Arama yapılamadı"
                              Text="{Binding SearchError}" ActionText="Tekrar dene" Command="{Binding RetryCommand}" />
                <ItemsControl ItemsSource="{Binding Hits}" v:Reveal.Stagger="True">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContentHit">
                            <Border Classes="ccard" Padding="12" Margin="0,0,12,12" Cursor="Hand" Tapped="OnHitTapped" ToolTip.Tip="Ayrıntılar, sürümler ve sayfa">
                                <DockPanel>
                                    <!-- Tek eylem: kur. Belirli bir sürüm ve proje sayfası kartın ayrıntılarında (karta tıkla) -->
                                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="cact" Classes.primary="{Binding IsPrimary}" Content="{Binding ButtonText}"
                                                Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" Margin="10,0,0,0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="48" Height="48" VerticalAlignment="Top" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{StaticResource Raised}" ClipToBounds="True">
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Author}" Classes="dim" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            <Border Classes="ctag" IsVisible="{Binding ManualOnly}" HorizontalAlignment="Left" Margin="0,2,0,0"><TextBlock Text="Elle indirilir" /></Border>
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Daha fazla göster" IsVisible="{Binding HasMore}" Command="{Binding MoreCommand}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Height="38" Margin="0,0,12,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
