<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             x:Class="VuluLauncher.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="Bu sayfa yeni arayüze taşınıyor." Classes="muted" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
