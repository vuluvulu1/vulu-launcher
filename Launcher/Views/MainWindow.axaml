<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VuluLauncher.ViewModels"
        xmlns:v="using:VuluLauncher.Views"
        x:Class="VuluLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="vulu Launcher"
        Icon="avares://vulu Launcher/Assets/logo.png"
        WindowDecorations="None"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">

    <!-- Arayüz 1320×820 alana göre tasarlandı; pencere boyutuna göre bütünüyle ölçeklenir (Program.WindowLayout) -->
    <LayoutTransformControl x:Name="Scaler">
        <Grid RowDefinitions="50,*">

            <!-- ── Başlık çubuğu: sürükleme buradan ───────────────────── -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="9" Margin="14,0" VerticalAlignment="Center">
                        <Image Source="avares://vulu Launcher/Assets/logo.png" Width="20" Height="20" />
                        <TextBlock Text="vulu Launcher" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Background="{StaticResource AccentSoft}" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        </Border>
                    </StackPanel>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Tabs}" IsVisible="{Binding LoggedIn}" Margin="8,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageTab">
                                <Button Classes="tab" Classes.active="{Binding IsActive}" IsVisible="{Binding IsVisible}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectTabCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="icon" Data="{Binding Icon}" />
                                        <TextBlock Text="{Binding Title}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Styles>
                            <Style Selector="Button.tab">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0,0,0,2" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Setter Property="Height" Value="50" />
                                <Setter Property="Padding" Value="13,0" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                            <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource Hover}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Style>
                            <Style Selector="Button.tab.active">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
                            </Style>
                            <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
                            </Style>
                            <Style Selector="Button.tab TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </ItemsControl.Styles>
                    </ItemsControl>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Button Classes="flat" IsVisible="{Binding LoggedIn}" Command="{Binding LogoutCommand}"
                                ToolTip.Tip="Çıkış yap" Padding="8,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" Background="{StaticResource Raised}"
                                        BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                                    <TextBlock Text="{Binding UserInitial}" FontWeight="Bold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="flat" Command="{Binding MinimizeCommand}" ToolTip.Tip="Küçült" Width="40" Height="34">
                            <Path Classes="icon" Data="M1 6h10" Width="12" Height="12" Stretch="None" />
                        </Button>
                        <Button Classes="flat close" Command="{Binding CloseCommand}" ToolTip.Tip="Kapat" Width="40" Height="34">
                            <Path Classes="icon" Data="M1.5 1.5l9 9M10.5 1.5l-9 9" Width="12" Height="12" Stretch="None" StrokeThickness="1.4" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── İçerik: giriş ya da seçili sekme ──────────────────── -->
            <v:LoginView Grid.Row="1" DataContext="{Binding Login}" IsVisible="{Binding !$parent[Window].((vm:MainViewModel)DataContext).LoggedIn}" />
            <ContentControl Grid.Row="1" Content="{Binding SelectedTab.Page}" IsVisible="{Binding LoggedIn}" />

            <!-- ── Bildirim kartları (sağ alt) ──────────────────────── -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,18,92" Width="340" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToastItem">
                        <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                                Padding="14,10" BoxShadow="0 12 32 0 #99000000">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Body}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- ── Soru/bilgi kutusu: pencerenin üstünde, arkası karartılır ── -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="#A6000000" IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding Dialog}"
                        Background="{StaticResource Panel}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                        BoxShadow="0 18 44 0 #9E000000" x:DataType="vm:DialogViewModel">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Margin="22,18,22,0" />
                        <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" Margin="22,10,22,20" LineHeight="20" />
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Content="{Binding CancelText}" IsVisible="{Binding HasCancel}" Command="{Binding CancelCommand}" IsCancel="True" />
                                <Button Classes="primary" Classes.danger="{Binding IsDanger}" Content="{Binding OkText}" Command="{Binding OkCommand}" IsDefault="True" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </LayoutTransformControl>
</Window>
