<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VuluLauncher.ViewModels"
        xmlns:v="using:VuluLauncher.Views"
        x:Class="VuluLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="vulu Launcher"
        Icon="avares://vulu Launcher/Assets/logo.ico"
        WindowDecorations="None"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">

    <!-- Arayüz 1320×820 alana göre tasarlandı; pencere boyutuna göre bütünüyle ölçeklenir (Program.WindowLayout) -->
    <LayoutTransformControl x:Name="Scaler">
        <Grid RowDefinitions="50,*">

            <!-- ── Başlık çubuğu: sürükleme buradan ───────────────────── -->
            <!-- Meşale: Oyna'da paketin resmi başlık çubuğunun altına uzanır, çubuk üstünde saydamlaşır -->
            <Border x:Name="TitleBar" Grid.Row="0" ZIndex="3" HorizontalAlignment="Stretch" Classes.overlay="{Binding HomeOverlay}">
                <Border.Styles>
                    <Style Selector="Border#TitleBar">
                        <Setter Property="Background" Value="{StaticResource TitleBarBg}" />
                        <Setter Property="BoxShadow" Value="0 1 0 0 #12FFD8A0" />
                    </Style>
                    <Style Selector="Border#TitleBar.overlay">
                        <Setter Property="Background">
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0" Color="#C7080706" />
                                <GradientStop Offset="1" Color="#00080706" />
                            </LinearGradientBrush>
                        </Setter>
                        <Setter Property="BoxShadow" Value="none" />
                    </Style>
                    <!-- Küçük düğmeler resmin üstünde de kaybolmasın (mesale.css .tb-btn) -->
                    <Style Selector="Button.tb">
                        <Setter Property="Width" Value="38" />
                        <Setter Property="Height" Value="34" />
                    </Style>
                    <Style Selector="Button.tb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="{StaticResource SoftFillHover}" />
                    </Style>
                    <Style Selector="Button.tb Path.icon">
                        <Setter Property="Stroke" Value="{StaticResource Text}" />
                    </Style>
                    <Style Selector="Button.tb.big Path.icon">
                        <Setter Property="Width" Value="19" />
                        <Setter Property="Height" Value="19" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </Style>
                    <Style Selector="Button.tb.active Path.icon">
                        <Setter Property="Stroke" Value="{StaticResource AccentHi}" />
                    </Style>
                    <Style Selector="Button.tb.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="#B33A2B" />
                    </Style>
                    <Style Selector="Button.chip">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{StaticResource ButtonLine}" />
                        <Setter Property="Background" Value="{StaticResource Glass}" />
                    </Style>
                    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="{StaticResource Glass}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                    </Style>
                    <Style Selector="Border.tabind">
                        <Setter Property="Background" Value="{StaticResource Accent}" />
                        <Setter Property="BoxShadow" Value="0 0 15 3 #B8F2A33A" />
                    </Style>
                </Border.Styles>
                <Grid x:Name="TitleGrid" ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                    <StackPanel x:Name="TitleLogo" Orientation="Horizontal" Spacing="9" Margin="14,0" VerticalAlignment="Center">
                        <Image Source="avares://vulu Launcher/Assets/logo.png" Width="20" Height="20" />
                        <TextBlock Text="vulu Launcher" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Background="{StaticResource AccentSoft}" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        </Border>
                    </StackPanel>

                    <!-- Kütüphane: sekmeler yerine geniş arama kutusu (sekmeler soldaki rayda) -->
                    <Border x:Name="SearchPillHost" Grid.Column="1">
                    <Button x:Name="SearchPill" Classes="search-pill" IsVisible="{Binding ShowShell}" Command="{Binding OpenPaletteCommand}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0" AutomationProperties.Name="Hızlı arama">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Path Classes="icon" Data="M11 4.5a6.5 6.5 0 1 0 0 13a6.5 6.5 0 0 0 0-13zM16 16l4.5 4.5" Width="15" Height="15" />
                            <TextBlock Grid.Column="1" Text="Paket, sayfa ya da kişi ara" Classes="dim" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ctrl+K" FontFamily="{StaticResource Mono}" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    </Border>
                    <Border x:Name="TabsHost" Grid.Column="1">
                    <Panel Margin="8,0,0,0" IsVisible="{Binding ShowShell}">
                    <ItemsControl x:Name="NavTabs" ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageTab">
                                <Button Classes="tab" Classes.active="{Binding IsActive}" Classes.glow="{Binding IsGlowing}" IsVisible="{Binding InBar}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectTabCommand}"
                                        CommandParameter="{Binding}">
                                    <Panel>
                                    <Border Classes="bar" Height="2" Margin="8,0" VerticalAlignment="Top" Background="{StaticResource Accent}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                        <Border IsVisible="{Binding HasBadge}" Background="{StaticResource Accent}" MinWidth="16" Height="16" Padding="4,0"
                                                CornerRadius="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentInk}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    </Panel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Styles>
                            <Style Selector="Button.tab">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Margin" Value="0,0,2,0" />
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Setter Property="Height" Value="50" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                            <Style Selector="Button.tab:pressed">
                                <Setter Property="RenderTransform" Value="none" />
                            </Style>
                            <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Style>
                            <Style Selector="Button.tab.active">
                                <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
                                <Setter Property="Background" Value="{StaticResource TabGlow}" />
                            </Style>
                            <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
                            </Style>
                            <!-- Seçili sekmenin üstündeki parlayan çizgi -->
                            <Style Selector="Button.tab Border.bar">
                                <Setter Property="BoxShadow" Value="0 0 15 3 #B8F2A33A" />
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="Transitions">
                                    <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
                                </Setter>
                            </Style>
                            <!-- Seçili sekmenin çizgisi artık tek parça: sekmeler arasında kayar (TabIndicator) -->
                            <Style Selector="Button.tab.glow /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
                            </Style>
                            <Style Selector="Button.tab TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </ItemsControl.Styles>
                    </ItemsControl>
                    <!-- Seçili sekmenin üstündeki parlayan çizgi: sekme değişince yeni sekmeye kayarak gider -->
                    <Canvas IsHitTestVisible="False" ClipToBounds="False">
                        <Border x:Name="TabIndicator" Classes="tabind" Height="2" Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Canvas.Left" Duration="0:0:0.28" Easing="CubicEaseOut" />
                                    <DoubleTransition Property="Width" Duration="0:0:0.28" Easing="CubicEaseOut" />
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Canvas>
                    </Panel>
                    </Border>

                    <StackPanel x:Name="TitleButtons" Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Hızlı arama -->
                        <Border x:Name="SearchIconHost">
                        <Button Classes="flat tb big" IsVisible="{Binding ShowShell}" Command="{Binding OpenPaletteCommand}" AutomationProperties.Name="Hızlı arama"
                                ToolTip.Tip="Hızlı arama (Ctrl+K): paket, sayfa ya da kişi">
                            <Path Classes="icon" Data="M11 4.5a6.5 6.5 0 1 0 0 13a6.5 6.5 0 0 0 0-13zM16 16l4.5 4.5" />
                        </Button>
                        </Border>
                        <!-- Geri bildirim: herkes için Ayarlar › Hesap ve dosyalar ile Ctrl+K'de; burada yalnızca adminlere, açık bildirim varken -->
                        <Button Classes="flat tb big" IsVisible="{Binding HasFeedbackCount}" Command="{Binding OpenLauncherFeedbackCommand}"
                                ToolTip.Tip="Açık launcher geri bildirimleri" AutomationProperties.Name="Geri bildirim">
                            <Panel>
                                <Path Classes="icon" Data="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12zM9 10.5h6M9 13.5h4" />
                                <Border IsVisible="{Binding HasFeedbackCount}" Background="{StaticResource Accent}" MinWidth="15" Height="15" CornerRadius="8"
                                        Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-9,0">
                                    <TextBlock Text="{Binding FeedbackCount}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentInk}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Panel>
                        </Button>
                        <!-- Bildirim merkezi -->
                        <Button Classes="flat tb big" IsVisible="{Binding ShowShell}" ToolTip.Tip="Bildirimler" AutomationProperties.Name="Bildirimler">
                            <Panel>
                                <Path x:Name="BellIcon" Classes="icon" Data="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15zM10 20.5a2 2 0 0 0 4 0" RenderTransformOrigin="50%,15%" />
                                <Border x:Name="NotifBadge" IsVisible="{Binding Notifications.HasUnread}" Background="{StaticResource Accent}" MinWidth="15" Height="15" CornerRadius="8"
                                        Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-9,0">
                                    <TextBlock Text="{Binding Notifications.Badge}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentInk}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Panel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" Opened="OnNotificationsOpened" Closed="OnNotificationsClosed">
                                    <Border Width="360" MaxHeight="480" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                                            DataContext="{Binding Notifications}" x:DataType="vm:NotificationsViewModel">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,10">
                                                <TextBlock Text="Bildirimler" FontWeight="Bold" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="flat" Content="Tümünü okundu say" FontSize="12" Padding="6,2" Command="{Binding MarkSeenCommand}" />
                                            </Grid>
                                            <v:EmptyState DockPanel.Dock="Top" IsVisible="{Binding IsEmpty}" Dashed="False" Margin="0,0,0,8" Icon="🔔"
                                                          Title="Bildirim yok" Text="Mesajlar, arkadaşlık istekleri, paket güncellemeleri ve oyuna giren arkadaşların burada görünür." />
                                            <ScrollViewer>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NotifItem">
                                                            <Button Classes="flat notif" Classes.new="{Binding IsNew}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                    Padding="12,8" Command="{Binding OpenCommand}">
                                                                <Grid ColumnDefinitions="Auto,*">
                                                                    <Border Width="34" Height="34" CornerRadius="17" ClipToBounds="True" Background="{StaticResource Raised}" Margin="0,0,10,0" VerticalAlignment="Top">
                                                                        <Grid>
                                                                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" MaxWidth="250" />
                                                                            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" IsVisible="{Binding IsNew}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Body}" IsVisible="{Binding HasBody}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" MaxLines="2" />
                                                                        <TextBlock Text="{Binding When}" Classes="dim" FontSize="11.5" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                    <ItemsControl.Styles>
                                                        <Style Selector="Button.notif.new"><Setter Property="Background" Value="{StaticResource AccentSoft}" /></Style>
                                                    </ItemsControl.Styles>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- Kütüphane: radyo burada (öbür temalarda Oyna'daki oyun çubuğunda) -->
                        <Border x:Name="RadioHost">
                        <Button Classes="flat tb big" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowShell}" ToolTip.Tip="Radyo" AutomationProperties.Name="Radyo"
                                DataContext="{Binding Radio}" x:DataType="vm:RadioViewModel">
                            <Panel>
                                <Path Classes="icon" Data="M4 10h16v10H4zM8 6l8-3M8 15h.01M14 13h4M14 16h4" IsVisible="{Binding !Playing}" />
                                <v:EqBars IsVisible="{Binding Playing}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="8" Width="340">
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                            <Button Classes="primary" Width="32" Height="32" Padding="0" CornerRadius="16" HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center" Command="{Binding ToggleCommand}" ToolTip.Tip="Radyoyu çal / durdur">
                                                <Panel>
                                                    <Path Data="M7 4l13 8-13 8z" Fill="{StaticResource AccentInk}" Width="11" Height="11" Stretch="Uniform" IsVisible="{Binding !Playing}" Margin="2,0,0,0" />
                                                    <Path Data="M6 4h4v16H6zM14 4h4v16h-4z" Fill="{StaticResource AccentInk}" Width="10" Height="11" Stretch="Uniform" IsVisible="{Binding Playing}" />
                                                </Panel>
                                            </Button>
                                            <Button Grid.Column="1" Classes="flat" Width="32" Height="32" Padding="0" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Sesi kapat / aç">
                                                <Panel>
                                                    <Path Classes="icon" Data="M4 9h4l5-4v14l-5-4H4zM16 9a4 4 0 0 1 0 6" IsVisible="{Binding !Muted}" Width="14" Height="14" />
                                                    <Path Classes="icon" Data="M4 9h4l5-4v14l-5-4H4zM16 9l5 6M21 9l-5 6" IsVisible="{Binding Muted}" Width="14" Height="14" />
                                                </Panel>
                                            </Button>
                                            <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center" ToolTip.Tip="Ses düzeyi" />
                                        </Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Classes="dim" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <v:RadioPanel />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        </Border>
                        <!-- Ayarlar (Kütüphane'de rayın en altında) -->
                        <Border x:Name="SettingsIconHost">
                        <Button Classes="flat tb big" Classes.active="{Binding SettingsTab.IsActive}" IsVisible="{Binding ShowShell}" Command="{Binding SelectTabCommand}"
                                CommandParameter="{Binding SettingsTab}" ToolTip.Tip="Ayarlar" AutomationProperties.Name="Ayarlar">
                            <Path Classes="icon" Data="{Binding SettingsTab.Icon}" />
                        </Button>
                        </Border>
                        <Border x:Name="ProfileHost">
                        <Button Classes="flat chip" IsVisible="{Binding ShowShell}" Command="{Binding OpenMyProfileCommand}"
                                ToolTip.Tip="Profilim" Padding="8,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" Background="{StaticResource Raised}"
                                        BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="{Binding UserInitial}" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding MyAvatar}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        </Border>
                        <Button Classes="flat tb" Command="{Binding MinimizeCommand}" ToolTip.Tip="Küçült" AutomationProperties.Name="Küçült">
                            <Path Classes="icon" Data="M1 6h10" Width="12" Height="12" Stretch="None" />
                        </Button>
                        <Button Classes="flat tb close" Command="{Binding CloseCommand}" ToolTip.Tip="Kapat" AutomationProperties.Name="Kapat">
                            <Path Classes="icon" Data="M1.5 1.5l9 9M10.5 1.5l-9 9" Width="12" Height="12" Stretch="None" StrokeThickness="1.4" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── İçerik: giriş ya da seçili sekme ──────────────────── -->
            <v:LoginView Grid.Row="1" DataContext="{Binding Login}" IsVisible="{Binding !$parent[Window].((vm:MainViewModel)DataContext).ShowShell}" />
            <!-- Sayfa değişince yeni sayfa yumuşakça belirir (web: .view animation view-in .18s) -->
            <!-- Sayfa değişince yeni sayfa hafifçe aşağıdan yükselerek belirir (web: .page-enter .18s); MainWindow.axaml.cs -->
            <!-- Oyna dışındaki sayfaların zemini: seçili paketin dünyası, bulanık ve karartılmış (mesale.css #view-main::before) -->
            <!-- Ufkun öbür ucu teması: Oyna dışındaki sayfaların (ve girişin) arkasında hareketli synthwave sahnesi -->
            <v:SynthwaveBackdrop Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding ShowSynthwave}" />
            <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding ShowBackdrop}" IsHitTestVisible="False" ClipToBounds="True">
                <!-- Önceden bulanıklaştırılmış küçük kopya (canlı BlurEffect her yeniden çizimde baştan hesaplanıyordu) -->
                <Image Source="{Binding Home.BackgroundBlurred}" Stretch="UniformToFill" Margin="-40" RenderOptions.BitmapInterpolationMode="MediumQuality" />
                <Border Background="#D9080706" />
            </Panel>
            <!-- Sayfalar bir kez kurulup saklanır; sekme değişince yalnızca görünürlük değişir (Views/PageHost.cs) -->
            <v:PageHost x:Name="PageHost" Grid.Row="0" Grid.RowSpan="2" Classes.home="{Binding IsHomePage}"
                        Page="{Binding SelectedTab.Page}" IsVisible="{Binding ShowShell}">
                <v:PageHost.Styles>
                    <Style Selector="v|PageHost#PageHost"><Setter Property="Margin" Value="0,50,0,0" /></Style>
                    <Style Selector="v|PageHost#PageHost.home"><Setter Property="Margin" Value="0" /></Style>
                    <!-- Kütüphane: sayfalar simge rayının sağında, ince üst çubuğun altında (Oyna dahil) -->
                    <Style Selector="Window.kutuphane v|PageHost#PageHost, Window.kutuphane v|PageHost#PageHost.home"><Setter Property="Margin" Value="56,50,0,0" /></Style>
                </v:PageHost.Styles>
            </v:PageHost>
            <!-- ── Kütüphane teması: solda ince simge rayı (yalnızca sekmeler; Ayarlar en altta). Ad üstüne gelince görünür ── -->
            <Border x:Name="Rail" Grid.Row="0" Grid.RowSpan="2" ZIndex="4" Width="56" HorizontalAlignment="Left"
                    Background="{StaticResource RailBg}" BorderBrush="{StaticResource RailLine}" BorderThickness="0,0,1,0">
                <Panel IsVisible="{Binding ShowShell}">
                    <!-- Seçili sekmenin yuvarlak zemini ve soldaki amber çizgi: sekme değişince yeni sekmeye kayar (PlaceRailMark) -->
                    <Canvas x:Name="RailCanvas" IsHitTestVisible="False">
                        <Panel x:Name="RailMark" Width="56" Height="42" Opacity="0">
                            <Panel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Canvas.Top" Duration="0:0:0.3" Easing="CubicEaseOut" />
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                </Transitions>
                            </Panel.Transitions>
                            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentTint}" HorizontalAlignment="Center" />
                            <Border Width="3" Height="20" CornerRadius="0,2,2,0" Background="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Panel>
                    </Canvas>
                    <DockPanel Margin="0,62,0,12">
                        <Button DockPanel.Dock="Bottom" Classes="rail-tab" Classes.active="{Binding SettingsTab.IsActive}" Classes.glow="{Binding SettingsTab.IsGlowing}"
                                Command="{Binding SelectTabCommand}" CommandParameter="{Binding SettingsTab}" ToolTip.Tip="Ayarlar" ToolTip.Placement="Right"
                                AutomationProperties.Name="Ayarlar">
                            <Path Classes="tab-icon" Data="{Binding SettingsTab.Icon}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" />
                        </Button>
                        <ItemsControl x:Name="RailTabs" ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PageTab">
                                    <Button Classes="rail-tab" Classes.active="{Binding IsActive}" Classes.glow="{Binding IsGlowing}" IsVisible="{Binding InBar}"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectTabCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Title}" ToolTip.Placement="Right" AutomationProperties.Name="{Binding Title}">
                                        <Panel>
                                            <Path Classes="tab-icon" Data="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border IsVisible="{Binding HasBadge}" Background="{StaticResource Accent}" MinWidth="15" Height="15" CornerRadius="8" Padding="3,0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0">
                                                <TextBlock Text="{Binding Badge}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Panel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Panel>
            </Border>

            <!-- ── Açılış perdesi: giriş ve ana ekran arkasında hazırlanır ── -->
            <!-- Başlık çubuğu (ZIndex 3) dahil her şeyin üstünde -->
            <!-- Tema geçişi (Ayarlar › Tema): ekranı kısa bir ışık tüneliyle örter, ortada tema değişir -->
            <v:ThemeTransition x:Name="Transition" Grid.Row="0" Grid.RowSpan="2" ZIndex="19" />
            <v:SplashView Grid.Row="0" Grid.RowSpan="2" ZIndex="20" DataContext="{Binding Splash}" IsVisible="{Binding IsVisible}" />

            <!-- ── Bildirim kartları (sağ alt) ──────────────────────── -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,18,92" Width="340">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToastItem"><v:ToastCard /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── İndirme paneli (sağ üst): dosyalar, hız, kalan süre ── -->
            <!-- İndirme paneli belirirken hafifçe yükselir (web: dl-in .18s) -->
            <Panel.Styles>
                <Style Selector="Border#DownloadsPanel[IsVisible=True]">
                    <Style.Animations>
                        <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Backward">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="6" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Panel.Styles>
            <Border x:Name="DownloadsPanel" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0" Width="370"
                    IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Downloads.Visible}" DataContext="{Binding Downloads}" x:DataType="vm:DownloadsViewModel"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="14,12"
                    BoxShadow="0 12 32 0 #99000000">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Width="22" Height="22" VerticalAlignment="Top" Margin="0,2,10,0">
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding Running}" Width="22" Height="3" MinWidth="0" VerticalAlignment="Center" />
                            <TextBlock Text="✓" IsVisible="{Binding Done}" Foreground="{StaticResource Ok}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="!" IsVisible="{Binding FailedState}" Foreground="{StaticResource Error}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                        </Panel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                            <TextBlock Text="{Binding Phase}" Classes="dim" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                            <Button Classes="flat" Content="{Binding PauseText}" IsVisible="{Binding CanPause}" FontSize="11.5" Padding="6,2" Command="{Binding PauseCommand}" />
                            <Button Classes="flat" Content="İptal" IsVisible="{Binding Running}" FontSize="11.5" Padding="6,2" Command="{Binding CancelCommand}" />
                            <Button Classes="flat" Content="⌄" Padding="6,0" Command="{Binding ToggleCommand}" ToolTip.Tip="Ayrıntılar" />
                            <Button Classes="flat" Content="×" IsVisible="{Binding !Running}" Padding="6,0" Command="{Binding CloseCommand}" ToolTip.Tip="Kapat" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <ProgressBar Value="{Binding Percent}" Maximum="100" IsIndeterminate="{Binding Indeterminate}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding PercentText}" Classes="dim" FontSize="12" Margin="10,0,0,0" MinWidth="34" TextAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding Stats}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <ScrollViewer IsVisible="{Binding Expanded}" MaxHeight="220">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Hata" IsVisible="{Binding HasFailed}" Foreground="{StaticResource Error}" FontSize="11.5" FontWeight="Bold" />
                            <ItemsControl ItemsSource="{Binding Failed}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DownloadRow">
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" FontSize="11.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ActiveTitle}" IsVisible="{Binding HasActive}" Classes="dim" FontSize="11.5" FontWeight="Bold" />
                            <ItemsControl ItemsSource="{Binding Active}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DownloadRow">
                                        <StackPanel Margin="0,0,0,4" Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Size}" Classes="dim" FontSize="11.5" Margin="8,0,0,0" />
                                            </Grid>
                                            <ProgressBar Value="{Binding Percent}" Maximum="100" IsVisible="{Binding HasPercent}" Height="2" MinHeight="2" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Tamamlanan" IsVisible="{Binding HasRecent}" Classes="dim" FontSize="11.5" FontWeight="Bold" />
                            <ItemsControl ItemsSource="{Binding Recent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DownloadRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,3">
                                            <TextBlock Text="✓" Foreground="{StaticResource Ok}" FontSize="11.5" Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="dim" FontSize="11.5" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Empty}" IsVisible="{Binding Empty, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="dim" FontSize="12" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <!-- ── Kutular: pencerenin üstünde, arkası karartılır; üst üste açılabilir ── -->
            <ItemsControl Grid.Row="0" Grid.RowSpan="2" ItemsSource="{Binding Modals}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModalViewModel">
                        <Border Classes="backdrop" Classes.closing="{Binding Closing}" Background="#A6000000">
                            <!-- Açılış: karartma solarak gelir, kutu hafifçe büyüyüp yükselerek belirir.
                                 Kapanış: ikisi birlikte 0,15 sn'de söner, kutu biraz küçülür (MainViewModel.ShowAsync) -->
                            <Border.Styles>
                                <Style Selector="Border.backdrop">
                                    <Style.Animations>
                                        <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Backward">
                                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                                <Style Selector="Border.backdrop > Border.modal-box">
                                    <Style.Animations>
                                        <Animation Duration="0:0:0.26" Easing="0.16,1,0.3,1" FillMode="Backward">
                                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="0.96" /><Setter Property="ScaleTransform.ScaleY" Value="0.96" /><Setter Property="TranslateTransform.Y" Value="10" /></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                                <Style Selector="Border.backdrop.closing">
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Style.Animations>
                                        <Animation Duration="0:0:0.15" Easing="CubicEaseIn" FillMode="Forward">
                                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                                <Style Selector="Border.backdrop.closing > Border.modal-box">
                                    <Style.Animations>
                                        <Animation Duration="0:0:0.15" Easing="CubicEaseIn" FillMode="Forward">
                                            <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="0.97" /><Setter Property="ScaleTransform.ScaleY" Value="0.97" /></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>
                            <Border Classes="modal-box" Width="{Binding Width}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="720"
                                    Background="{StaticResource Panel}" BorderThickness="1">
                                <v:ModalHost />
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </LayoutTransformControl>
</Window>
