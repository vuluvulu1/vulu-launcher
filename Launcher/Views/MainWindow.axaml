<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VuluLauncher.ViewModels"
        xmlns:v="using:VuluLauncher.Views"
        x:Class="VuluLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="vulu Launcher"
        Icon="avares://vulu Launcher/Assets/logo.png"
        WindowDecorations="None"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">

    <!-- Arayüz 1320×820 alana göre tasarlandı; pencere boyutuna göre bütünüyle ölçeklenir (Program.WindowLayout) -->
    <LayoutTransformControl x:Name="Scaler">
        <Grid RowDefinitions="50,*">

            <!-- ── Başlık çubuğu: sürükleme buradan ───────────────────── -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="9" Margin="14,0" VerticalAlignment="Center">
                        <Image Source="avares://vulu Launcher/Assets/logo.png" Width="20" Height="20" />
                        <TextBlock Text="vulu Launcher" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Background="{StaticResource AccentSoft}" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        </Border>
                    </StackPanel>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Tabs}" IsVisible="{Binding LoggedIn}" Margin="8,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageTab">
                                <Button Classes="tab" Classes.active="{Binding IsActive}" Classes.glow="{Binding IsGlowing}" IsVisible="{Binding IsVisible}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectTabCommand}"
                                        CommandParameter="{Binding}">
                                    <Panel>
                                    <Border Classes="bar" Height="2" Margin="8,0" VerticalAlignment="Top" Background="{StaticResource Accent}"
                                            BoxShadow="0 0 15 3 #B8F2A33A" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                        <Border IsVisible="{Binding HasBadge}" Background="{StaticResource Accent}" MinWidth="16" Height="16" Padding="4,0"
                                                CornerRadius="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentInk}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    </Panel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Styles>
                            <Style Selector="Button.tab">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Margin" Value="0,0,2,0" />
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Setter Property="Height" Value="50" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                            <Style Selector="Button.tab:pressed">
                                <Setter Property="RenderTransform" Value="none" />
                            </Style>
                            <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Style>
                            <Style Selector="Button.tab.active">
                                <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
                                <Setter Property="Background">
                                    <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%" RadiusX="62%" RadiusY="90%">
                                        <GradientStop Offset="0" Color="#33F2A33A" />
                                        <GradientStop Offset="1" Color="#00F2A33A" />
                                    </RadialGradientBrush>
                                </Setter>
                            </Style>
                            <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
                            </Style>
                            <!-- Seçili sekmenin üstündeki parlayan çizgi -->
                            <Style Selector="Button.tab Border.bar">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="Transitions">
                                    <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
                                </Setter>
                            </Style>
                            <Style Selector="Button.tab.active Border.bar"><Setter Property="Opacity" Value="1" /></Style>
                            <Style Selector="Button.tab.glow /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
                            </Style>
                            <Style Selector="Button.tab TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </ItemsControl.Styles>
                    </ItemsControl>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <!-- Hızlı arama -->
                        <Button Classes="flat" IsVisible="{Binding LoggedIn}" Width="40" Height="34" Command="{Binding OpenPaletteCommand}" AutomationProperties.Name="Hızlı arama"
                                ToolTip.Tip="Hızlı arama (Ctrl+K): paket, sayfa ya da kişi">
                            <Path Classes="icon" Data="M11 4.5a6.5 6.5 0 1 0 0 13a6.5 6.5 0 0 0 0-13zM16 16l4.5 4.5" />
                        </Button>
                        <!-- Geri bildirim: hata bildir ya da öneri yaz -->
                        <Button Classes="flat" IsVisible="{Binding LoggedIn}" Width="40" Height="34" Command="{Binding OpenLauncherFeedbackCommand}"
                                ToolTip.Tip="Geri bildirim: hata bildir ya da öneri yaz" AutomationProperties.Name="Geri bildirim">
                            <Panel>
                                <Path Classes="icon" Data="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12zM9 10.5h6M9 13.5h4" />
                                <Border IsVisible="{Binding HasFeedbackCount}" Background="{StaticResource Accent}" MinWidth="15" Height="15" CornerRadius="8"
                                        Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-9,0">
                                    <TextBlock Text="{Binding FeedbackCount}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentInk}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Panel>
                        </Button>
                        <!-- Bildirim merkezi -->
                        <Button Classes="flat" IsVisible="{Binding LoggedIn}" Width="40" Height="34" ToolTip.Tip="Bildirimler" AutomationProperties.Name="Bildirimler">
                            <Panel>
                                <Path Classes="icon" Data="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15zM10 20.5a2 2 0 0 0 4 0" />
                                <Border IsVisible="{Binding Notifications.HasUnread}" Background="{StaticResource Accent}" MinWidth="15" Height="15" CornerRadius="8"
                                        Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-9,0">
                                    <TextBlock Text="{Binding Notifications.Badge}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentInk}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Panel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" Opened="OnNotificationsOpened" Closed="OnNotificationsClosed">
                                    <Border Width="360" MaxHeight="480" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                                            DataContext="{Binding Notifications}" x:DataType="vm:NotificationsViewModel">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,10">
                                                <TextBlock Text="Bildirimler" FontWeight="Bold" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="flat" Content="Tümünü okundu say" FontSize="12" Padding="6,2" Command="{Binding MarkSeenCommand}" />
                                            </Grid>
                                            <StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsEmpty}" Margin="16,10,16,20" Spacing="4">
                                                <TextBlock Text="Bildirim yok" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="Mesajlar, arkadaşlık istekleri, paket güncellemeleri ve oyuna giren arkadaşların burada görünür."
                                                           Classes="dim" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" />
                                            </StackPanel>
                                            <ScrollViewer>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NotifItem">
                                                            <Button Classes="flat notif" Classes.new="{Binding IsNew}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                    Padding="12,8" Command="{Binding OpenCommand}">
                                                                <Grid ColumnDefinitions="Auto,*">
                                                                    <Border Width="34" Height="34" CornerRadius="17" ClipToBounds="True" Background="{StaticResource Raised}" Margin="0,0,10,0" VerticalAlignment="Top">
                                                                        <Grid>
                                                                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Body}" IsVisible="{Binding HasBody}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" MaxLines="2" />
                                                                        <TextBlock Text="{Binding When}" Classes="dim" FontSize="11.5" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                    <ItemsControl.Styles>
                                                        <Style Selector="Button.notif.new"><Setter Property="Background" Value="{StaticResource AccentSoft}" /></Style>
                                                    </ItemsControl.Styles>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="flat" IsVisible="{Binding LoggedIn}" Command="{Binding OpenMyProfileCommand}"
                                ToolTip.Tip="Profilim" Padding="8,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" Background="{StaticResource Raised}"
                                        BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="{Binding UserInitial}" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding MyAvatar}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="flat" Command="{Binding MinimizeCommand}" ToolTip.Tip="Küçült" Width="40" Height="34">
                            <Path Classes="icon" Data="M1 6h10" Width="12" Height="12" Stretch="None" />
                        </Button>
                        <Button Classes="flat close" Command="{Binding CloseCommand}" ToolTip.Tip="Kapat" Width="40" Height="34">
                            <Path Classes="icon" Data="M1.5 1.5l9 9M10.5 1.5l-9 9" Width="12" Height="12" Stretch="None" StrokeThickness="1.4" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── İçerik: giriş ya da seçili sekme ──────────────────── -->
            <v:LoginView Grid.Row="1" DataContext="{Binding Login}" IsVisible="{Binding !$parent[Window].((vm:MainViewModel)DataContext).LoggedIn}" />
            <!-- Sayfa değişince yeni sayfa yumuşakça belirir (web: .view animation view-in .18s) -->
            <ContentControl Grid.Row="1" Classes="pages" Content="{Binding SelectedTab.Page}" IsVisible="{Binding LoggedIn}">
                <ContentControl.Styles>
                    <Style Selector="ContentControl.pages /template/ ContentPresenter#PART_ContentPresenter > :is(Control)">
                        <Style.Animations>
                            <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Backward">
                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </ContentControl.Styles>
            </ContentControl>
            <!-- ── Açılış perdesi: giriş ve ana ekran arkasında hazırlanır ── -->
            <v:SplashView Grid.Row="1" DataContext="{Binding Splash}" IsVisible="{Binding IsVisible}" />

            <!-- ── Bildirim kartları (sağ alt) ──────────────────────── -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,18,92" Width="340">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToastItem">
                        <Button Classes="flat toast" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}">
                            <!-- Sağdan kayarak gelir (web: toast-in .34s) -->
                            <Button.Styles>
                                <Style Selector="Button.toast">
                                    <Style.Animations>
                                        <Animation Duration="0:0:0.34" Easing="0.16,1,0.3,1" FillMode="Backward">
                                            <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="380" /></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Button.Styles>
                            <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                                    Padding="12,10" BoxShadow="0 12 32 0 #99000000">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="36" Height="36" CornerRadius="18" ClipToBounds="True" Margin="0,0,10,0" VerticalAlignment="Top"
                                            IsVisible="{Binding Avatar, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Body}" IsVisible="{Binding HasBody}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" MaxLines="3" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── İndirme paneli (sağ üst): dosyalar, hız, kalan süre ── -->
            <!-- İndirme paneli belirirken hafifçe yükselir (web: dl-in .18s) -->
            <Panel.Styles>
                <Style Selector="Border#DownloadsPanel[IsVisible=True]">
                    <Style.Animations>
                        <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Backward">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="6" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Panel.Styles>
            <Border x:Name="DownloadsPanel" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0" Width="370"
                    IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Downloads.Visible}" DataContext="{Binding Downloads}" x:DataType="vm:DownloadsViewModel"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="14,12"
                    BoxShadow="0 12 32 0 #99000000">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Width="22" Height="22" VerticalAlignment="Top" Margin="0,2,10,0">
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding Running}" Width="22" Height="3" MinWidth="0" VerticalAlignment="Center" />
                            <TextBlock Text="✓" IsVisible="{Binding Done}" Foreground="{StaticResource Ok}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="!" IsVisible="{Binding FailedState}" Foreground="{StaticResource Error}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                        </Panel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                            <TextBlock Text="{Binding Phase}" Classes="dim" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                            <Button Classes="flat" Content="{Binding PauseText}" IsVisible="{Binding CanPause}" FontSize="11.5" Padding="6,2" Command="{Binding PauseCommand}" />
                            <Button Classes="flat" Content="İptal" IsVisible="{Binding Running}" FontSize="11.5" Padding="6,2" Command="{Binding CancelCommand}" />
                            <Button Classes="flat" Content="⌄" Padding="6,0" Command="{Binding ToggleCommand}" ToolTip.Tip="Ayrıntılar" />
                            <Button Classes="flat" Content="×" IsVisible="{Binding !Running}" Padding="6,0" Command="{Binding CloseCommand}" ToolTip.Tip="Kapat" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <ProgressBar Value="{Binding Percent}" Maximum="100" IsIndeterminate="{Binding Indeterminate}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding PercentText}" Classes="dim" FontSize="12" Margin="10,0,0,0" MinWidth="34" TextAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding Stats}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <ScrollViewer IsVisible="{Binding Expanded}" MaxHeight="220">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Hata" IsVisible="{Binding HasFailed}" Foreground="{StaticResource Error}" FontSize="11.5" FontWeight="Bold" />
                            <ItemsControl ItemsSource="{Binding Failed}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DownloadRow">
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" FontSize="11.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ActiveTitle}" IsVisible="{Binding HasActive}" Classes="dim" FontSize="11.5" FontWeight="Bold" />
                            <ItemsControl ItemsSource="{Binding Active}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DownloadRow">
                                        <StackPanel Margin="0,0,0,4" Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Size}" Classes="dim" FontSize="11.5" Margin="8,0,0,0" />
                                            </Grid>
                                            <ProgressBar Value="{Binding Percent}" Maximum="100" IsVisible="{Binding HasPercent}" Height="2" MinHeight="2" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Tamamlanan" IsVisible="{Binding HasRecent}" Classes="dim" FontSize="11.5" FontWeight="Bold" />
                            <ItemsControl ItemsSource="{Binding Recent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DownloadRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,3">
                                            <TextBlock Text="✓" Foreground="{StaticResource Ok}" FontSize="11.5" Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="dim" FontSize="11.5" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Empty}" IsVisible="{Binding Empty, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="dim" FontSize="12" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <!-- ── Kutular: pencerenin üstünde, arkası karartılır; üst üste açılabilir ── -->
            <ItemsControl Grid.Row="0" Grid.RowSpan="2" ItemsSource="{Binding Modals}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModalViewModel">
                        <Border Classes="backdrop" Background="#A6000000">
                            <!-- Kutu açılırken karartma ve kutu yumuşakça belirir (web: view-in .12s) -->
                            <Border.Styles>
                                <Style Selector="Border.backdrop">
                                    <Style.Animations>
                                        <Animation Duration="0:0:0.12" Easing="CubicEaseOut" FillMode="Backward">
                                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>
                            <Border Width="{Binding Width}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="720"
                                    Background="{StaticResource Panel}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                                    BoxShadow="0 18 44 0 #9E000000">
                                <v:ModalHost />
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </LayoutTransformControl>
</Window>
