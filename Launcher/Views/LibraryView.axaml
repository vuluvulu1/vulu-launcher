<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             xmlns:v="using:VuluLauncher.Views"
             xmlns:native="using:VuluLauncher.Native"
             x:Class="VuluLauncher.Views.LibraryView"
             x:DataType="vm:HomeViewModel">
    <!--
        Kütüphane temasının Oyna sayfası: üstte başlık ve süzgeçler, solda paketler kapak kapak bir ızgarada, sağda seçili
        paketin çekmecesi (resim, bilgiler, sunucu, dünyalar/görüntüler/içerik/konsol, bellek, sürüm, OYNA). Aynı Oyna modeli
        (HomeViewModel); yalnızca görünüş başka. Süzgeç ve arama bu görünümde (LibraryView.axaml.cs).
    -->
    <UserControl.Resources>
        <x:Double x:Key="PosterW">180</x:Double>
        <x:Double x:Key="PosterH">230</x:Double>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.ramwarn"><Setter Property="Foreground" Value="{StaticResource Warn}" /></Style>
        <!-- Instance sayfası: dünya satırı, içerik satırı, ayar satırı -->
        <Style Selector="Button.prow">
            <Setter Property="Background" Value="{StaticResource Panel}" /><Setter Property="BorderBrush" Value="{StaticResource CardLine}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="10" /><Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.prow /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="CornerRadius" Value="12" /></Style>
        <Style Selector="Button.prow:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{StaticResource CardLineHover}" /><Setter Property="Background" Value="{StaticResource Panel}" /></Style>
        <Style Selector="Border.crow">
            <Setter Property="Background" Value="{StaticResource Panel}" /><Setter Property="BorderBrush" Value="{StaticResource CardLine}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="10,8" /><Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.crow.off"><Setter Property="Opacity" Value="0.55" /></Style>
        <Style Selector="Border.srow">
            <Setter Property="Background" Value="{StaticResource Panel}" /><Setter Property="BorderBrush" Value="{StaticResource CardLine}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="18,14" />
        </Style>
        <Style Selector="Border.srow.danger"><Setter Property="BorderBrush" Value="#4DE8693A" /></Style>
        <Style Selector="Border.srow Button.dbtn"><Setter Property="Height" Value="34" /></Style>
        <Style Selector="Button.pplay">
            <Setter Property="Width" Value="46" /><Setter Property="Height" Value="46" /><Setter Property="CornerRadius" Value="23" /><Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource Accent}" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Bottom" /><Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" /><Setter Property="RenderTransform" Value="translateY(6px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pplay /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="CornerRadius" Value="23" /><Setter Property="BoxShadow" Value="0 6 16 0 #80000000" /></Style>
        <Style Selector="Button.pplay:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource AccentHi}" /></Style>
        <Style Selector="ListBox.posters ListBoxItem:pointerover Button.pplay">
            <Setter Property="Opacity" Value="1" /><Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Image.poster">
            <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.25" /></Transitions></Setter>
        </Style>
        <Style Selector="Border.newpack">
            <Setter Property="Transitions"><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.15" /><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions></Setter>
        </Style>
        <Style Selector="ListBox.posters ListBoxItem:pointerover Border.newpack">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Background" Value="{StaticResource Panel}" />
        </Style>
        <Style Selector="ListBox.posters">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.posters ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,18,18" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.posters ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.posters ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.posters ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.posters ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.posters Border.art">
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.posters ListBoxItem:pointerover Border.art">
            <Setter Property="RenderTransform" Value="translateY(-5px) scale(1.015)" />
            <Setter Property="BoxShadow" Value="0 14 28 -6 #A6000000" />
        </Style>
        <Style Selector="ListBox.posters ListBoxItem:selected Border.art">
            <Setter Property="BoxShadow" Value="0 0 0 2 #0B0A09, 0 0 0 4 #F2A33A" />
        </Style>
        <Style Selector="ListBox.posters ListBoxItem:selected TextBlock.pname">
            <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
        </Style>

        <Style Selector="Button.chip-filter">
            <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /><BrushTransition Property="BorderBrush" Duration="0:0:0.15" /></Transitions></Setter>
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chip-filter /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="Button.chip-filter.on">
            <Setter Property="Background" Value="{StaticResource Text}" />
            <Setter Property="Foreground" Value="{StaticResource Bg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.chip-filter.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource Bg}" />
        </Style>

        <Style Selector="Border.stat2">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,7" />
        </Style>
        <Style Selector="Button.dtab.big"><Setter Property="FontSize" Value="14.5" /><Setter Property="Padding" Value="2,8" /><Setter Property="Margin" Value="0,0,20,0" /></Style>
        <Style Selector="Button.dtab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.dtab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="Button.dtab.active">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.dtab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="Button.dbtn">
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.dbtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ComboBox.dcombo">
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.bigplay">
            <Setter Property="Height" Value="54" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{StaticResource PrimaryFill}" />
            <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.bigplay /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Button.bigplay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryFillHover}" />
            <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
        </Style>
        <Style Selector="Button.bigplay.small">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="Button.bigplay.small Path"><Setter Property="Fill" Value="{StaticResource Text}" /></Style>
        <Style Selector="Ellipse.sdot"><Setter Property="Fill" Value="{StaticResource Muted}" /><Setter Property="Opacity" Value="0.5" /></Style>
        <Style Selector="Ellipse.sdot.online"><Setter Property="Fill" Value="{StaticResource Online}" /><Setter Property="Opacity" Value="1" /></Style>
        <Style Selector="Ellipse.sdot.offline"><Setter Property="Fill" Value="{StaticResource Error}" /><Setter Property="Opacity" Value="1" /></Style>
        <Style Selector="SelectableTextBlock.log">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,372" RowDefinitions="Auto,*" Margin="28,14,20,20">
        <!-- ── Başlık, süzgeçler, arama ── -->
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,16" IsVisible="{Binding !PageOpen}">
            <TextBlock Text="Kütüphane" FontSize="30" FontWeight="SemiBold" LetterSpacing="-0.6" VerticalAlignment="Center" />
            <TextBlock x:Name="CountText" Grid.Column="1" FontFamily="{StaticResource Mono}" FontSize="12" Classes="dim" VerticalAlignment="Center" Margin="12,8,18,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="18,0,0,0">
                <Button x:Name="FilterAll" Classes="chip-filter on" Content="Tümü" Click="OnFilter" Tag="all" />
                <Button x:Name="FilterMine" Classes="chip-filter" Content="Kişisel" Click="OnFilter" Tag="mine" />
                <Button x:Name="FilterVulu" Classes="chip-filter" Content="vulu paketleri" Click="OnFilter" Tag="vulu" />
                <Button x:Name="FilterUpdate" Classes="chip-filter" Content="Güncellemesi olan" Click="OnFilter" Tag="update" />
                <!-- Arama süzgeçlerin hemen yanında (sağ üstte tek başına kalmasın) -->
                <TextBox x:Name="SearchBox" Width="220" Height="34" Watermark="Paket ara (Ctrl+F)" VerticalContentAlignment="Center" CornerRadius="17" Margin="8,0,0,0" />
            </StackPanel>
            <!-- Sıralama: son oynanan, ad, oynama süresi, eklenme -->
            <ComboBox x:Name="SortBox" Grid.Column="3" Height="34" MinWidth="170" VerticalAlignment="Center" CornerRadius="17" ToolTip.Tip="Sırala">
                <ComboBoxItem Tag="recent" Content="Son oynanan" />
                <ComboBoxItem Tag="name" Content="Ada göre" />
                <ComboBoxItem Tag="playtime" Content="En çok oynanan" />
                <ComboBoxItem Tag="added" Content="Son eklenen" />
                <ComboBoxItem Tag="custom" Content="Özel (sürükle bırak)" />
            </ComboBox>
        </Grid>

        <!-- ── Kapak ızgarası ── -->
        <!-- ── Instance sayfası başlığı: geri, paketin adı ve sürümü ── -->
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" Margin="0,0,0,16" IsVisible="{Binding PageOpen}">
            <Button Classes="chip-filter" Content="‹ Kütüphane" Command="{Binding ClosePageCommand}" VerticalAlignment="Center" ToolTip.Tip="Kütüphaneye dön (Esc)" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Selected.Name}" FontSize="30" FontWeight="SemiBold" LetterSpacing="-0.6" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                <TextBlock Text="{Binding Selected.Subtitle}" FontFamily="{StaticResource Mono}" FontSize="12.5" Classes="dim" VerticalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.ColumnSpan="2" RowDefinitions="Auto,*" IsVisible="{Binding !PageOpen}">
            <!-- Duyuru -->
            <Border IsVisible="{Binding HasAnnouncement}" Classes="mcard announce" Padding="14,10" Margin="0,0,18,14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Announcement}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AnnouncementMeta}" Classes="dim" FontSize="11.5" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="flat" Content="×" FontSize="16" Padding="8,0" VerticalAlignment="Top"
                            Command="{Binding DismissAnnouncementCommand}" ToolTip.Tip="Duyuruyu kapat" />
                </Grid>
            </Border>
            <v:EmptyState x:Name="NoMatch" Grid.Row="1" IsVisible="False" Margin="0,30,18,0" VerticalAlignment="Top" Icon="🔍"
                          Title="Bu süzgeçte paket yok" Text="Başka bir süzgeç seç ya da aramayı temizle." />
            <!-- Kapak üstüne gelince kalkıp gölge salıyor: kaydırma alanı kenarlardan taşırılır, liste aynı yerde kalır (kesilmesin) -->
            <ScrollViewer x:Name="PosterScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="-14,-14,0,0">
                <StackPanel>
                <!-- İlk açılış: henüz kendi paketin yoksa yol gösteren karşılama (LibraryView.axaml.cs Rebuild gösterir) -->
                <Border x:Name="Welcome" IsVisible="False" Margin="0,0,18,20" Padding="26,22" CornerRadius="18"
                        Background="{StaticResource Panel}" BorderBrush="{StaticResource CardLine}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Kütüphanene hoş geldin" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="Ekibin hazırladığı bir vulu paketini kur, CurseForge ya da Modrinth'ten bir modpack seç ya da kendi modlarını kuracağın boş bir paket aç. Hazır Vanilla da hemen oynanabilir."
                                       Classes="muted" FontSize="13.5" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" Width="230">
                            <Button Classes="primary" Height="40" CornerRadius="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Content="vulu Packs'ten paket kur" Command="{Binding NewPackFromCommand}" CommandParameter="packs" />
                            <Button Classes="dbtn" HorizontalAlignment="Stretch" Content="Modpack ara" Command="{Binding NewPackFromCommand}" CommandParameter="curseforge" />
                            <Button Classes="dbtn" HorizontalAlignment="Stretch" Content="Boş paket oluştur" Command="{Binding NewPackFromCommand}" CommandParameter="blank" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ListBox x:Name="Posters" Classes="posters" SelectionMode="Single" v:Reveal.Stagger="True" Padding="14,14,0,0">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.DataTemplates>
                        <DataTemplate DataType="v:NewPackCard">
                            <Border Classes="newpack" VerticalAlignment="Top" Width="{DynamicResource PosterW}" Height="{DynamicResource PosterH}" CornerRadius="14" BorderBrush="{StaticResource CardLineHover}" BorderThickness="1.5" Background="Transparent">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="+" FontSize="30" FontWeight="Light" HorizontalAlignment="Center" Classes="dim" />
                                    <TextBlock Text="Yeni paket" FontSize="13.5" HorizontalAlignment="Center" Classes="dim" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <!-- Kurulmakta olan paket: kapak koyulaşmış, ortada dolan halka (telefonda uygulama inerken olduğu gibi) -->
                        <DataTemplate DataType="vm:PendingInstall">
                            <StackPanel Width="{DynamicResource PosterW}" Spacing="0" Background="Transparent" Cursor="Arrow" ToolTip.Tip="{Binding Phase}">
                                <Border Height="{DynamicResource PosterH}" CornerRadius="14" ClipToBounds="True" Background="{StaticResource Raised}">
                                    <Panel>
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        <Border Background="#99000000" />
                                        <v:InstallRing Width="58" Height="58" Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="2,10,2,0" TextTrimming="CharacterEllipsis" Opacity="0.75" />
                                <TextBlock Text="{Binding Phase}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Accent}" Margin="2,2,2,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="vm:InstanceItem">
                            <StackPanel Width="{DynamicResource PosterW}" Spacing="0" ToolTip.Tip="{Binding Tip}" Background="Transparent" ContextRequested="OnPosterContextRequested">
                                <StackPanel.ContextFlyout>
                                    <MenuFlyout x:DataType="vm:HomeViewModel">
                                        <MenuItem Header="▶ Oyna" Command="{Binding PlayCommand}" />
                                        <MenuItem Header="Klasörü aç" Command="{Binding OpenFolderCommand}" />
                                        <MenuItem Header="Dünyalar ve yedekler" Command="{Binding OpenWorldsCommand}" />
                                        <Separator />
                                        <MenuItem Header="Görünüm" IsVisible="{Binding SelectedCanEditLook}" Command="{Binding AppearanceCommand}" />
                                        <MenuItem Header="Düzenle" IsVisible="{Binding SelectedIsCustom}" Command="{Binding EditInstanceCommand}" />
                                        <MenuItem Header="Çoğalt" IsVisible="{Binding SelectedIsCustom}" Command="{Binding DuplicateCommand}" />
                                        <MenuItem Header="Masaüstüne kısayol" Command="{Binding CreateShortcutCommand}" />
                                        <Separator IsVisible="{Binding SelectedIsCustom}" />
                                        <MenuItem Header="Sil" IsVisible="{Binding SelectedIsCustom}" Foreground="{StaticResource Error}" Command="{Binding DeleteInstanceCommand}" />
                                    </MenuFlyout>
                                </StackPanel.ContextFlyout>
                                <Border Classes="art" Height="{DynamicResource PosterH}" CornerRadius="14" ClipToBounds="True" Background="{Binding Name, Converter={x:Static v:KutBrushes.CoverFor}}">
                                    <Panel>
                                        <TextBlock Text="{Binding Initial}" FontSize="44" FontWeight="Bold" Foreground="{StaticResource Dim}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Classes="poster" Source="{Binding Poster}" Opacity="{Binding Poster, Converter={x:Static v:KutBrushes.Shown}}" Stretch="UniformToFill" />
                                        <Border IsVisible="{Binding HasUpdate}" Background="#CC0B0A09" CornerRadius="6" Padding="8,3" Margin="10"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="Güncelleme" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHi}" />
                                        </Border>
                                        <!-- Üstüne gelince: doğrudan başlat (kapağın kendisi sayfayı açar) -->
                                        <Button Classes="pplay" Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).PlayItemCommand}" CommandParameter="{Binding}"
                                                ToolTip.Tip="Oyna" AutomationProperties.Name="Oyna">
                                            <Path Data="M7 4l13 8-13 8z" Fill="{StaticResource AccentInk}" Width="15" Height="15" Stretch="Uniform" Margin="3,0,0,0" />
                                        </Button>
                                    </Panel>
                                </Border>
                                <TextBlock Classes="pname" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="2,10,2,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontFamily="{StaticResource Mono}" FontSize="11.5" Classes="dim" Margin="2,2,2,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Instance sayfası (sol): sekmeler ve içerikleri ── -->
        <DockPanel Grid.Row="1" Grid.Column="0" IsVisible="{Binding PageOpen}" Margin="0,0,18,0">
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource CardLine}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="dtab big" Classes.active="{Binding IsPageContent}" Content="İçerik" IsVisible="{Binding SelectedIsCustom}" Command="{Binding SelectPageTabCommand}" CommandParameter="content" />
                        <Button Classes="dtab big" Classes.active="{Binding IsPageWorlds}" Content="Dünyalar" Command="{Binding SelectPageTabCommand}" CommandParameter="worlds" />
                        <Button Classes="dtab big" Classes.active="{Binding IsPageShots}" Content="Görüntüler" Command="{Binding SelectPageTabCommand}" CommandParameter="shots" />
                        <Button Classes="dtab big" Classes.active="{Binding IsPageLog}" Command="{Binding SelectPageTabCommand}" CommandParameter="log">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="Konsol" />
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Error}" IsVisible="{Binding LogAlert}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="dtab big" Classes.active="{Binding IsPageSettings}" Content="Ayarlar" Command="{Binding SelectPageTabCommand}" CommandParameter="settings" />
                    </StackPanel>
                    <!-- Sekmeye göre işlemler -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPageContent}">
                            <Button Classes="dbtn" Padding="12,0" Content="{Binding PageContent.CheckText}" IsEnabled="{Binding PageContent.CanCheck}" Command="{Binding PageContent.CheckUpdatesCommand}" />
                            <Button Classes="dbtn" Padding="12,0" Content="{Binding PageContent.UpdateAllText}" IsVisible="{Binding PageContent.HasStableUpdates}" Command="{Binding PageContent.UpdateAllCommand}" />
                            <Button Classes="primary" Height="36" Padding="14,0" CornerRadius="10" VerticalContentAlignment="Center" Content="+ İçerik ekle" Command="{Binding PageAddContentCommand}" />
                        </StackPanel>
                        <Button Classes="dbtn" Padding="12,0" Content="Yedekler ve geri yükleme" IsVisible="{Binding IsPageWorlds}" Command="{Binding OpenWorldsCommand}" />
                        <Button Classes="dbtn" Padding="12,0" Content="{Binding ShotsMore}" IsVisible="{Binding IsPageShots}" Command="{Binding OpenShotsCommand}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPageLog}">
                            <TextBox Width="130" Height="34" Watermark="Ara" Text="{Binding ConsoleQuery}" ToolTip.Tip="Konsolda ara" VerticalContentAlignment="Center" CornerRadius="17" />
                            <Button Classes="dbtn" Padding="12,0" Content="Paylaş" Command="{Binding ShareLogCommand}" ToolTip.Tip="Oyunun günlüğünü mclo.gs'ye yükler, bağlantıyı panoya kopyalar (yardım isterken at)" />
                            <Button Classes="dbtn" Padding="12,0" Content="Kopyala" Click="OnCopyLog" ToolTip.Tip="Konsoldaki bütün satırları panoya kopyalar (hata bildirirken yapıştırılabilir)" />
                            <Button Classes="dbtn" Padding="12,0" Content="Klasör" Command="{Binding OpenLogsCommand}" ToolTip.Tip="Oyunun günlük dosyaları (latest.log)" />
                            <Button Classes="dbtn" Padding="12,0" Content="Temizle" Command="{Binding ClearConsoleCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Panel>
                        <ItemsControl x:Name="LogList" IsVisible="{Binding IsPageLog}" ItemsSource="{Binding ConsoleView}">
                            <ItemsControl.Template>
                                <ControlTemplate>
                                    <ScrollViewer Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogLine">
                                    <SelectableTextBlock Classes="log" Classes.warn="{Binding IsWarn}" Classes.error="{Binding IsError}">
                                        <Run Text="{Binding Time}" Foreground="{StaticResource Dim}" /><Run Text="  " /><Run Text="{Binding Text}" />
                                    </SelectableTextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.Styles>
                                <Style Selector="SelectableTextBlock.warn"><Setter Property="Foreground" Value="{StaticResource Warn}" /></Style>
                                <Style Selector="SelectableTextBlock.error"><Setter Property="Foreground" Value="{StaticResource Error}" /></Style>
                            </ItemsControl.Styles>
                        </ItemsControl>

                <!-- Dünyalar ve görüntüler -->
                <ScrollViewer IsVisible="{Binding IsPageInfo}">
                    <StackPanel Spacing="8" Margin="0,0,0,8">
                        <v:EmptyState IsVisible="{Binding InfoMessage, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,30,0,0"
                                      Icon="{Binding InfoIcon}" Text="{Binding InfoMessage}" />
                        <ItemsControl IsVisible="{Binding IsPageWorlds}" ItemsSource="{Binding Worlds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorldTile">
                                    <Button Classes="prow" Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenWorldsCommand}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource Raised}" ClipToBounds="True">
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                                                <!-- Oyunu doğrudan bu dünyada açar (Minecraft 1.20+) -->
                                                <Button Classes="primary" Height="30" Padding="12,0" FontSize="12.5" FontWeight="SemiBold" VerticalContentAlignment="Center"
                                                        IsVisible="{Binding CanQuickPlay}" ToolTip.Tip="Oyunu açıp doğrudan bu dünyaya gir"
                                                        Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).PlayWorldCommand}" CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Path Data="M7 4l13 8-13 8z" Fill="{StaticResource AccentInk}" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" />
                                                        <TextBlock Text="Oyna" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl IsVisible="{Binding IsPageShots}" ItemsSource="{Binding Shots}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShotTile">
                                    <Button Classes="flat" Padding="0" Margin="0,0,10,10" Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenShotsCommand}">
                                        <Border Width="240" Height="135" CornerRadius="10" Background="{StaticResource Raised}" ClipToBounds="True">
                                            <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- İçerik: modlar, kaynak paketleri, shaderlar (aç/kapa, güncelle, kaldır) -->
                <DockPanel IsVisible="{Binding IsPageContent}">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PageContent.Summary}" Classes="dim" FontSize="12.5" Margin="2,0,0,10" />
                    <!-- Süzgeç ve arama; seçim varken toplu işlem çubuğu -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10" IsVisible="{Binding !PageContent.IsEmpty, FallbackValue=False}">
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !PageContent.HasSelection}">
                            <Button Classes="chip-filter" Classes.on="{Binding PageContent.IsFilterAll}" Content="{Binding PageContent.AllText}" Command="{Binding PageContent.SetFilterCommand}" CommandParameter="all" />
                            <Button Classes="chip-filter" Classes.on="{Binding PageContent.IsFilterOn}" Content="{Binding PageContent.OnText}" Command="{Binding PageContent.SetFilterCommand}" CommandParameter="on" />
                            <Button Classes="chip-filter" Classes.on="{Binding PageContent.IsFilterOff}" Content="{Binding PageContent.OffText}" Command="{Binding PageContent.SetFilterCommand}" CommandParameter="off" />
                            <Button Classes="chip-filter" Classes.on="{Binding PageContent.IsFilterUpdates}" Content="{Binding PageContent.UpdatesText}" IsVisible="{Binding PageContent.HasAnyUpdates}"
                                    Command="{Binding PageContent.SetFilterCommand}" CommandParameter="updates" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding PageContent.HasSelection, FallbackValue=False}">
                            <TextBlock Text="{Binding PageContent.SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,8,0" />
                            <Button Classes="dbtn" Height="32" Padding="12,0" Content="Aç" Command="{Binding PageContent.EnableSelectedCommand}" />
                            <Button Classes="dbtn" Height="32" Padding="12,0" Content="Kapat" Command="{Binding PageContent.DisableSelectedCommand}" />
                            <Button Classes="dbtn" Height="32" Padding="12,0" Content="Kaldır" Foreground="{StaticResource Error}" Command="{Binding PageContent.RemoveSelectedCommand}" />
                            <Button Classes="dbtn" Height="32" Padding="12,0" Content="Seçimi bırak" Command="{Binding PageContent.ClearSelectionCommand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Classes="dbtn" Height="32" Padding="12,0" Content="Tümünü seç" Command="{Binding PageContent.SelectAllCommand}" ToolTip.Tip="Görünenlerin hepsini seç ya da bırak" />
                            <TextBox Width="200" Height="32" Watermark="İçerikte ara" Text="{Binding PageContent.Query}" VerticalContentAlignment="Center" CornerRadius="16" />
                        </StackPanel>
                    </Grid>
                    <Panel>
                        <v:EmptyState IsVisible="{Binding PageContent.HasLoadError, FallbackValue=False}" Margin="0,30,0,0" VerticalAlignment="Top" Icon="!" Title="İçerik alınamadı"
                                      Text="{Binding PageContent.LoadError}" ActionText="Tekrar dene" Command="{Binding PageContent.RetryCommand}" />
                        <v:EmptyState IsVisible="{Binding PageContent.NoMatch, FallbackValue=False}" Margin="0,30,0,0" VerticalAlignment="Top" Icon="🔍" Title="Bu süzgeçte içerik yok" Text="Başka bir süzgeç seç ya da aramayı temizle." />
                        <v:EmptyState IsVisible="{Binding PageContent.IsEmpty}" Margin="0,30,0,0" VerticalAlignment="Top" Icon="🧩" Title="Henüz içerik yok"
                                      Text="CurseForge ya da Modrinth'ten mod, kaynak paketi ya da shader ekle." ActionText="+ İçerik ekle" Command="{Binding PageAddContentCommand}" />
                        <!-- Liste boşken kaydırma alanı gizli: yoksa boş durum kutusunun üstünü örtüp düğmeyi tıklanmaz yapıyordu -->
                        <ScrollViewer IsVisible="{Binding !PageContent.IsEmpty}">
                            <ItemsControl ItemsSource="{Binding PageContent.Rows}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ContentRow">
                                        <Border Classes="crow" Classes.off="{Binding !Enabled}">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" Padding="0" ToolTip.Tip="Toplu işlem için seç" />
                                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="9" Background="{StaticResource Raised}" ClipToBounds="True">
                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Classes="dbtn" Height="30" Padding="10,0" FontSize="12" Content="Neler değişti?" IsVisible="{Binding HasUpdate}"
                                                            Command="{Binding ChangelogCommand}" ToolTip.Tip="Güncellemenin değişiklik notları" />
                                                    <Button Classes="dbtn" Height="30" Padding="10,0" FontSize="12" Foreground="{StaticResource AccentHi}"
                                                            Content="{Binding UpdateText}" IsVisible="{Binding HasUpdate}" Command="{Binding UpdateCommand}" />
                                                    <Button Classes="dbtn" Height="30" Padding="10,0" FontSize="12" Content="Geri al" IsVisible="{Binding CanRollback}"
                                                            Command="{Binding RollbackCommand}" ToolTip.Tip="{Binding RollbackTip}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="4" IsChecked="{Binding Enabled}" OnContent="" OffContent="" VerticalAlignment="Center" ToolTip.Tip="Aç / kapat" />
                                                <Button Grid.Column="5" Classes="dbtn" Width="34" Height="30" Padding="0" Command="{Binding RemoveCommand}" VerticalAlignment="Center" ToolTip.Tip="Kaldır">
                                                    <Path Data="M5 7h14M10 7V5h4v2M7 7l1 12h8l1-12M10 11v5M14 11v5" Stroke="{StaticResource Dim}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>
                </DockPanel>

                <!-- Ayarlar: paketin kendi ayarları ve işlemleri -->
                <ScrollViewer IsVisible="{Binding IsPageSettings}">
                    <StackPanel Spacing="10" Margin="0,0,0,8">
                        <Border Classes="srow" IsVisible="{Binding SelectedIsCustom}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Ad, sürüm ve yükleyici" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Classes="dim" FontSize="12.5"><Run Text="{Binding Selected.Name}" /><Run Text=" · Minecraft " /><Run Text="{Binding Selected.McVersion}" /><Run Text=" · " /><Run Text="{Binding Selected.LoaderLabel}" /></TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="dbtn" Padding="14,0" Content="Değiştir" Command="{Binding EditInstanceCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <!-- Paketin kendi oyun ayarları (Java, JVM argümanları, pencere) -->
                        <Border Classes="srow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Oyun ayarları" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap"><Run Text="{Binding GameSettingsSummary}" /><Run Text=" · Java, JVM argümanları ve oyun penceresi" /></TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="dbtn" Padding="14,0" Content="Düzenle" Command="{Binding GameSettingsCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <!-- CurseForge/Modrinth modpack'i: sürüm değiştir -->
                        <Border Classes="srow" IsVisible="{Binding SelectedIsModpack}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Modpack sürümü" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap"><Run Text="{Binding SelectedModpackVersion}" /><Run Text=" · yeni sürüme geçebilir ya da eskisine dönebilirsin" /></TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="dbtn" Padding="14,0" Content="Sürümü değiştir" Command="{Binding SwitchModpackCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Classes="srow" IsVisible="{Binding HasPackUpdate}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Paket güncellemesi var" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentHi}" />
                                    <TextBlock Text="{Binding PackUpdateText}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" Height="36" Padding="14,0" CornerRadius="10" VerticalContentAlignment="Center" Content="Güncelle" Command="{Binding UpdatePackCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Classes="srow" IsVisible="{Binding SelectedCanEditLook}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Görünüm" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Kütüphanedeki simge, logo ve arka plan resmi." Classes="dim" FontSize="12.5" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="dbtn" Padding="14,0" Content="Düzenle" Command="{Binding AppearanceCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Classes="srow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Dosyalar" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Paketin klasörü; eksik ya da bozuk oyun dosyalarını denetle." Classes="dim" FontSize="12.5" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="dbtn" Padding="14,0" Content="Klasörü aç" Command="{Binding OpenFolderCommand}" />
                                    <Button Classes="dbtn" Padding="14,0" Content="Dosyaları doğrula" Command="{Binding VerifyCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="srow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Kısayol ve paylaşma" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Masaüstünden tek tıkla aç; paketi arkadaşlarına ya da vulu Packs'e gönder." Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="dbtn" Padding="14,0" Content="Masaüstüne kısayol" Command="{Binding CreateShortcutCommand}" />
                                    <Button Classes="dbtn" Padding="14,0" Content="Arkadaşına gönder" IsVisible="{Binding SelectedIsCustom}" Command="{Binding SendToFriendCommand}" />
                                    <Button Classes="dbtn" Padding="14,0" Content="{Binding ShareText}" IsVisible="{Binding CanShare}" Command="{Binding ShareCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="srow" IsVisible="{Binding SelectedIsCustom}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Kopya ve dışa aktarma" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Paketin bir kopyasını oluştur ya da .mrpack dosyası olarak kaydet." Classes="dim" FontSize="12.5" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="dbtn" Padding="14,0" Content="Çoğalt" Command="{Binding DuplicateCommand}" />
                                    <Button Classes="dbtn" Padding="14,0" Content=".mrpack olarak dışa aktar" Command="{Binding ExportMrpackCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="srow danger" IsVisible="{Binding SelectedIsCustom}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Paketi sil" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Modları, ayarları ve dünyalarıyla birlikte bu bilgisayardan silinir." Classes="dim" FontSize="12.5" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="dbtn" Padding="14,0" Content="Sil" Foreground="{StaticResource Error}" Command="{Binding DeleteInstanceCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </DockPanel>

        <!-- ── Çekmece: seçili paket ── -->
        <Border Grid.Row="1" Grid.Column="1" IsVisible="{Binding PageOpen}" CornerRadius="18" Background="{StaticResource Panel}" BorderBrush="{StaticResource CardLine}" BorderThickness="1" ClipToBounds="True">
            <DockPanel x:Name="DrawerBody">
                <!-- Resim -->
                <Panel DockPanel.Dock="Top" Height="150">
                    <Border Background="{StaticResource BannerFallback}" />
                    <v:CrossfadeImage Source="{Binding Background}" Stretch="UniformToFill" />
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0.45" Color="#000B0A09" />
                                <GradientStop Offset="1" Color="#CC14100C" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,16,12" VerticalAlignment="Bottom">
                        <Border Background="#BF0B0A09" CornerRadius="6" Padding="9,3">
                            <TextBlock FontSize="11.5" FontWeight="SemiBold"><Run Text="Minecraft " /><Run Text="{Binding Selected.McVersion}" /></TextBlock>
                        </Border>
                        <Border Background="#BF0B0A09" CornerRadius="6" Padding="9,3">
                            <TextBlock Text="{Binding Selected.LoaderLabel}" FontSize="11.5" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Panel>

                <!-- Alt: durum, bellek, sürüm, OYNA -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="18,10,18,18">
                    <StackPanel Spacing="5" IsVisible="{Binding ShowStatusRow}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat='{}{0:0}%'}" Classes="dim" FontSize="12" IsVisible="{Binding !Indeterminate}" />
                        </Grid>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" IsIndeterminate="{Binding Indeterminate}" />
                    </StackPanel>
                    <!-- Bellek: önerilen GB ve bilgisayardaki RAM; az ya da fazla seçilince uyarı renginde -->
                    <TextBlock Text="{Binding RamHint}" FontSize="11.5" TextWrapping="Wrap" Classes="dim" Classes.ramwarn="{Binding RamWarn}" />
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                        <!-- Sürüm seçilemeyen pakette bellek iki sütunu birden kaplar (araya dolgu düğmesi konmaz) -->
                        <ComboBox Classes="dcombo" ItemsSource="{Binding RamOptions}" SelectedItem="{Binding RamGb}" ToolTip.Tip="{Binding RamHint}"
                                  Grid.ColumnSpan="{Binding CanPickVersion, Converter={x:Static v:KutBrushes.SpanUnless}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:Int32"><TextBlock Text="{Binding StringFormat='Bellek {0} GB'}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="1" Classes="dcombo" ItemsSource="{Binding McVersions}" SelectedItem="{Binding McVersion}" IsVisible="{Binding CanPickVersion}"
                                  IsEnabled="{Binding CanPlay}" MaxDropDownHeight="360" ToolTip.Tip="Minecraft sürümü" />

                        <Button Grid.Column="2" Classes="dbtn" Width="42" Content="⋯" ToolTip.Tip="Diğer işlemler">
                            <Button.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedRight">
                                    <MenuItem Header="Paketi güncelle" IsVisible="{Binding HasPackUpdate}" Command="{Binding UpdatePackCommand}" />
                                    <MenuItem Header="Mod ekle" IsVisible="{Binding SelectedIsCustom}" Command="{Binding AddContentCommand}" />
                                    <MenuItem Header="Düzenle" IsVisible="{Binding SelectedIsCustom}" Command="{Binding EditInstanceCommand}" />
                                    <MenuItem Header="Görünüm" IsVisible="{Binding SelectedCanEditLook}" Command="{Binding AppearanceCommand}" />
                                    <MenuItem Header="İçeriği yönet" IsVisible="{Binding SelectedIsCustom}" Command="{Binding ManageContentCommand}" />
                                    <MenuItem Header="Dünyalar ve yedekler" Command="{Binding OpenWorldsCommand}" />
                                    <MenuItem Header="{Binding ManualText}" IsVisible="{Binding HasManual}" Command="{Binding OpenManualCommand}" Foreground="{StaticResource Warn}" />
                                    <MenuItem Header="Dosyaları doğrula" Command="{Binding VerifyCommand}" />
                                    <MenuItem Header="Klasörü aç" Command="{Binding OpenFolderCommand}" />
                                    <MenuItem Header="Masaüstüne kısayol" Command="{Binding CreateShortcutCommand}" />
                                    <MenuItem Header="Çoğalt" IsVisible="{Binding SelectedIsCustom}" Command="{Binding DuplicateCommand}" />
                                    <MenuItem Header=".mrpack olarak dışa aktar" IsVisible="{Binding SelectedIsCustom}" Command="{Binding ExportMrpackCommand}" />
                                    <MenuItem Header="Arkadaşına gönder" IsVisible="{Binding SelectedIsCustom}" Command="{Binding SendToFriendCommand}" />
                                    <MenuItem Header="{Binding ShareText}" IsVisible="{Binding CanShare}" Command="{Binding ShareCommand}" Foreground="{StaticResource Accent}" />
                                    <Separator IsVisible="{Binding SelectedIsCustom}" />
                                    <MenuItem Header="Sil" IsVisible="{Binding SelectedIsCustom}" Command="{Binding DeleteInstanceCommand}" Foreground="{StaticResource Error}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <!-- İlk kurulumda kapatılan "elle indir" penceresi buradan yeniden açılır -->
                    <Border IsVisible="{Binding HasManual}" Background="#2A1E10" BorderBrush="#5A3E17" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding ManualText}" FontWeight="SemiBold" FontSize="13" Foreground="#FFC873" />
                                <TextBlock Text="Bunlar olmadan oyun açılmayabilir." Classes="dim" FontSize="11.5" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="primary sm" Content="Göster" Command="{Binding OpenManualCommand}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Button Classes="bigplay primary" IsVisible="{Binding ShowBarJoin}" Content="Sunucuya bağlan" Command="{Binding JoinPackServerCommand}" />
                    <!-- Açılış ya da oyun sürerken OYNA'nın yanında Durdur -->
                    <Grid ColumnDefinitions="*,Auto">
                    <Button Classes="bigplay" Classes.small="{Binding ShowBarJoin}" Command="{Binding PlayCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M7 4l13 8-13 8z" Fill="{StaticResource AccentInk}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PlayLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="dbtn stop" IsVisible="{Binding CanStop}" Command="{Binding StopGameCommand}" Margin="8,0,0,0"
                            Height="54" Padding="16,0" ToolTip.Tip="Açılışı durdurur ya da oyunu kapatır">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource Error}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StopText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </Grid>
                </StackPanel>

                <!-- Orta: ad, açıklama, sayılar, sunucu, sekmeler -->
                <DockPanel Margin="18,14,18,0">
                    <StackPanel DockPanel.Dock="Top" Spacing="12">
                        <StackPanel Spacing="4">
                            <Image Source="{Binding Logo}" IsVisible="{Binding HasLogo}" MaxHeight="56" MaxWidth="300" HorizontalAlignment="Left" Stretch="Uniform" />
                            <TextBlock Text="{Binding Selected.Name, FallbackValue=Paket seçilmedi}" IsVisible="{Binding !HasLogo}" FontSize="26" FontWeight="SemiBold"
                                       LetterSpacing="-0.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Selected.Description}" FontSize="13.5" Classes="muted" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                            <Border Classes="stat2"><StackPanel><TextBlock Text="Mod" Classes="dim" FontSize="11.5" /><TextBlock Text="{Binding ModCount}" FontWeight="SemiBold" /></StackPanel></Border>
                            <Border Grid.Column="1" Classes="stat2"><StackPanel><TextBlock Text="Boyut" Classes="dim" FontSize="11.5" /><TextBlock Text="{Binding Size}" FontWeight="SemiBold" /></StackPanel></Border>
                            <Border Grid.Column="2" Classes="stat2"><StackPanel><TextBlock Text="Güncel" Classes="dim" FontSize="11.5" /><TextBlock Text="{Binding Updated}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                            <Border Grid.Column="3" Classes="stat2"><StackPanel><TextBlock Text="Oynama" Classes="dim" FontSize="11.5" /><TextBlock Text="{Binding PlayTime}" FontWeight="SemiBold" /></StackPanel></Border>
                        </Grid>
                        <!-- Paketin sunucusu -->
                        <Border IsVisible="{Binding HasPackServer}" Background="{StaticResource Surface}" CornerRadius="12" Padding="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" DataContext="{Binding PackServer}" x:DataType="vm:ServerCard">
                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Raised}" ClipToBounds="True" VerticalAlignment="Center">
                                    <Panel>
                                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Favicon}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="None" />
                                    </Panel>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Classes="sdot" Classes.online="{Binding IsOnline}" Classes.offline="{Binding IsOffline}" Width="8" Height="8" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Players, StringFormat='{}{0} oyuncu'}" IsVisible="{Binding IsOnline}" Classes="dim" FontSize="12" />
                                    <TextBlock Text="kapalı" IsVisible="{Binding IsOffline}" Classes="dim" FontSize="12" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="dbtn" Height="32" Padding="12,0" FontSize="12.5" FontWeight="SemiBold" Content="Sunucuya gir" VerticalAlignment="Center"
                                        Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).JoinPackServerCommand}" />
                            </Grid>
                        </Border>
                        <!-- Kısayollar: sık kullanılanlar tek tıkta -->
                        <StackPanel Spacing="6" Margin="0,4,0,0">
                            <TextBlock Text="KISAYOLLAR" Classes="dim" FontSize="11.5" FontWeight="SemiBold" LetterSpacing="0.6" />
                            <UniformGrid Columns="2">
                                <Button Classes="dbtn" Margin="0,0,6,6" HorizontalAlignment="Stretch" Content="Klasörü aç" Command="{Binding OpenFolderCommand}" />
                                <Button Classes="dbtn" Margin="0,0,0,6" HorizontalAlignment="Stretch" Content="Mod ekle" IsVisible="{Binding SelectedIsCustom}" Command="{Binding PageAddContentCommand}" />
                                <Button Classes="dbtn" Margin="0,0,6,6" HorizontalAlignment="Stretch" Content="Dünyalar ve yedekler" Command="{Binding OpenWorldsCommand}" />
                                <Button Classes="dbtn" Margin="0,0,0,6" HorizontalAlignment="Stretch" Content="Görünüm" IsVisible="{Binding SelectedCanEditLook}" Command="{Binding AppearanceCommand}" />
                                <Button Classes="dbtn" Margin="0,0,6,6" HorizontalAlignment="Stretch" Content="Masaüstüne kısayol" Command="{Binding CreateShortcutCommand}" />
                                <Button Classes="dbtn" Margin="0,0,0,6" HorizontalAlignment="Stretch" Content="Dosyaları doğrula" Command="{Binding VerifyCommand}" />
                            </UniformGrid>
                        </StackPanel>
                        <!-- Burada oynayanlar -->
                        <StackPanel IsVisible="{Binding HasPlayingHere}" Orientation="Horizontal" Spacing="6">
                            <ItemsControl ItemsSource="{Binding PlayingHere}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PersonItem">
                                        <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True" Background="{StaticResource Raised}" ToolTip.Tip="{Binding Username}"
                                                BoxShadow="0 0 0 2 #14100C, 0 0 0 3.5 #7FC98A">
                                            <Panel>
                                                <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                            </Panel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding PlayingHereText}" FontSize="12.5" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                </DockPanel>
            </DockPanel>
        </Border>
        <!-- Sürüklenen kapağın görüntüsü: her şeyin üstünde imleci izler (LibraryView.Drag.cs) -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="False" ZIndex="100" />
    </Grid>
</UserControl>
