<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             xmlns:v="using:VuluLauncher.Views"
             xmlns:sh="using:VuluShared"
             x:Class="VuluLauncher.Views.SplashView"
             x:DataType="vm:SplashViewModel"
             ClipToBounds="True">
    <!-- Meşale açılışı (web: css/mesale.css + js/mesale.js): karanlıkta yazı tutuşur, kor ışığı titrer, kıvılcımlar uçar;
         launcher hazır olunca karanlık yazıdan dışa doğru yanarak açılır. Kareler SplashView.axaml.cs'de. -->
    <Panel x:Name="Stage" Background="Transparent">
        <v:EmberSheet x:Name="Sheet" />

        <!-- Kor ışığı: yazının arkasında amber bir hale -->
        <Border x:Name="Glow" IsHitTestVisible="False" Opacity="0">
            <Border.Background>
                <RadialGradientBrush Center="50%,47%" GradientOrigin="50%,47%" RadiusX="46%" RadiusY="34%">
                    <GradientStop Offset="0" Color="#33F2822A" />
                    <GradientStop Offset="0.55" Color="#0FF26E1E" />
                    <GradientStop Offset="0.78" Color="#00F26E1E" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel x:Name="Title" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" RenderTransformOrigin="50%,50%">
            <sh:ScriptTitle x:Name="Letters" Width="500">
                <sh:ScriptTitle.Effect>
                    <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="18" Color="#FF9632" Opacity="0.55" />
                </sh:ScriptTitle.Effect>
            </sh:ScriptTitle>
            <TextBlock x:Name="GreetingText" Text="{Binding Greeting}" Margin="0,14,0,0" HorizontalAlignment="Center" Opacity="0"
                       FontSize="13.5" FontWeight="Medium" LetterSpacing="0.4" Foreground="#E9DCCB" />
            <TextBlock Text="{Binding Status}" MinHeight="18" Margin="0,16,0,0" HorizontalAlignment="Center"
                       FontSize="12" FontWeight="Medium" LetterSpacing="0.5" Foreground="#C9BDAF" />
        </StackPanel>

        <v:EmberSparks x:Name="Sparks" />
    </Panel>
</UserControl>
