<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             xmlns:v="using:VuluLauncher.Views"
             xmlns:sh="using:VuluShared"
             x:Class="VuluLauncher.Views.SplashView"
             x:DataType="vm:SplashViewModel"
             ClipToBounds="True">
    <!-- Meşale açılışı (web: css/mesale.css + js/mesale.js): karanlıkta yazı tutuşur, kor ışığı titrer, kıvılcımlar uçar;
         launcher hazır olunca karanlık yazıdan dışa doğru yanarak açılır. Kareler SplashView.axaml.cs'de. -->
    <Panel x:Name="Stage" Background="Transparent">
        <v:EmberSheet x:Name="Sheet" />

        <!-- Kor ışığı: yazının arkasında amber bir hale -->
        <Border x:Name="Glow" IsHitTestVisible="False" Opacity="0">
            <Border.Background>
                <RadialGradientBrush Center="50%,47%" GradientOrigin="50%,47%" RadiusX="46%" RadiusY="34%">
                    <GradientStop Offset="0" Color="#33F2822A" />
                    <GradientStop Offset="0.55" Color="#0FF26E1E" />
                    <GradientStop Offset="0.78" Color="#00F26E1E" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel x:Name="Title" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" RenderTransformOrigin="50%,50%">
            <sh:ScriptTitle x:Name="Letters" Width="500">
                <sh:ScriptTitle.Effect>
                    <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="18" Color="#FF9632" Opacity="0.55" />
                </sh:ScriptTitle.Effect>
            </sh:ScriptTitle>
            <TextBlock x:Name="GreetingText" Text="{Binding Greeting}" Margin="0,14,0,0" HorizontalAlignment="Center" Opacity="0"
                       FontSize="13.5" FontWeight="Medium" LetterSpacing="0.4" Foreground="#E9DCCB" />
            <TextBlock Text="{Binding Status}" MinHeight="18" Margin="0,16,0,0" HorizontalAlignment="Center"
                       FontSize="12" FontWeight="Medium" LetterSpacing="0.5" Foreground="#C9BDAF" />
        </StackPanel>

        <v:EmberSparks x:Name="Sparks" />

        <!-- Kütüphane açılışı: ortada bir raf ve üstünde dizili kitaplar; soldaki kitap devrilince öbürleri domino gibi sırayla
             sağa yaslanır, sonra altta simge, yazı ve karşılama belirir. Kitaplar kodla çizilir (SplashView.axaml.cs BuildBooks).
             Açılırken her şey söner, altta gerçek kütüphane görünür. -->
        <Panel x:Name="KutStage" IsVisible="False">
            <Border Background="#0B0A09" />
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="50%,46%" GradientOrigin="50%,46%" RadiusX="55%" RadiusY="55%">
                        <GradientStop Offset="0" Color="#1FF2A33A" />
                        <GradientStop Offset="1" Color="#00F2A33A" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Canvas x:Name="KutBooks" IsHitTestVisible="False" />
            <StackPanel x:Name="KutTitle" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,470,0,0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                    <Border x:Name="KutMark" Width="48" Height="48" CornerRadius="13" Background="#F2A33A" VerticalAlignment="Center" Opacity="0">
                        <Image Source="avares://vulu Launcher/Assets/logo.png" Width="26" Height="26" />
                    </Border>
                    <TextBlock x:Name="KutWord" Text="vulu Launcher" FontSize="46" FontWeight="SemiBold" LetterSpacing="-1.2" Foreground="#F3ECE2" Opacity="0" />
                </StackPanel>
                <TextBlock x:Name="KutGreeting" Text="{Binding Greeting}" Margin="0,18,0,0" HorizontalAlignment="Center" Opacity="0"
                           FontSize="13.5" FontWeight="Medium" Foreground="#C9BDAF" />
                <TextBlock Text="{Binding Status}" MinHeight="18" Margin="0,10,0,0" HorizontalAlignment="Center"
                           FontSize="12" FontWeight="Medium" Foreground="#A1958A" />
            </StackPanel>
        </Panel>

        <!-- Grafit açılışı: boş grafit zemine launcher'ın üç kartı sırayla, hafifçe aşağıdan gelip oturur; yazı ortadaki
             kartta belirir. Açılırken kartlar ve yazı söner, altta aynı yerde duran gerçek kartlar görünür.
             Kartların yerleri Oyna sayfasının Grafit yerleşimiyle aynı (HomeView.axaml.cs ApplyLayout). -->
        <Panel x:Name="GrafitStage" IsVisible="False">
            <Border x:Name="GrafitBg" Background="#101112" />
            <Grid Margin="14,64,14,14" ColumnDefinitions="264,14,*,14,314">
                <Border x:Name="GrafitLeft" Background="#18191B" BorderBrush="#222428" BorderThickness="1" CornerRadius="14" Opacity="0" />
                <Border x:Name="GrafitCenter" Grid.Column="2" Background="#18191B" BorderBrush="#222428" BorderThickness="1" CornerRadius="14" Opacity="0" />
                <Border x:Name="GrafitRight" Grid.Column="4" Background="#18191B" BorderBrush="#222428" BorderThickness="1" CornerRadius="14" Opacity="0" />
                <StackPanel x:Name="GrafitTitle" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Border x:Name="GrafitMark" Width="44" Height="44" CornerRadius="11" Background="#C5F04A" VerticalAlignment="Center" Opacity="0">
                            <TextBlock Text="v" FontSize="26" FontWeight="Bold" Foreground="#101112" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                        </Border>
                        <TextBlock x:Name="GrafitWord" Text="vulu Launcher" FontSize="46" FontWeight="SemiBold" LetterSpacing="-1.4" Foreground="#EDEEEF" Opacity="0" />
                    </StackPanel>
                    <TextBlock x:Name="GrafitGreeting" Text="{Binding Greeting}" Margin="0,18,0,0" HorizontalAlignment="Center" Opacity="0"
                               FontSize="13.5" FontWeight="Medium" Foreground="#B9BCC1" />
                    <TextBlock Text="{Binding Status}" MinHeight="18" Margin="0,10,0,0" HorizontalAlignment="Center"
                               FontSize="12" FontWeight="Medium" Foreground="#A3A7AD" />
                </StackPanel>
            </Grid>
        </Panel>

        <!-- Ufkun öbür ucu açılışı: karanlıktan güneş doğar, ızgara akar, krom yazı belirir; açılırken ızgara hızlanır,
             sahne beyaza parlayıp söner (vulu-web /vulusalufuk hero'su). Kareler SplashView.axaml.cs'de. -->
        <Panel x:Name="UfukStage" IsVisible="False">
            <v:SynthwaveBackdrop x:Name="UfukScene" Manual="True" />
            <StackPanel x:Name="UfukTitle" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,170,0,0"
                        IsHitTestVisible="False" RenderTransformOrigin="50%,50%">
                <TextBlock x:Name="UfukTop" Text="OLAY UFKUNUN ÖBÜR YANI" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"
                           LetterSpacing="6" Foreground="#9FF4FF" Opacity="0">
                    <TextBlock.Effect><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="14" Color="#00D7FF" Opacity="0.8" /></TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="UfukWord" Text="vulu Launcher" HorizontalAlignment="Center" FontSize="104" FontFamily="{StaticResource Script}"
                           Padding="40,0" Margin="0,0,0,-10" Opacity="0">
                    <TextBlock.Foreground>
                        <!-- Krom: koyu lacivert, mavi, beyaz ufuk çizgisi, pembe, sarı (ufuk.css .uf-krom) -->
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#0A0638" />
                            <GradientStop Offset="0.3" Color="#3D7BFF" />
                            <GradientStop Offset="0.47" Color="#EAF8FF" />
                            <GradientStop Offset="0.505" Color="#2A0B2E" />
                            <GradientStop Offset="0.72" Color="#FF3EC8" />
                            <GradientStop Offset="1" Color="#FFD77A" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    <TextBlock.Effect><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="22" Color="#FF2DF1" Opacity="0.9" /></TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="UfukGreeting" Text="{Binding Greeting}" Margin="0,22,0,0" HorizontalAlignment="Center" Opacity="0"
                           FontSize="13.5" FontWeight="Medium" LetterSpacing="0.4" Foreground="#F1E8FF" />
                <TextBlock Text="{Binding Status}" MinHeight="18" Margin="0,12,0,0" HorizontalAlignment="Center"
                           FontSize="12" FontWeight="Medium" LetterSpacing="0.5" Foreground="#D2C3EE" />
            </StackPanel>
        </Panel>
    </Panel>
</UserControl>
