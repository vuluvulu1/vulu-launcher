<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             xmlns:v="using:VuluLauncher.Views"
             x:Class="VuluLauncher.Views.ModalHost"
             x:DataType="vm:ModalViewModel">
    <!-- Bütün kutuların görünümleri: kutunun türüne göre biri seçilir -->
    <UserControl.Styles>
        <Style Selector="TextBlock.modal-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.modal-foot">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="Border.tag">
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Border.row-card">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Border.unfit"><Setter Property="Opacity" Value="0.55" /></Style>
        <Style Selector="Button.link.danger"><Setter Property="Foreground" Value="{StaticResource Error}" /></Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="Button.sm">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- Paketin bir revizyonundaki değişiklikler -->
        <DataTemplate x:Key="ChangeTemplate" x:DataType="vm:ChangeEntry">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Head}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Added}">
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Foreground="{StaticResource Ok}" FontSize="12.5" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Updated}">
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" FontSize="12.5" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Removed}">
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Foreground="{StaticResource Error}" FontSize="12.5" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Config ve paket dosyaları da güncellendi." IsVisible="{Binding FilesChanged}" Classes="dim" FontSize="12.5" />
                    <TextBlock Text="{Binding Empty}" IsVisible="{Binding HasEmpty}" Classes="dim" FontSize="12.5" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HealthTemplate" x:DataType="vm:HealthItem">
            <Border Classes="row-card">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="32" Height="32" Background="{StaticResource Raised}" ClipToBounds="True" Margin="0,0,10,0" VerticalAlignment="Top"
                            IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                            <Border Classes="tag" IsVisible="{Binding HasBadge}" Margin="0" Padding="5,0"><TextBlock Text="{Binding Badge}" FontSize="11" /></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Warn}" IsVisible="{Binding HasWarn}" Foreground="{StaticResource Warn}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="link" Content="{Binding LinkText}" IsVisible="{Binding HasLink}" Command="{Binding OpenLinkCommand}"
                            VerticalAlignment="Top" Margin="10,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
        <!-- Seçim listesindeki satır (paket, sunucu, instance) -->
        <DataTemplate x:Key="PickRowTemplate" x:DataType="vm:PickRow">
            <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                    Command="{Binding $parent[ContentControl].((vm:ModalViewModel)DataContext).PickRowCommand}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Sub}" Classes="dim" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ContentControl Content="{Binding}">
        <ContentControl.DataTemplates>
            <!-- ── Soru / bilgi ─────────────────────────────────────────── -->
            <DataTemplate DataType="vm:DialogViewModel">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,0" />
                    <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" Margin="22,10,22,20" LineHeight="20" />
                    <Border Classes="modal-foot">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="{Binding CancelText}" IsVisible="{Binding HasCancel}" Command="{Binding DismissCommand}" />
                            <Button Classes="primary" Classes.danger="{Binding IsDanger}" Content="{Binding OkText}" Command="{Binding OkCommand}" IsDefault="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── vulu Packs: paket ayrıntısı ──────────────────────────── -->
            <DataTemplate DataType="vm:PackDetailsModal">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Classes="modal-foot">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Button Classes="sm danger" Content="Sil" IsVisible="{Binding Card.IsAdmin}" Command="{Binding DeleteCommand}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,8,0">
                                <Button Classes="sm" Content="Arkadaşına gönder" Command="{Binding SendCommand}" />
                                <Button Classes="sm" Content="Kapat" Command="{Binding DismissCommand}" />
                            </StackPanel>
                            <Button Grid.Column="3" Classes="sm" Classes.primary="{Binding Card.ActionIsPrimary}"
                                    Content="{Binding Card.ActionText}" Command="{Binding ActCommand}" />
                        </Grid>
                    </Border>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="200,*" Margin="20,20,20,0">
                        <Border Height="112" Background="{StaticResource Raised}" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="{Binding Card.Name}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="8" />
                                <Image Source="{Binding Card.Cover}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,4,0,0" Spacing="4">
                            <TextBlock Text="{Binding Card.Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Card.DetailMeta}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer MaxHeight="440" Margin="0,14,0,0">
                        <StackPanel Margin="20,0,20,18" Spacing="12">
                            <TextBlock Text="{Binding Card.Description}" IsVisible="{Binding Card.HasDescription}" TextWrapping="Wrap" Classes="muted" />
                            <ItemsControl ItemsSource="{Binding Card.AllTags}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:Tag">
                                        <Border Classes="tag"><TextBlock Text="{Binding Text}" FontSize="12" FontWeight="SemiBold" /></Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel IsVisible="{Binding HasChanges}" Spacing="8">
                                <TextBlock Text="Değişiklikler" FontWeight="Bold" />
                                <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource ChangeTemplate}" />
                                <Button Classes="link" Content="{Binding ShowAllText}" IsVisible="{Binding CanShowAll}" Command="{Binding ExpandChangesCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </DataTemplate>

            <!-- ── vulu Packs: güncelleme sorusu ────────────────────────── -->
            <DataTemplate DataType="vm:PackUpdateModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,0" />
                    <ScrollViewer MaxHeight="420" Margin="0,10,0,0">
                        <StackPanel Margin="22,0,22,18" Spacing="10">
                            <TextBlock Text="{Binding Revisions}" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource ChangeTemplate}" />
                            <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Paketteki config dosyaları seninkilerin üzerine yazılır. Kendi eklediğin modlar ve dünyaların yerinde kalır; dünyalar güncellemeden önce yedeklenir." />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Classes="modal-foot">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Vazgeç" Command="{Binding DismissCommand}" />
                            <Button Classes="primary" Content="Güncelle" Command="{Binding OkCommand}" IsDefault="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Sürüm seç ───────────────────────────────────────────── -->
            <DataTemplate DataType="vm:VersionPickerModal">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="22,18,22,10">
                        <TextBlock Classes="modal-title" Text="{Binding Title}" />
                        <Button Grid.Column="1" Classes="link" Content="Kapat" Command="{Binding DismissCommand}" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Classes="muted" Classes.error="{Binding IsError}" Margin="22,0,22,18" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="460">
                        <ItemsControl ItemsSource="{Binding Versions}" Margin="22,0,22,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VersionRow">
                                    <Border Classes="row-card">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                    <Border Classes="tag" IsVisible="{Binding HasBadge}" Margin="0" Padding="5,0">
                                                        <TextBlock Text="{Binding Badge}" FontSize="11" />
                                                    </Border>
                                                    <Border Classes="tag" IsVisible="{Binding ManualOnly}" Margin="0" Padding="5,0"
                                                            ToolTip.Tip="Yapımcısı başka uygulamalardan indirilmesine izin vermiyor">
                                                        <TextBlock Text="Elle indirilir" FontSize="11" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="sm primary" Content="Bu sürümü kur" Command="{Binding PickCommand}"
                                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </DataTemplate>

            <!-- ── Nereye kurulsun ─────────────────────────────────────── -->
            <DataTemplate DataType="vm:TargetPickerModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,12" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Margin="22,0,22,16" IsVisible="{Binding IsEmpty}"
                               Text="Henüz kişisel instance yok. Yeni instance oluşturma yeni arayüze yakında geliyor; şimdilik bir modpack kurabilirsin." />
                    <ScrollViewer MaxHeight="420">
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="22,0,22,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TargetRow">
                                    <Border Classes="row-card" Classes.unfit="{Binding !Fits}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="sm" Classes.primary="{Binding Fits}" Content="Buraya kur"
                                                    IsEnabled="{Binding Fits}" Command="{Binding PickCommand}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Classes="modal-foot">
                        <Button Content="Vazgeç" Command="{Binding DismissCommand}" HorizontalAlignment="Right" />
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Elle indirilecek CurseForge dosyaları ────────────────── -->
            <DataTemplate DataType="vm:ManualDownloadsModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,8" />
                    <ScrollViewer MaxHeight="460">
                        <StackPanel Margin="22,0,22,16" Spacing="10">
                            <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Classes="muted" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ManualRow">
                                        <Border Classes="row-card" Classes.placed="{Binding Placed}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Detail}" Classes="dim" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Status}" FontSize="12" Classes.ok="{Binding Placed}" Classes.problem="{Binding IsProblem}"
                                                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="sm" Content="CurseForge'da aç ↗" Command="{Binding OpenCommand}"
                                                        VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.Styles>
                                    <Style Selector="Border.placed"><Setter Property="BorderBrush" Value="{StaticResource Ok}" /></Style>
                                    <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{StaticResource Ok}" /></Style>
                                    <Style Selector="TextBlock.problem"><Setter Property="Foreground" Value="{StaticResource Error}" /></Style>
                                </ItemsControl.Styles>
                            </ItemsControl>
                            <TextBlock Text="{Binding Help}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Foreground="{StaticResource Warn}" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Classes="modal-foot">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Instance klasörünü aç" IsVisible="{Binding HasInstance}" Command="{Binding OpenFolderCommand}" />
                            <Button Content="Kapat" Command="{Binding DismissCommand}" Classes.primary="{Binding AllPlaced}" />
                            <Button Classes="primary" Content="İndirilenleri kontrol et" Command="{Binding CheckCommand}"
                                    IsVisible="{Binding HasInstance}" IsEnabled="{Binding !Checking}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Yeni instance / düzenle ─────────────────────────────── -->
            <DataTemplate DataType="vm:InstanceEditorModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,12" />
                    <StackPanel Margin="22,0,22,18" Spacing="6">
                        <TextBlock Text="Ad" Classes="label" />
                        <TextBox Text="{Binding Name}" MaxLength="40" Watermark="Örn. Fabric 1.21" />
                        <TextBlock Text="Minecraft sürümü" Classes="label" Margin="0,8,0,0" />
                        <ComboBox ItemsSource="{Binding McVersions}" SelectedItem="{Binding McVersion}" HorizontalAlignment="Stretch" MaxDropDownHeight="360" />
                        <TextBlock Text="Mod yükleyici" Classes="label" Margin="0,8,0,0" />
                        <ItemsControl ItemsSource="{Binding Loaders}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:Choice">
                                    <Button Classes="seg" Classes.active="{Binding IsSelected}" Content="{Binding Label}"
                                            Command="{Binding $parent[ItemsControl].((vm:InstanceEditorModal)DataContext).PickLoaderCommand}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel IsVisible="{Binding ShowLoaderVersion}" Spacing="6" Margin="0,8,0,0">
                            <TextBlock Text="Yükleyici sürümü" Classes="label" />
                            <ComboBox ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding LoaderVersion}" HorizontalAlignment="Stretch"
                                      MaxDropDownHeight="300" PlaceholderText="Yükleniyor..." />
                        </StackPanel>
                        <TextBlock Text="{Binding Hint}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" FontSize="12.5" TextWrapping="Wrap"
                                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <Border Classes="modal-foot">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Vazgeç" Command="{Binding DismissCommand}" />
                            <Button Classes="primary" Content="{Binding SubmitText}" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}" IsDefault="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Kısa metin sorusu ───────────────────────────────────── -->
            <DataTemplate DataType="vm:PromptModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,12" />
                    <StackPanel Margin="22,0,22,18" Spacing="6">
                        <TextBlock Text="{Binding Label}" Classes="label" />
                        <TextBox Text="{Binding Value}" MaxLength="40" />
                    </StackPanel>
                    <Border Classes="modal-foot">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Vazgeç" Command="{Binding DismissCommand}" />
                            <Button Classes="primary" Content="{Binding OkText}" Command="{Binding OkCommand}" IsDefault="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Görünüm: simge, logo, arka plan ──────────────────────── -->
            <DataTemplate DataType="vm:AppearanceModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,12" />
                    <StackPanel Margin="22,0,22,16" Spacing="14">
                        <Grid ColumnDefinitions="150,*" IsVisible="{Binding IsCustom}">
                            <Border Width="72" Height="72" Background="{StaticResource Raised}" HorizontalAlignment="Left" ClipToBounds="True">
                                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Simge" FontWeight="Bold" />
                                <TextBlock Text="Soldaki küçük karede görünür. Kare resimler en iyisi; en çok 4 MB." Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                                <CheckBox Content="Simge yoksa arka planı simge olarak kullan" IsChecked="{Binding BackgroundAsIcon}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="sm primary" Content="Resim seç" Command="{Binding PickIconCommand}" />
                                    <Button Classes="sm danger" Content="Kaldır" IsVisible="{Binding HasIcon}" Command="{Binding ClearIconCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="150,*">
                            <Border Width="140" Height="72" Background="#0B0A09" HorizontalAlignment="Left" Padding="6">
                                <Grid>
                                    <TextBlock Text="{Binding Name}" IsVisible="{Binding Logo, Converter={x:Static ObjectConverters.IsNull}}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                    <Image Source="{Binding Logo}" Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Logo" FontWeight="Bold" />
                                <TextBlock Text="Ana ekranda paket adının yerine görünür. Saydam arka planlı PNG en iyisi; en çok 4 MB." Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LogoReset}" IsVisible="{Binding HasLogo}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="sm primary" Content="Resim seç" Command="{Binding PickLogoCommand}" />
                                    <Button Classes="sm danger" Content="Kaldır" IsVisible="{Binding HasLogo}" Command="{Binding ClearLogoCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="150,*">
                            <Border Width="140" Height="79" Background="{StaticResource Raised}" HorizontalAlignment="Left" ClipToBounds="True">
                                <Image Source="{Binding Background}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Arka plan" FontWeight="Bold" />
                                <TextBlock Text="Ana ekranda arkada görünür. PNG, JPG, WEBP ya da GIF; geniş (16:9) resimler en iyisi." Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding BackgroundReset}" IsVisible="{Binding HasBackground}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="sm primary" Content="Resim seç" Command="{Binding PickBackgroundCommand}" />
                                    <Button Classes="sm danger" Content="Kaldır" IsVisible="{Binding HasBackground}" Command="{Binding ClearBackgroundCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Paylaştığın paketlerde logo da pakete eklenir; &quot;Paylaşımı güncelle&quot; ile kuranlara da gider." IsVisible="{Binding IsShared}"
                                   Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" FontSize="12.5" TextWrapping="Wrap"
                                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <Border Classes="modal-foot">
                        <Button Classes="primary" Content="Tamam" Command="{Binding DoneCommand}" HorizontalAlignment="Right" />
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── İçerik yönetimi ─────────────────────────────────────── -->
            <DataTemplate DataType="vm:ContentModal">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="22,18,22,10">
                        <TextBlock Classes="modal-title" Text="{Binding Title}" />
                        <Button Grid.Column="1" Classes="link" Content="Kapat" Command="{Binding DismissCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="22,0,22,10">
                        <TextBlock Text="{Binding Summary}" Classes="dim" FontSize="12.5" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Classes="sm primary" Content="{Binding UpdateAllText}" IsVisible="{Binding HasStableUpdates}" Command="{Binding UpdateAllCommand}" />
                            <Button Classes="sm" Content="{Binding CheckText}" IsEnabled="{Binding CanCheck}" Command="{Binding CheckUpdatesCommand}" />
                            <Button Classes="sm primary" Content="+ İçerik ekle" Command="{Binding AddContentCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Bu instance'ta henüz mod, kaynak paketi ya da shader yok." IsVisible="{Binding IsEmpty}" Classes="muted" Margin="22,0,22,18" />
                    <ScrollViewer MaxHeight="480">
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="22,0,22,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ContentRow">
                                    <Border Classes="row-card" Classes.unfit="{Binding !Enabled}">
                                        <Grid ColumnDefinitions="36,*,Auto,Auto,Auto">
                                            <Border Width="36" Height="36" Background="{StaticResource Raised}" ClipToBounds="True">
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="sm primary" Content="{Binding UpdateText}" IsVisible="{Binding HasUpdate}"
                                                    Command="{Binding UpdateCommand}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ToggleSwitch Grid.Column="3" IsChecked="{Binding Enabled}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                                                          ToolTip.Tip="Aç / kapat" />
                                            <Button Grid.Column="4" Classes="sm danger" Content="Kaldır" Command="{Binding RemoveCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </DataTemplate>

            <!-- ── Dünyalar ve yedekler ────────────────────────────────── -->
            <DataTemplate DataType="vm:WorldsModal">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="22,18,22,10">
                        <TextBlock Classes="modal-title" Text="{Binding Title}" />
                        <Button Grid.Column="1" Classes="link" Content="Kapat" Command="{Binding DismissCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="22,0,22,10">
                        <TextBlock Text="{Binding Summary}" Classes="dim" FontSize="12.5" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="sm" Content="Yedek klasörünü aç" Command="{Binding OpenBackupsCommand}" />
                    </Grid>
                    <TextBlock Text="Oyun açıkken yedekleme ve geri yükleme yapılamaz." IsVisible="{Binding Running}" Foreground="{StaticResource Warn}" FontSize="12.5" Margin="22,0,22,8" />
                    <TextBlock Text="Bu instance'ta henüz dünya yok." IsVisible="{Binding IsEmpty}" Classes="muted" Margin="22,0,22,10" />
                    <ScrollViewer MaxHeight="440">
                        <ItemsControl ItemsSource="{Binding Worlds}" Margin="22,0,22,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorldRow">
                                    <Border Classes="row-card">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="40,*,Auto">
                                                <Border Width="40" Height="40" Background="{StaticResource Raised}" ClipToBounds="True">
                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="sm primary" Content="Yedekle" Command="{Binding BackupCommand}"
                                                        IsEnabled="{Binding !Running}" VerticalAlignment="Center" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Backups}" Margin="50,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:BackupRow">
                                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                                            <TextBlock Text="{Binding Text}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Classes="link" Content="Geri yükle" IsEnabled="{Binding !Running}" Command="{Binding RestoreCommand}" Margin="12,0" />
                                                            <Button Grid.Column="2" Classes="link danger" Content="Sil" Command="{Binding DeleteCommand}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Paket güncellenmeden önce dünyalar otomatik yedeklenir; her dünyanın son 5 otomatik yedeği tutulur."
                               Classes="dim" FontSize="12.5" TextWrapping="Wrap" Margin="22,4,22,18" />
                </StackPanel>
            </DataTemplate>

            <!-- ── Ekran görüntüleri ───────────────────────────────────── -->
            <DataTemplate DataType="vm:ScreenshotsModal">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="22,18,22,6">
                        <TextBlock Classes="modal-title" Text="{Binding Title}" />
                        <Button Grid.Column="1" Classes="link" Content="Kapat" Command="{Binding DismissCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding Summary}" Classes="dim" FontSize="12.5" Margin="22,0,22,10" />
                    <TextBlock Text="Henüz ekran görüntüsü yok. Oyunda F2 tuşuna basınca burada görünür." IsVisible="{Binding IsEmpty}" Classes="muted" Margin="22,0,22,18" />
                    <ScrollViewer MaxHeight="540">
                        <ItemsControl ItemsSource="{Binding Shots}" Margin="22,0,10,16">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShotItem">
                                    <StackPanel Width="256" Margin="0,0,12,14" Spacing="5">
                                        <Button Classes="flat" Padding="0" Command="{Binding OpenCommand}" ToolTip.Tip="Aç">
                                            <Border Width="256" Height="144" Background="{StaticResource Raised}" ClipToBounds="True">
                                                <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                            </Border>
                                        </Button>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding When}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                        IsVisible="{Binding $parent[ItemsControl].((vm:ScreenshotsModal)DataContext).NotPick}">
                                                <Button Classes="link" Content="Kopyala" Command="{Binding CopyCommand}" />
                                                <Button Classes="link" Content="Klasörde" Command="{Binding RevealCommand}" />
                                                <Button Classes="link danger" Content="Sil" Command="{Binding DeleteCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </DataTemplate>

            <!-- ── Dosyaları doğrula sonucu ────────────────────────────── -->
            <DataTemplate DataType="vm:VerifyModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,6" />
                    <TextBlock Text="{Binding Intro}" Classes="muted" TextWrapping="Wrap" Margin="22,0,22,12" />
                    <ItemsControl ItemsSource="{Binding Items}" Margin="22,0,22,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:VerifyLine">
                                <Grid ColumnDefinitions="22,*" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Mark}" FontWeight="Bold" Classes.ok="{Binding Ok}" Classes.warn="{Binding !Ok}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Text}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Detail}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Styles>
                            <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{StaticResource Ok}" /></Style>
                            <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="{StaticResource Warn}" /></Style>
                        </ItemsControl.Styles>
                    </ItemsControl>
                    <Border Classes="modal-foot">
                        <Button Classes="primary" Content="Tamam" Command="{Binding OkCommand}" HorizontalAlignment="Right" IsDefault="True" />
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Eksik bağımlılıklar ─────────────────────────────────── -->
            <DataTemplate DataType="vm:MissingDepsModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="Eksik modlar var" Margin="22,18,22,6" />
                    <TextBlock Text="{Binding Intro}" Classes="muted" TextWrapping="Wrap" Margin="22,0,22,12" />
                    <ScrollViewer MaxHeight="400">
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource HealthTemplate}" Margin="22,0,22,14" />
                    </ScrollViewer>
                    <Border Classes="modal-foot">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Vazgeç" Command="{Binding DismissCommand}" />
                            <Button Content="Yine de oyna" Command="{Binding IgnoreCommand}" />
                            <Button Classes="primary" Content="{Binding InstallText}" IsVisible="{Binding CanInstall}" Command="{Binding InstallCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Sorunlu mod dosyaları ───────────────────────────────── -->
            <DataTemplate DataType="vm:FileProblemsModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,6" />
                    <TextBlock Text="{Binding Intro}" Classes="muted" TextWrapping="Wrap" Margin="22,0,22,12" />
                    <ScrollViewer MaxHeight="440">
                        <StackPanel Margin="22,0,22,14" Spacing="12">
                            <StackPanel IsVisible="{Binding HasBad}" Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Sorunlu dosyalar" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="sm" Content="{Binding MoveText}" IsEnabled="{Binding CanMove}" Command="{Binding MoveCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Bad}" ItemTemplate="{StaticResource HealthTemplate}" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding HasManual}" Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Elle indirilmesi gerekenler" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="sm" Content="{Binding ManualText}" Command="{Binding OpenManualCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Manual}" ItemTemplate="{StaticResource HealthTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Classes="modal-foot">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Vazgeç" Command="{Binding DismissCommand}" />
                            <Button Content="Yine de oyna" Command="{Binding IgnoreCommand}" />
                            <Button Classes="primary" Content="Tekrar dene" Command="{Binding RetryCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Çökme ───────────────────────────────────────────────── -->
            <DataTemplate DataType="vm:CrashModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,6" />
                    <TextBlock Text="{Binding Intro}" Classes="muted" TextWrapping="Wrap" Margin="22,0,22,12" />
                    <ScrollViewer MaxHeight="440">
                        <ItemsControl ItemsSource="{Binding Findings}" Margin="22,0,22,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CrashFinding">
                                    <Grid ColumnDefinitions="22,*" Margin="0,0,0,12">
                                        <TextBlock Text="!" FontWeight="Bold" Foreground="{StaticResource Error}" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Fix}" Foreground="{StaticResource AccentHi}" FontSize="12.5" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Actions}" IsVisible="{Binding HasActions}" Margin="0,4,0,0">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CrashAction">
                                                        <Button Classes="sm" Classes.primary="{Binding IsPrimary}" Content="{Binding Label}"
                                                                IsEnabled="{Binding CanRun}" Command="{Binding RunCommand}" Margin="0,0,6,6" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Classes="modal-foot">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                            <Button Content="Çökme raporunu aç" IsVisible="{Binding HasReport}" Command="{Binding OpenReportCommand}" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Klasörü aç" Command="{Binding OpenFolderCommand}" />
                            <Button Grid.Column="3" Content="Kapat" Command="{Binding DismissCommand}" Margin="0,0,8,0" />
                            <Button Grid.Column="4" Classes="primary" Content="Tekrar oyna" IsVisible="{Binding Changed}" Command="{Binding ReplayCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </DataTemplate>
            <!-- ── Sunucu ekle / düzenle (admin) ───────────────────────── -->
            <DataTemplate DataType="vm:ServerEditorModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,12" />
                    <StackPanel Margin="22,0,22,18" Spacing="6">
                        <TextBlock Text="Ad" Classes="label" />
                        <TextBox Text="{Binding Name}" MaxLength="40" Watermark="AGLR SMP" />
                        <TextBlock Text="Adres" Classes="label" Margin="0,6,0,0" />
                        <TextBox Text="{Binding Address}" MaxLength="120" Watermark="oyun.alanadi.com ya da 1.2.3.4:25565" />
                        <TextBlock Text="Açıklama" Classes="label" Margin="0,6,0,0" />
                        <TextBox Text="{Binding Description}" MaxLength="200" Watermark="Kısa bir açıklama (isteğe bağlı)" />
                        <TextBlock Text="Paket" Classes="label" Margin="0,6,0,0" />
                        <ComboBox ItemsSource="{Binding Packs}" SelectedItem="{Binding Pack}" HorizontalAlignment="Stretch" />
                        <StackPanel IsVisible="{Binding IsVanilla}" Spacing="6" Margin="0,6,0,0">
                            <TextBlock Text="Minecraft sürümü (Vanilla)" Classes="label" />
                            <TextBox Text="{Binding McVersion}" MaxLength="40" Watermark="ör. 1.21.1 (boşsa seçili sürüm)" />
                        </StackPanel>
                        <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Oyuncular &quot;Bağlan&quot;a basınca seçilen paketin instance'ı açılır ve oyun doğrudan bu adrese bağlanır. Paket kurulu değilse önce kurulur." />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" FontSize="12.5" TextWrapping="Wrap"
                                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <Border Classes="modal-foot">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Vazgeç" Command="{Binding DismissCommand}" />
                            <Button Classes="primary" Content="Kaydet" Command="{Binding SaveCommand}" IsDefault="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Paylaşılan ekran görüntüsü: büyük görünüm ve yorumlar ── -->
            <DataTemplate DataType="vm:ShotViewerModal">
                <Grid ColumnDefinitions="*,300" MaxHeight="660">
                    <Grid Background="#000000">
                        <Image Source="{Binding Image}" Stretch="Uniform" />
                        <TextBlock Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                        <Button Content="‹" FontSize="28" IsVisible="{Binding Many}" Command="{Binding PrevCommand}" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Margin="8" Padding="12,4" ToolTip.Tip="Önceki (←)" />
                        <Button Content="›" FontSize="28" IsVisible="{Binding Many}" Command="{Binding NextCommand}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="8" Padding="12,4" ToolTip.Tip="Sonraki (→)" />
                    </Grid>
                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8" Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <ContentControl Content="{Binding Shot.Author}" ContentTemplate="{StaticResource Avatar}" />
                                <Button Grid.Column="1" Classes="link" Content="{Binding Shot.Author.Username}" Command="{Binding OpenAuthorCommand}"
                                        Margin="8,0" FontWeight="Bold" ToolTip.Tip="Mesaj yaz" />
                                <Button Grid.Column="2" Classes="link" Content="Kapat" Command="{Binding DismissCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding Shot.Meta}" Classes="dim" FontSize="12" />
                            <TextBlock Text="{Binding Shot.Caption}" IsVisible="{Binding Shot.HasCaption}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="sm" Content="{Binding Shot.LikeText}" Command="{Binding LikeCommand}" />
                                <Button Classes="sm" Content="Kaydet" Command="{Binding SaveCommand}" ToolTip.Tip="Resimler\vulu Launcher klasörüne kaydeder" />
                                <Button Classes="sm danger" Content="Sil" IsVisible="{Binding Shot.CanDelete}" Command="{Binding RemoveCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="14,8,14,14">
                            <TextBox Text="{Binding Draft}" Watermark="Yorum yaz…" MaxLength="300">
                                <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SendCommentCommand}" /></TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1" Classes="sm primary" Content="Gönder" Command="{Binding SendCommentCommand}" Margin="6,0,0,0" />
                        </Grid>
                        <ScrollViewer Margin="14,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding CommentsStatus}" Classes="dim" FontSize="12.5" TextWrapping="Wrap"
                                           IsVisible="{Binding CommentsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <ItemsControl ItemsSource="{Binding Comments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CommentItem">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                                                <ContentControl Content="{Binding Author}" ContentTemplate="{StaticResource Avatar}" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1" Margin="8,0">
                                                    <TextBlock>
                                                        <Run Text="{Binding Author.Username}" FontWeight="Bold" /><Run Text=" · " Foreground="{StaticResource Dim}" /><Run Text="{Binding When}" Foreground="{StaticResource Dim}" FontSize="11.5" />
                                                    </TextBlock>
                                                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="link danger" Content="sil" IsVisible="{Binding CanDelete}" Command="{Binding DeleteCommand}" VerticalAlignment="Top" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DataTemplate>

            <!-- ── Ekran görüntüsünü paylaş ────────────────────────────── -->
            <DataTemplate DataType="vm:ShareShotModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="Ekran görüntüsünü paylaş" Margin="22,18,22,12" />
                    <StackPanel Margin="22,0,22,18" Spacing="8">
                        <Border Background="#000000" MaxHeight="280"><Image Source="{Binding Preview}" Stretch="Uniform" /></Border>
                        <TextBlock Text="{Binding Info}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Caption}" Watermark="Açıklama (isteğe bağlı)" MaxLength="200" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" FontSize="12.5" TextWrapping="Wrap"
                                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <Border Classes="modal-foot">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Vazgeç" Command="{Binding DismissCommand}" />
                            <Button Classes="primary" Content="Paylaş" Command="{Binding ShareCommand}" IsEnabled="{Binding !Busy}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Hangi paketten? ─────────────────────────────────────── -->
            <DataTemplate DataType="vm:InstancePickerModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="Hangi paketten?" Margin="22,18,22,12" />
                    <ScrollViewer MaxHeight="420">
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="16,0,16,12" ItemTemplate="{StaticResource PickRowTemplate}" />
                    </ScrollViewer>
                    <Border Classes="modal-foot"><Button Content="Vazgeç" Command="{Binding DismissCommand}" HorizontalAlignment="Right" /></Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Kişi seç ────────────────────────────────────────────── -->
            <DataTemplate DataType="vm:UserPickerModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,10" />
                    <TextBox Text="{Binding Search}" Watermark="Kullanıcı ara…" Margin="22,0,22,10" />
                    <ScrollViewer MaxHeight="380">
                        <ItemsControl ItemsSource="{Binding People}" Margin="16,0,16,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PersonItem">
                                    <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                                            Command="{Binding $parent[ItemsControl].((vm:UserPickerModal)DataContext).PickCommand}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Avatar}" />
                                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Classes="modal-foot"><Button Content="Vazgeç" Command="{Binding DismissCommand}" HorizontalAlignment="Right" /></Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Sohbette paylaş: paket ya da sunucu ─────────────────── -->
            <DataTemplate DataType="vm:CardPickerModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="Paylaş" Margin="22,18,22,8" />
                    <ScrollViewer MaxHeight="440">
                        <StackPanel Margin="16,0,16,12" Spacing="6">
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="6,0" />
                            <TextBlock Text="vulu Packs" FontWeight="Bold" Margin="6,4,0,0" />
                            <TextBlock Text="Paylaşılmış paket yok." IsVisible="{Binding NoPacks}" Classes="dim" Margin="6,0" />
                            <ItemsControl ItemsSource="{Binding Packs}" ItemTemplate="{StaticResource PickRowTemplate}" />
                            <TextBlock Text="Sunucular" FontWeight="Bold" Margin="6,8,0,0" />
                            <TextBlock Text="Eklenmiş sunucu yok." IsVisible="{Binding NoServers}" Classes="dim" Margin="6,0" />
                            <ItemsControl ItemsSource="{Binding Servers}" ItemTemplate="{StaticResource PickRowTemplate}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Classes="modal-foot"><Button Content="Vazgeç" Command="{Binding DismissCommand}" HorizontalAlignment="Right" /></Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Güvenlik kodu ───────────────────────────────────────── -->
            <DataTemplate DataType="vm:SafetyModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,8" />
                    <StackPanel Margin="22,0,22,18" Spacing="12">
                        <TextBlock Text="{Binding Intro}" Classes="muted" TextWrapping="Wrap" />
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="14">
                            <SelectableTextBlock Text="{Binding Code}" FontFamily="{StaticResource Mono}" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" LetterSpacing="1" />
                        </Border>
                        <TextBlock Text="✓ Bu kişiyi daha önce doğruladın." IsVisible="{Binding Verified}" Foreground="{StaticResource Ok}" />
                    </StackPanel>
                    <Border Classes="modal-foot">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Kapat" Command="{Binding DismissCommand}" />
                            <Button Classes="primary" Content="Kodlar aynı, doğrula" IsVisible="{Binding !Verified}" Command="{Binding VerifyCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Kırpma (profil resmi, banner) ───────────────────────── -->
            <DataTemplate DataType="vm:CropModal"><v:CropView /></DataTemplate>

            <!-- ── Admin: kullanıcı ekle / düzenle ─────────────────────── -->
            <DataTemplate DataType="vm:UserEditorModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,12" />
                    <StackPanel Margin="22,0,22,18" Spacing="6">
                        <TextBlock Text="Kullanıcı adı" Classes="label" />
                        <TextBox Text="{Binding Username}" MaxLength="16" IsEnabled="{Binding IsNew}" />
                        <TextBlock Text="Kullanıcı adı değiştirilemez; oyundaki eşyalar ve ilerleme ada bağlıdır." IsVisible="{Binding IsEdit}" Classes="dim" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="E-posta" Classes="label" Margin="0,6,0,0" />
                        <TextBox Text="{Binding Email}" MaxLength="254" IsEnabled="{Binding IsNew}" Watermark="İsteğe bağlı" />
                        <TextBlock Text="{Binding PasswordLabel}" Classes="label" Margin="0,6,0,0" />
                        <TextBox Text="{Binding Password}" PasswordChar="•" Watermark="{Binding PasswordHint}" />
                        <TextBlock Text="Şifre değişirse kullanıcının açık oturumları kapanır." IsVisible="{Binding IsEdit}" Classes="dim" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                            <CheckBox Content="Admin" IsChecked="{Binding IsAdmin}" IsEnabled="{Binding CanChangeFlags}" />
                            <CheckBox Content="Aktif" IsChecked="{Binding IsActive}" IsEnabled="{Binding CanChangeFlags}" />
                        </StackPanel>
                        <TextBlock Text="Kendi adminliğini kaldıramaz ya da kendini kapatamazsın." IsVisible="{Binding IsSelf}" Classes="dim" FontSize="12" />
                        <TextBlock Text="Roller" Classes="label" Margin="0,8,0,0" />
                        <TextBlock Text="Henüz rol yok. Roller sekmesinden oluşturabilirsin." IsVisible="{Binding NoRoles}" Classes="dim" FontSize="12.5" />
                        <ItemsControl ItemsSource="{Binding RoleBoxes}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RoleBox">
                                    <CheckBox IsChecked="{Binding Checked}" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Role.Name}" Foreground="{Binding Role.Brush}" FontWeight="SemiBold" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" FontSize="12.5" TextWrapping="Wrap"
                                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <Border Classes="modal-foot">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Vazgeç" Command="{Binding DismissCommand}" />
                            <Button Classes="primary" Content="{Binding SaveText}" Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ── Admin: rol ekle / düzenle ───────────────────────────── -->
            <DataTemplate DataType="vm:RoleEditorModal">
                <StackPanel>
                    <TextBlock Classes="modal-title" Text="{Binding Title}" Margin="22,18,22,12" />
                    <StackPanel Margin="22,0,22,18" Spacing="6">
                        <TextBlock Text="Rol adı" Classes="label" />
                        <TextBox Text="{Binding Name}" MaxLength="24" Watermark="ör. AGLR" />
                        <TextBlock Text="Renk" Classes="label" Margin="0,6,0,0" />
                        <ItemsControl ItemsSource="{Binding Colors}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Width="26" Height="26" Background="{Binding}" BorderThickness="0" Padding="0" ToolTip.Tip="{Binding}"
                                            Command="{Binding $parent[ItemsControl].((vm:RoleEditorModal)DataContext).PickColorCommand}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding Color}" MaxLength="7" Width="110" HorizontalAlignment="Left" Watermark="#RRGGBB" />
                        <Border BorderBrush="{Binding Brush}" BorderThickness="1" Padding="8,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Preview}" Foreground="{Binding Brush}" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" FontSize="12.5" TextWrapping="Wrap"
                                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <Border Classes="modal-foot">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Vazgeç" Command="{Binding DismissCommand}" />
                            <Button Classes="primary" Content="{Binding SaveText}" Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ContentControl.DataTemplates>
    </ContentControl>
</UserControl>
