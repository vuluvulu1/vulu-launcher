<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             xmlns:v="using:VuluLauncher.Views"
             x:Class="VuluLauncher.Views.PackGridView"
             x:DataType="vm:PacksViewModel">
    <!-- Yeni paket › vulu Packs: ekibin paylaştığı paketler, üç sütunlu kapak kartları -->
    <UserControl.Styles>
        <StyleInclude Source="avares://vulu Launcher/Views/CatalogStyles.axaml" />
    </UserControl.Styles>
    <DockPanel>
        <!-- Üst satır solda: paket sayısı, yanında yenile simgesi ve paket istekleri (sağ üst köşe pencerenin kapat düğmesine kalır) -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="{Binding Status}" Classes="dim" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"
                       IsVisible="{Binding !StatusIsError}" />
            <Button Classes="cact" Width="30" Height="30" Padding="0" Command="{Binding LoadCommand}" ToolTip.Tip="Yenile" AutomationProperties.Name="Yenile" IsVisible="{Binding !StatusIsError}"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center">
                <Path Classes="icon" Data="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" Width="13" Height="13" Stretch="Uniform" />
            </Button>
            <Button Classes="cact" Content="{Binding RequestText}" IsVisible="{Binding FeedbackEnabled}" Command="{Binding RequestsCommand}"
                    ToolTip.Tip="Pakete bağlı olmayan istekler: yeni paket, mod ya da özellik" VerticalAlignment="Center" />
        </StackPanel>
        <ScrollViewer>
            <StackPanel Margin="0,0,0,8">
                <v:EmptyState IsVisible="{Binding IsEmpty}" Margin="0,30,0,0" Icon="📦" Title="Henüz paylaşılan paket yok"
                              Text="Admin bir paket paylaştığında burada görünecek." />
                <v:EmptyState IsVisible="{Binding StatusIsError}" Margin="0,30,0,0" Icon="!" Title="Paketler yüklenemedi"
                              Text="{Binding Status}" ActionText="Tekrar dene" Command="{Binding LoadCommand}" />
                <UniformGrid Columns="3" IsVisible="{Binding Skeleton}">
                    <Border Classes="ccard" Height="250" Margin="0,0,14,14" IsHitTestVisible="False"><v:Skeleton Kind="card" /></Border>
                    <Border Classes="ccard" Height="250" Margin="0,0,14,14" IsHitTestVisible="False"><v:Skeleton Kind="card" /></Border>
                    <Border Classes="ccard" Height="250" Margin="0,0,14,14" IsHitTestVisible="False"><v:Skeleton Kind="card" /></Border>
                </UniformGrid>
                <ItemsControl ItemsSource="{Binding Cards}" v:Reveal.Stagger="True">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackCard">
                            <Border Classes="ccard" Margin="0,0,14,14" Cursor="Hand" Tapped="OnCardTapped">
                                <StackPanel>
                                    <Panel Height="120" Background="{StaticResource Raised}">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Classes="dim" TextWrapping="Wrap" TextAlignment="Center"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" />
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        <Border IsVisible="{Binding IsOutdated}" Background="{StaticResource Accent}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="8,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="Güncelleme var" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentInk}" />
                                        </Border>
                                    </Panel>
                                    <StackPanel Margin="12,10,12,12" Spacing="5">
                                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Foreground="{StaticResource Muted}" FontSize="12.5"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                                            <Button Classes="cact" Classes.primary="{Binding ActionIsPrimary}" Content="{Binding ActionText}" Command="{Binding ActCommand}" IsEnabled="{Binding !Busy}" />
                                            <Button Grid.Column="2" Classes="clink" Content="Ayrıntılar" Command="{Binding DetailsCommand}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
