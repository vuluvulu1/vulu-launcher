<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:VuluLauncher.Views"
        x:Class="VuluLauncher.Views.GrafitStyles">
    <!--
        "Grafit" temasında fırça olmayan değerler. Hep yüklüdür; pencere "grafit" sınıfını taşıdığında geçerli olur
        (Services/Themes.cs). Sade: ışıltı ve renkli gölge yok, her yüzey 1 px çizgili yuvarlak kart (#18191B, #2C2F33),
        tek vurgu limon yeşili #C5F04A. Oyna sayfasının kartlı yerleşimi HomeView.axaml.cs'de (ApplyLayout).
    -->

    <!-- ── Başlık çubuğu: düz, altında ince çizgi; sekmeler ortada, seçili sekme açık renk hap ── -->
    <Style Selector="Window.grafit Border#TitleBar, Window.grafit Border#TitleBar.overlay">
        <Setter Property="Background" Value="#101112" />
        <Setter Property="BoxShadow" Value="0 1 0 0 #222428" />
    </Style>
    <Style Selector="Window.grafit ItemsControl#NavTabs">
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Window.grafit Border.tabind">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.grafit Button.tab">
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#C2C5CA" />
    </Style>
    <Style Selector="Window.grafit Button.tab /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Window.grafit Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1F2124" />
    </Style>
    <Style Selector="Window.grafit Button.tab.active">
        <Setter Property="Background" Value="#EDEEEF" />
        <Setter Property="Foreground" Value="#101112" />
    </Style>
    <Style Selector="Window.grafit Button.tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#101112" />
    </Style>
    <Style Selector="Window.grafit Button.tab Border.bar">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.grafit Button.tab TextBlock">
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- ── Kartlar ── -->
    <Style Selector="Window.grafit Border.card, Window.grafit Border.row-card, Window.grafit Border.mcard">
        <Setter Property="Background" Value="#18191B" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#222428" />
        <Setter Property="BoxShadow" Value="none" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Window.grafit Border.card:pointerover, Window.grafit Border.row-card:pointerover, Window.grafit Border.lift.hover">
        <Setter Property="BorderBrush" Value="#3A3D42" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Window.grafit Border.mcard.console">
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Window.grafit Border.announce">
        <Setter Property="BoxShadow" Value="inset 3 0 0 0 #C5F04A" />
    </Style>
    <Style Selector="Window.grafit Border.ring">
        <Setter Property="BoxShadow" Value="0 0 0 2 #18191B, 0 0 0 3 #C5F04A" />
    </Style>
    <Style Selector="Window.grafit Border.barthumb">
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Window.grafit Border.bar">
        <Setter Property="BoxShadow" Value="none" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="#2C2F33" />
    </Style>
    <Style Selector="Window.grafit Border.chip">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Window.grafit Border.stat">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="#1F2124" />
    </Style>
    <Style Selector="Window.grafit Border.toast-card">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="#2C2F33" />
    </Style>
    <Style Selector="Window.grafit Border.modal-box">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BorderBrush" Value="#2C2F33" />
        <Setter Property="BoxShadow" Value="0 24 60 0 #B3000000" />
    </Style>
    <Style Selector="Window.grafit v|SettingsView Border.section">
        <Setter Property="Background" Value="#18191B" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#222428" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Window.grafit Border.bubble.mine">
        <Setter Property="Background" Value="#2E3A14" />
    </Style>

    <!-- ── Yazılar: sakin, orta kalınlıkta ── -->
    <Style Selector="Window.grafit TextBlock.page-title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.8" />
    </Style>

    <!-- ── Düğmeler: limon yeşili dolgu, koyu yazı; gölge yok ── -->
    <Style Selector="Window.grafit Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="none" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Window.grafit Button.play /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="none" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Window.grafit Button.play.small /template/ ContentPresenter#PART_ContentPresenter, Window.grafit Button.play.small:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="inset 0 0 0 1 #3A3D42" />
    </Style>
    <Style Selector="Window.grafit Button.play">
        <Setter Property="LetterSpacing" Value="1" />
        <Setter Property="MinWidth" Value="190" />
    </Style>
    <Style Selector="Window.grafit Button.hero /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Window.grafit Button.hero:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="#5A5E64" />
        <Setter Property="Foreground" Value="#EDEEEF" />
    </Style>
    <Style Selector="Window.grafit ComboBox.bar">
        <Setter Property="Background" Value="#1F2124" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Window.grafit ComboBox.bar /template/ Border#Background">
        <Setter Property="BoxShadow" Value="inset 0 0 0 1 #2C2F33" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Window.grafit Button.seg.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="inset 0 -2 0 0 #C5F04A" />
    </Style>
    <Style Selector="Window.grafit Button.info-tab">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Foreground" Value="#A3A7AD" />
    </Style>
    <Style Selector="Window.grafit Button.info-tab /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Window.grafit Button.info-tab.active">
        <Setter Property="Background" Value="#2C2F33" />
        <Setter Property="Foreground" Value="#EDEEEF" />
    </Style>
    <Style Selector="Window.grafit Button.info-tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2C2F33" />
        <Setter Property="Foreground" Value="#EDEEEF" />
    </Style>

    <!-- ── Oyna: paket listesi satır satır (simge, ad, sürüm); seçili satır açık zeminli, solda yeşil çizgi ── -->
    <Style Selector="Window.grafit ListBox.rail ListBoxItem">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Window.grafit ListBox.rail ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Window.grafit ListBox.rail ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1F2124" />
    </Style>
    <Style Selector="Window.grafit ListBox.rail ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, Window.grafit ListBox.rail ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#232528" />
        <Setter Property="BoxShadow" Value="inset 3 0 0 0 #C5F04A" />
    </Style>
    <Style Selector="Window.grafit ListBox.rail StackPanel.pack">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Spacing" Value="10" />
        <Setter Property="Margin" Value="8,0" />
    </Style>
    <Style Selector="Window.grafit ListBox.rail Border.thumb">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Window.grafit ListBox.rail ListBoxItem:selected Border.thumb, Window.grafit ListBox.rail StackPanel.drop Border.thumb">
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Window.grafit ListBox.rail StackPanel.dragging Border.thumb">
        <Setter Property="BoxShadow" Value="0 0 0 2 #C5F04A" />
    </Style>
    <Style Selector="Window.grafit ListBox.rail ListBoxItem:pointerover Border.thumb, Window.grafit ListBox.rail ListBoxItem.hover Border.thumb">
        <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Window.grafit ListBox.rail Border.dim">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.grafit ListBox.rail TextBlock.packname">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.grafit ListBox.rail StackPanel.packrow">
        <Setter Property="IsVisible" Value="True" />
    </Style>
</Styles>
