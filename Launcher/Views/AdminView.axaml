<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             xmlns:v="using:VuluLauncher.Views"
             x:Class="VuluLauncher.Views.AdminView"
             x:DataType="vm:AdminViewModel">
    <UserControl.Styles>
        <Style Selector="Button.sm">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.row.inactive"><Setter Property="Opacity" Value="0.6" /></Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Width" Value="290" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style Selector="Border.card.attention"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="RoleChipTemplate" x:DataType="vm:AdminRole">
            <Border BorderBrush="{Binding Brush}" BorderThickness="1" Padding="7,1" Margin="0,4,6,0">
                <TextBlock Text="{Binding Name}" Foreground="{Binding Brush}" FontSize="11.5" FontWeight="SemiBold" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="28,22,28,0">
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,14">
            <TextBlock Text="Admin paneli" Classes="page-title" />
            <ItemsControl Classes="segmented" ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Choice">
                        <Button Classes="seg" Classes.active="{Binding IsSelected}" Content="{Binding Label}"
                                Command="{Binding $parent[UserControl].((vm:AdminViewModel)DataContext).SelectTabCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Status}" Classes="dim" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <ScrollViewer>
            <Panel Margin="0,0,0,28">
                <WrapPanel IsVisible="{Binding ShowOverviewSkeleton}" VerticalAlignment="Top">
                    <v:Skeleton Width="290" Height="130" Margin="0,0,12,12" />
                    <v:Skeleton Width="290" Height="130" Margin="0,0,12,12" />
                    <v:Skeleton Width="290" Height="130" Margin="0,0,12,12" />
                </WrapPanel>
                <!-- Özet -->
                <ItemsControl ItemsSource="{Binding Cards}" IsVisible="{Binding IsOverview}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AdminCard">
                            <Border Classes="card" Classes.attention="{Binding Attention}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Title}" Classes="dim" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Sub}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                                    <Button Classes="sm" Content="{Binding ActionText}" IsVisible="{Binding HasAction}" Command="{Binding Run}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Kullanıcılar -->
                <StackPanel IsVisible="{Binding IsUsers}" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Summary}" Classes="dim" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="sm primary" Content="+ Kullanıcı ekle" Command="{Binding AddUserCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AdminUserRow">
                                <Border Classes="row" Classes.inactive="{Binding !IsActive}">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Username}" FontWeight="Bold" />
                                                <TextBlock Text="admin" IsVisible="{Binding IsAdmin}" Foreground="{StaticResource Accent}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                <TextBlock Text="pasif" IsVisible="{Binding !IsActive}" Classes="dim" FontSize="11.5" VerticalAlignment="Center" />
                                                <TextBlock Text="sen" IsVisible="{Binding IsSelf}" Classes="dim" FontSize="11.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12" />
                                            <ItemsControl ItemsSource="{Binding Roles}" ItemTemplate="{StaticResource RoleChipTemplate}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="sm" Content="Düzenle" Command="{Binding EditCommand}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Button Grid.Column="2" Classes="sm danger" Content="Sil" IsEnabled="{Binding !IsSelf}" Command="{Binding DeleteCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Roller -->
                <StackPanel IsVisible="{Binding IsRoles}" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Summary}" Classes="dim" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="sm primary" Content="+ Rol ekle" Command="{Binding AddRoleCommand}" />
                    </Grid>
                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap"
                               Text="Rol verdiğin kişiler o role açılan paketleri görür. Paylaşırken &quot;Kimler erişebilir&quot; kısmında rol seçilmeyen paket herkese açıktır; adminler her paketi görür." />
                    <ItemsControl ItemsSource="{Binding Roles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AdminRole">
                                <Border Classes="row">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RoleChipTemplate}" HorizontalAlignment="Left" />
                                            <TextBlock Classes="dim" FontSize="12"><Run Text="{Binding Members}" /><Run Text=" kişi · " /><Run Text="{Binding Packs}" /><Run Text=" paket" /></TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="sm" Content="Düzenle" VerticalAlignment="Center" Margin="0,0,6,0"
                                                Command="{Binding $parent[UserControl].((vm:AdminViewModel)DataContext).EditRoleCommand}" CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Classes="sm danger" Content="Sil" VerticalAlignment="Center"
                                                Command="{Binding $parent[UserControl].((vm:AdminViewModel)DataContext).DeleteRoleCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Kayıt istekleri -->
                <StackPanel IsVisible="{Binding IsRegistrations}" Spacing="10">
                    <Border Classes="row" IsVisible="{Binding HasSettings}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Hesaplar e-posta doğrulanınca açılsın" FontWeight="Bold" />
                                <TextBlock Text="Kapalıyken her kayıt isteği burada bir adminin onayını bekler." Classes="dim" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoApprove}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="row" IsVisible="{Binding HasSettings}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Oynamak için Minecraft sahipliği zorunlu" FontWeight="Bold" />
                                <TextBlock Text="Açıkken oyun yalnızca Microsoft hesabını bağlamış kişilerle açılır (Ayarlar → Hesap). Halka açılışta açılmalı; Microsoft girişi etkin olmadan açma." Classes="dim" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding RequireOwnership}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Summary}" Classes="dim" />
                    <StackPanel IsVisible="{Binding NoRegistrations}" Spacing="4">
                        <TextBlock Text="Bekleyen kayıt isteği yok" FontWeight="Bold" />
                        <TextBlock Text="Biri giriş ekranından kayıt olduğunda burada görünür." Classes="dim" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Registrations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RegistrationRow">
                                <Border Classes="row">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Username}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="sm primary" Content="Kabul et" IsEnabled="{Binding Verified}" Command="{Binding ApproveCommand}"
                                                ToolTip.Tip="Bu kişi e-posta adresini doğrulayınca kabul edebilirsin." VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Button Grid.Column="2" Classes="sm danger" Content="Reddet" IsEnabled="{Binding !Busy}" Command="{Binding RejectCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Duyuru -->
                <StackPanel IsVisible="{Binding IsAnnouncement}" Spacing="10" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Classes="dim" Text="Duyuru herkesin launcher'ında, Oyna sayfasının üstünde görünür. Yeni duyuru eskisinin yerine geçer." TextWrapping="Wrap" />
                    <TextBox Text="{Binding AnnouncementText}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" MaxLength="500"
                             Watermark="Örneğin: Bu akşam 21:00'de AGLR SMP'de etkinlik var!" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Ne kadar kalsın:" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding Duration}" MinWidth="170" />
                        <Button Classes="primary" Content="Yayınla" Command="{Binding PublishAnnouncementCommand}" />
                        <TextBlock Text="{Binding AnnouncementNote}" Foreground="{StaticResource Error}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Classes="row" IsVisible="{Binding CurrentAnnouncement, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,10,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding CurrentAnnouncementMeta}" Classes="dim" FontSize="12" />
                            <TextBlock Text="{Binding CurrentAnnouncement}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <Button Classes="sm danger" Content="Kaldır" Command="{Binding RemoveAnnouncementCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Şu an yayında bir duyuru yok." Classes="dim" IsVisible="{Binding CurrentAnnouncement, Converter={x:Static ObjectConverters.IsNull}}" />
                </StackPanel>

                <!-- Radyo -->
                <StackPanel IsVisible="{Binding IsRadio}" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding RadioUsage}" Classes="dim" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="sm primary" Content="{Binding UploadText}" Command="{Binding UploadSongCommand}" />
                    </Grid>
                    <TextBlock Text="Sunucuda şarkı klasörü henüz ayarlı değil; yükleme yapılamaz (RADIO_DIR)." IsVisible="{Binding !RadioReady}" Foreground="{StaticResource Error}" />
                    <TextBlock Text="{Binding RadioNote}" IsVisible="{Binding RadioNote, Converter={x:Static ObjectConverters.IsNotNull}}" Foreground="{StaticResource Error}" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding RadioFraction}" Maximum="1" />
                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap"
                               Text="MP3, OGG ya da M4A; en fazla 30 MB. Dosya adı &quot;Sanatçı - Şarkı&quot; ise ikisi otomatik ayrılır. Yalnızca hakkına sahip olduğun ya da telifsiz şarkıları yükle — buradaki şarkılar bütün üyelere dağıtılır." />
                    <ItemsControl ItemsSource="{Binding Songs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SongRow">
                                <Border Classes="row">
                                    <Grid ColumnDefinitions="*,*,Auto,Auto">
                                        <TextBox Text="{Binding Title}" Watermark="Şarkı adı" MaxLength="100" Classes="song" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="1" Text="{Binding Artist}" Watermark="Sanatçı" MaxLength="100" Classes="song" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="dim" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Grid.Column="3" Classes="sm danger" Content="Sil" Command="{Binding DeleteCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- İlerleme: sezonlar, görevler (başarımlar), seviye ve XP, haftalık liderlik -->
                <StackPanel IsVisible="{Binding IsProgress}" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Text="Buradaki her şey vulu sunucusunun istatistiklerinden hesaplanır. Değişiklikler &quot;Kaydet&quot;e basınca geçerli olur; oyuncuların ilerlemesi en çok 5 dakika içinde yeni ayarla güncellenir." />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="sm" Content="Geri al" Command="{Binding ReloadProgressCommand}" ToolTip.Tip="Kaydedilmemiş değişiklikleri at" />
                            <Button Classes="sm primary" Content="Kaydet" Command="{Binding SaveProgressCommand}" IsEnabled="{Binding !ProgressSaving}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ProgressNote}" TextWrapping="Wrap" IsVisible="{Binding ProgressNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Classes.ok="{Binding ProgressOk}" Classes.err="{Binding !ProgressOk}">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{StaticResource Ok}" /></Style>
                            <Style Selector="TextBlock.err"><Setter Property="Foreground" Value="{StaticResource Error}" /></Style>
                        </TextBlock.Styles>
                    </TextBlock>

                    <!-- Sezonlar -->
                    <Border Classes="row" Padding="16">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Sezonlar" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="sm" Content="+ Sezon ekle" Command="{Binding AddSeasonCommand}" />
                            </Grid>
                            <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                                       Text="Aynı anda tek sezon sürer; tarihler çakışamaz. Her görev bir rozet verir. Bütün görevleri bitiren ya da sezon seviyesine ulaşan sezon pelerinini alır (seviye 0: yalnızca görevlerle)." />
                            <ItemsControl ItemsSource="{Binding Seasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SeasonEdit">
                                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="2" Command="{Binding ToggleCommand}">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                                    </Button>
                                                    <Button Grid.Column="1" Classes="sm danger" Content="Sezonu sil" Command="{Binding RemoveCommand}" />
                                                </Grid>
                                                <StackPanel Spacing="10" IsVisible="{Binding IsOpen}">
                                                    <WrapPanel>
                                                        <StackPanel Spacing="4" Margin="0,0,12,8" Width="200">
                                                            <TextBlock Text="Adı" Classes="label" />
                                                            <TextBox Text="{Binding Name}" MaxLength="40" />
                                                        </StackPanel>
                                                        <StackPanel Spacing="4" Margin="0,0,12,8" Width="110">
                                                            <TextBlock Text="Anahtar" Classes="label" />
                                                            <TextBox Text="{Binding Key}" MaxLength="32" ToolTip.Tip="Küçük harf, rakam, tire (ör. s2). Kaydettikten sonra değiştirme: oyuncuların sezon ilerlemesi buna bağlı." />
                                                        </StackPanel>
                                                        <StackPanel Spacing="4" Margin="0,0,12,8">
                                                            <TextBlock Text="Başlangıç" Classes="label" />
                                                            <CalendarDatePicker SelectedDate="{Binding Start}" Width="150" />
                                                        </StackPanel>
                                                        <StackPanel Spacing="4" Margin="0,0,12,8">
                                                            <TextBlock Text="Bitiş" Classes="label" />
                                                            <CalendarDatePicker SelectedDate="{Binding End}" Width="150" />
                                                        </StackPanel>
                                                        <StackPanel Spacing="4" Margin="0,0,12,8">
                                                            <TextBlock Text="Sezon pelerini" Classes="label" />
                                                            <ComboBox ItemsSource="{Binding Capes}" SelectedItem="{Binding Cape}" Width="190">
                                                                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Option"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Spacing="4" Margin="0,0,12,8">
                                                            <TextBlock Text="Pelerin için sezon seviyesi" Classes="label" />
                                                            <NumericUpDown Value="{Binding CapeLevel}" Minimum="0" Maximum="1000" Increment="1" FormatString="0" Width="150" />
                                                        </StackPanel>
                                                    </WrapPanel>

                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="Görevler" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Classes="sm" Content="+ Görev ekle" Command="{Binding AddQuestCommand}" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="54,170,*,190,100,Auto" Margin="0,0,0,-4">
                                                        <TextBlock Text="Simge" Classes="label" />
                                                        <TextBlock Grid.Column="1" Text="Adı" Classes="label" />
                                                        <TextBlock Grid.Column="2" Text="Açıklama" Classes="label" />
                                                        <TextBlock Grid.Column="3" Text="Sayılan" Classes="label" />
                                                        <TextBlock Grid.Column="4" Text="Hedef" Classes="label" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Quests}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:QuestEdit">
                                                                <Grid ColumnDefinitions="54,170,*,190,100,Auto" Margin="0,0,0,6">
                                                                    <TextBox Text="{Binding Icon}" MaxLength="4" Margin="0,0,6,0" HorizontalContentAlignment="Center" />
                                                                    <TextBox Grid.Column="1" Text="{Binding Name}" MaxLength="40" Margin="0,0,6,0" />
                                                                    <TextBox Grid.Column="2" Text="{Binding Desc}" MaxLength="120" Margin="0,0,6,0" PlaceholderText="Oyuncunun göreceği açıklama" />
                                                                    <ComboBox Grid.Column="3" ItemsSource="{Binding Stats}" SelectedItem="{Binding Stat}" HorizontalAlignment="Stretch" Margin="0,0,6,0">
                                                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Option"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <NumericUpDown Grid.Column="4" Value="{Binding Target}" Minimum="0" Maximum="1000000000" Increment="1" ShowButtonSpinner="False" Margin="0,0,6,0" />
                                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                                                                        <Button Classes="sm" Content="↑" Command="{Binding MoveUpCommand}" ToolTip.Tip="Yukarı taşı" />
                                                                        <Button Classes="sm danger" Content="Sil" Command="{Binding RemoveCommand}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Seviye ve XP -->
                    <Border Classes="row" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Seviye ve XP" FontSize="16" FontWeight="Bold" />
                            <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                                       Text="Oyuncu sunucuda oynadıkça XP kazanır. L. seviye için toplam (katsayı × L × (L+1)) XP gerekir; katsayı büyüdükçe seviyeler yavaşlar. Sezon seviyesi aynı eğriyle, yalnızca sezon başından beri kazanılan XP'den hesaplanır." />
                            <WrapPanel>
                                <StackPanel Spacing="4" Margin="0,0,12,8"><TextBlock Text="Seviye katsayısı" Classes="label" /><NumericUpDown Value="{Binding LevelBase}" Minimum="5" Maximum="10000" Increment="5" Width="150" /></StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,12,8"><TextBlock Text="Oynanan dakika başına" Classes="label" /><NumericUpDown Value="{Binding XpMinute}" Minimum="0" Maximum="100000" Increment="1" Width="150" /></StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,12,8"><TextBlock Text="Elmas başına" Classes="label" /><NumericUpDown Value="{Binding XpDiamond}" Minimum="0" Maximum="100000" Increment="1" Width="150" /></StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,12,8"><TextBlock Text="Başarım başına" Classes="label" /><NumericUpDown Value="{Binding XpAdvancement}" Minimum="0" Maximum="100000" Increment="1" Width="150" /></StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,12,8"><TextBlock Text="Gidilen km başına" Classes="label" /><NumericUpDown Value="{Binding XpKm}" Minimum="0" Maximum="100000" Increment="1" Width="150" /></StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,12,8"><TextBlock Text="10 yaratık başına" Classes="label" /><NumericUpDown Value="{Binding XpMobs10}" Minimum="0" Maximum="100000" Increment="1" Width="150" /></StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding LevelPreview}" Classes="muted" FontSize="12" FontFamily="{StaticResource Mono}" />
                        </StackPanel>
                    </Border>

                    <!-- Haftalık liderlik -->
                    <Border Classes="row" Padding="16">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Haftalık liderlik" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding WeeklyEnabled}" Content="Birincilere ödül ver" />
                            </Grid>
                            <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                                       Text="Tablo her pazartesi 00:00'da (Türkiye saati) sıfırlanır. Her açık dalın birincisi o dalın rozetini ve seçilen pelerini alır. Kapalı dallar tabloda görünmez." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Birincilerin pelerini" Classes="label" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding CapeOptions}" SelectedItem="{Binding WeeklyCape}" Width="200">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Option"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Grid ColumnDefinitions="70,54,*,*" Margin="0,0,0,-4">
                                <TextBlock Text="Açık" Classes="label" />
                                <TextBlock Grid.Column="1" Text="Simge" Classes="label" />
                                <TextBlock Grid.Column="2" Text="Dalın adı" Classes="label" />
                                <TextBlock Grid.Column="3" Text="Rozetin adı" Classes="label" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Weekly}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WeeklyEdit">
                                        <Grid ColumnDefinitions="70,54,*,*" Margin="0,0,0,6">
                                            <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding Icon}" MaxLength="4" Margin="0,0,6,0" HorizontalContentAlignment="Center" />
                                            <TextBox Grid.Column="2" Text="{Binding Name}" MaxLength="40" Margin="0,0,6,0" />
                                            <TextBox Grid.Column="3" Text="{Binding BadgeName}" MaxLength="40" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Pelerinler: katalog, düzenleyici, önizleme, sahipler -->
                <Grid IsVisible="{Binding IsCapes}" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Text="Pelerinler satılmaz; sezon görevleri, haftalık liderlik ve etkinliklerle verilir. Düzenlemek için bir pelerine tıkla." />
                            <Button Grid.Column="1" Classes="sm primary" Content="+ Yeni pelerin" Command="{Binding NewCapeCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CapeRows}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CapeRow">
                                    <Button Classes="flat" Padding="0" Margin="0,0,10,10" Command="{Binding EditCommand}" ToolTip.Tip="{Binding Earn}">
                                        <Border Width="128" Background="{StaticResource Card}" BorderThickness="2" BorderBrush="{StaticResource Line}" Padding="8"
                                                Classes.sel="{Binding IsSelected}">
                                            <Border.Styles>
                                                <Style Selector="Border.sel"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Style>
                                            </Border.Styles>
                                            <StackPanel Spacing="4">
                                                <Image Source="{Binding Preview}" Width="40" Height="64" RenderOptions.BitmapInterpolationMode="None" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Düzenleyici -->
                    <Border Grid.Column="1" Width="470" Margin="14,0,0,0" IsVisible="{Binding CapeEditing}" Classes="row" Padding="16" VerticalAlignment="Top">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding EditorTitle}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Classes="sm" Content="Kapat" Command="{Binding CloseCapeEditorCommand}" />
                            </Grid>

                            <!-- Önizleme: düz yüz ve kendi skininle 3B -->
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="96" Height="150" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <Image Source="{Binding CapeFace}" Width="80" Height="128" RenderOptions.BitmapInterpolationMode="None" />
                                </Border>
                                <Border Grid.Column="1" Height="150" Margin="10,0,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <v:SkinViewer3D Skin="{Binding MySkinBytes}" Slim="{Binding MySkinSlim}" Cape="{Binding CapePreviewBytes}" Margin="4"
                                                    ToolTip.Tip="Senin skininle; sürükleyerek çevir" />
                                </Border>
                            </Grid>

                            <WrapPanel>
                                <StackPanel Spacing="4" Margin="0,0,10,8" Width="200">
                                    <TextBlock Text="Adı" Classes="label" />
                                    <TextBox Text="{Binding CapeName}" MaxLength="40" />
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,10,8" Width="150">
                                    <TextBlock Text="Anahtar" Classes="label" />
                                    <TextBox Text="{Binding CapeKey}" MaxLength="32" IsEnabled="{Binding CapeIsNew}" PlaceholderText="addan üretilir"
                                             ToolTip.Tip="Küçük harf, rakam, tire. Oyuncularda bu anahtarla saklanır; sonradan değişmez." />
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,0,8" Width="70">
                                    <TextBlock Text="Sıra" Classes="label" />
                                    <NumericUpDown Value="{Binding CapeOrder}" Minimum="0" Maximum="9999" Increment="1" ShowButtonSpinner="False" FormatString="0" />
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Nasıl kazanılır (oyuncular görür)" Classes="label" />
                                <TextBox Text="{Binding CapeEarn}" MaxLength="160" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding CapeAdminOnly}" Content="Adminlere özel (yalnızca adminler takar, başkasına verilemez)" />

                            <TextBlock Text="Doku" Classes="label" />
                            <Border Classes="segmented" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="seg" Classes.active="{Binding IsDesign}" Content="Desen" Command="{Binding SetCapeSourceCommand}" CommandParameter="design" />
                                    <Button Classes="seg" Classes.active="{Binding IsArt}" Content="Hazır çizim" Command="{Binding SetCapeSourceCommand}" CommandParameter="art" />
                                    <Button Classes="seg" Classes.active="{Binding IsPng}" Content="PNG yükle" Command="{Binding PickCapePngCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Desen: renkler ve amblem -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsDesign}">
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Text="Zemin" Classes="label" VerticalAlignment="Center" Margin="0,0,8,6" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
                                        <Border Width="22" Height="22" Background="{Binding BaseBrush}" BorderBrush="{StaticResource Line}" BorderThickness="1" />
                                        <TextBox Text="{Binding ColorBase}" MaxLength="7" Width="90" FontFamily="{StaticResource Mono}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="Kenar" Classes="label" VerticalAlignment="Center" Margin="0,0,8,6" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                        <Border Width="22" Height="22" Background="{Binding EdgeBrush}" BorderBrush="{StaticResource Line}" BorderThickness="1" />
                                        <TextBox Text="{Binding ColorEdge}" MaxLength="7" Width="90" FontFamily="{StaticResource Mono}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Amblem" Classes="label" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,14,0">
                                        <Border Width="22" Height="22" Background="{Binding InkBrush}" BorderBrush="{StaticResource Line}" BorderThickness="1" />
                                        <TextBox Text="{Binding ColorInk}" MaxLength="7" Width="90" FontFamily="{StaticResource Mono}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="2. renk" Classes="label" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                        <Border Width="22" Height="22" Background="{Binding Ink2Brush}" BorderBrush="{StaticResource Line}" BorderThickness="1" />
                                        <TextBox Text="{Binding ColorInk2}" MaxLength="7" Width="90" FontFamily="{StaticResource Mono}" />
                                    </StackPanel>
                                </Grid>
                                <!-- Tema renkleri: tek tıkla zemin/kenar/amblem -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Tema renkleri" Classes="dim" FontSize="11.5" VerticalAlignment="Center" />
                                    <Button Classes="sm" Content="Meşale" Command="{Binding UseThemeCommand}" CommandParameter="mesale" />
                                    <Button Classes="sm" Content="Ufuk" Command="{Binding UseThemeCommand}" CommandParameter="ufuk" />
                                    <Button Classes="sm" Content="Derin" Command="{Binding UseThemeCommand}" CommandParameter="derin" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Amblem" Classes="label" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding Emblems}" SelectedItem="{Binding Emblem}" Width="200">
                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Option"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Hazır çizim -->
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsArt}">
                                <TextBlock Text="Çizim" Classes="label" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Arts}" SelectedItem="{Binding Art}" Width="220">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:Option"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- PNG -->
                            <TextBlock IsVisible="{Binding PngName, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="dim" FontSize="12" TextWrapping="Wrap">
                                <Run Text="Doku dosyası: " /><Run Text="{Binding PngName}" /><Run Text=" · 64×32 Minecraft pelerin dokusu (pelerin + elytra)." />
                            </TextBlock>

                            <TextBlock Text="{Binding CapeNote}" TextWrapping="Wrap" FontSize="12.5" IsVisible="{Binding CapeNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Classes.ok="{Binding CapeOk}" Classes.err="{Binding !CapeOk}">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{StaticResource Ok}" /></Style>
                                    <Style Selector="TextBlock.err"><Setter Property="Foreground" Value="{StaticResource Error}" /></Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="sm primary" Content="Kaydet" Command="{Binding SaveCapeCommand}" />
                                <Button Classes="sm danger" Content="Pelerini sil" Command="{Binding DeleteCapeCommand}" IsVisible="{Binding CanDeleteCape}" />
                            </StackPanel>

                            <!-- Sahipler -->
                            <StackPanel Spacing="6" IsVisible="{Binding ShowOwners}" Margin="0,6,0,0">
                                <TextBlock Text="Sahipler" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding OwnersTitle}" Classes="dim" FontSize="12" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding GrantUsername}" PlaceholderText="Kullanıcı adı" MaxLength="16" />
                                    <Button Grid.Column="1" Classes="sm" Content="Ver" Margin="6,0,0,0" Command="{Binding GrantCapeToOwnerCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding CapeOwners}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CapeOwner">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="sm danger" Content="Geri al" Command="{Binding RevokeCommand}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Alan -->
                <StackPanel IsVisible="{Binding IsStorage}" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding StorageTotal}" FontWeight="Bold" />
                    <TextBlock Text="{Binding StorageWarning}" IsVisible="{Binding StorageWarning, Converter={x:Static ObjectConverters.IsNotNull}}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding StorageParts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StoragePart">
                                <Grid ColumnDefinitions="14,*,240,90" Margin="0,0,0,8">
                                    <Border Width="10" Height="10" Background="{Binding Brush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="6,0" />
                                    <ProgressBar Grid.Column="2" Value="{Binding Fraction}" Maximum="1" Foreground="{Binding Brush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Size}" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="dim" FontSize="12.5" Text="Ekran görüntüleri kendi sınırına (varsayılan 150 MB) ulaşınca en eskileri otomatik silinir." />
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
