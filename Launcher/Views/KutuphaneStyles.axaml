<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:VuluLauncher.Views"
        x:Class="VuluLauncher.Views.KutuphaneStyles">
    <!--
        "Kütüphane" teması. Renkler vulu'nun (Meşale paleti: koyu kahve zemin, amber vurgu), iskelet bambaşka:
          • başlık çubuğunda sekme ve logo yok; yerinde geniş arama kutusu, sağda bildirim ve pencere düğmeleri
          • sekmeler, radyo ve profil soldaki simge rayında (MainWindow.axaml Rail)
          • Oyna sayfası kapak ızgarası + sağda seçili paketin çekmecesi (LibraryView)
          • her yüzey yuvarlak köşeli, 1 px çizgili kart; ışıltı yok
        Hep yüklüdür; pencere "kutuphane" sınıfını taşıdığında geçerli olur (Services/Themes.cs).
    -->

    <!-- ── İskelet ── -->
    <!-- Varsayılan: gizli (öbür temalarda); Kütüphane'de görünür. Yerel IsVisible stili ezeceği için burada. -->
    <Style Selector="Border#Rail, Border#SearchPillHost">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.kutuphane Border#Rail">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Window.kutuphane Border#TitleBar, Window.kutuphane Border#TitleBar.overlay">
        <Setter Property="Margin" Value="84,0,0,0" />
        <Setter Property="Background" Value="#0B0A09" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Window.kutuphane StackPanel#TitleLogo, Window.kutuphane Border#TabsHost, Window.kutuphane Border#SearchIconHost, Window.kutuphane Border#ProfileHost">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.kutuphane Border#SearchPillHost">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Window.kutuphane Button.search-pill">
        <Setter Property="Width" Value="380" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="#14100C" />
        <Setter Property="BorderBrush" Value="#2A2118" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Window.kutuphane Button.search-pill /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Window.kutuphane Button.search-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1B1510" />
        <Setter Property="BorderBrush" Value="#4A3A28" />
    </Style>
    <Style Selector="Window.kutuphane Button.search-pill Path.icon">
        <Setter Property="Stroke" Value="#A1958A" />
    </Style>

    <!-- ── Simge rayı ── -->
    <Style Selector="Button.rail-tab">
        <Setter Property="Width" Value="66" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Foreground" Value="#A1958A" />
    </Style>
    <Style Selector="Button.rail-tab /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.rail-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#17120D" />
        <Setter Property="Foreground" Value="#F3ECE2" />
    </Style>
    <Style Selector="Button.rail-tab.active, Button.rail-tab.glow">
        <Setter Property="Background" Value="#2A1E10" />
        <Setter Property="Foreground" Value="#FFC873" />
    </Style>
    <Style Selector="Button.rail-tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#33240F" />
        <Setter Property="Foreground" Value="#FFC873" />
    </Style>
    <Style Selector="Button.rail-tab Path.tab-icon">
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>
    <Style Selector="Button.rail-tab TextBlock">
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button.rail-btn">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="#14100C" />
        <Setter Property="BorderBrush" Value="#2E241A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rail-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.rail-btn Path.icon">
        <Setter Property="Stroke" Value="#FFC873" />
    </Style>
    <Style Selector="Button.rail-avatar">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>
    <Style Selector="Button.rail-avatar /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="22" />
    </Style>
    <Style Selector="Button.rail-avatar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BoxShadow" Value="0 0 0 2 #F2A33A" />
    </Style>

    <!-- ── Kartlar: yuvarlak köşe, ince sıcak çizgi, gölge yok ── -->
    <Style Selector="Window.kutuphane Border.card, Window.kutuphane Border.row-card, Window.kutuphane Border.mcard">
        <Setter Property="Background" Value="#14100C" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#2A2118" />
        <Setter Property="BoxShadow" Value="none" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Window.kutuphane Border.card:pointerover, Window.kutuphane Border.row-card:pointerover, Window.kutuphane Border.lift.hover">
        <Setter Property="BorderBrush" Value="#4A3A28" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Window.kutuphane v|SettingsView Border.section">
        <Setter Property="Background" Value="#14100C" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#2A2118" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Window.kutuphane Border.toast-card">
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Window.kutuphane Border.modal-box">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BorderBrush" Value="#3A2D20" />
        <Setter Property="BoxShadow" Value="0 24 60 0 #CC000000" />
    </Style>
    <Style Selector="Window.kutuphane Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Window.kutuphane TextBlock.page-title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.6" />
    </Style>
</Styles>
