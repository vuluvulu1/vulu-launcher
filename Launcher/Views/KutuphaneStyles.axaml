<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:VuluLauncher.Views"
        x:Class="VuluLauncher.Views.KutuphaneStyles">
    <!--
        "Kütüphane" teması. Renkler vulu'nun (Meşale paleti: koyu kahve zemin, amber vurgu), iskelet bambaşka:
          • başlık çubuğunda sekme ve logo yok; yerinde geniş arama kutusu, sağda bildirim ve pencere düğmeleri
          • sekmeler soldaki ince simge rayında (MainWindow.axaml Rail), Ayarlar rayın altında; radyo ve profil başlık çubuğunda
          • Oyna sayfası kapak ızgarası + sağda seçili paketin çekmecesi (LibraryView)
          • her yüzey yuvarlak köşeli, 1 px çizgili kart; ışıltı yok
        Hep yüklüdür; pencere "kutuphane" sınıfını taşıdığında geçerli olur (Services/Themes.cs). Yuvarlak düğme, kutu
        ve kart kuralları Meşale ile ortak: Views/SoftStyles.axaml.
    -->

    <!-- ── İskelet ── -->
    <!-- Varsayılan: gizli (öbür temalarda); Kütüphane'de görünür. Yerel IsVisible stili ezeceği için burada. -->
    <Style Selector="Border#Rail, Border#SearchPillHost">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Arama kutusunun yeri stilde (Meşale onu pencerenin ortasına alır; yerel değer olsaydı değiştiremezdi) -->
    <Style Selector="Border#SearchPillHost">
        <Setter Property="Grid.Column" Value="1" />
    </Style>
    <Style Selector="Window.kutuphane Border#Rail">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Başlık çubuğu tam genişlik (sol üst köşe boş kalmasın); logo köşede, ray çubuğun altından başlar -->
    <Style Selector="Window.kutuphane Border#TitleBar, Window.kutuphane Border#TitleBar.overlay">
        <Setter Property="Margin" Value="0" />
        <!-- Yarı saydam: arkadaki ortam rengi çubuğa da hafifçe vursun -->
        <Setter Property="Background" Value="#B3090807" />
        <Setter Property="BorderBrush" Value="{StaticResource RailLine}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Window.kutuphane Border#TabsHost, Window.kutuphane Border#SearchIconHost, Window.kutuphane Border#SettingsIconHost, Window.kutuphane Border#ProfileHost">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.kutuphane Border#SearchPillHost">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Arama kutusunun görünümü ortak (SoftStyles); Kütüphane'de geniş, başlık çubuğunun solunda -->
    <Style Selector="Window.kutuphane Button.search-pill">
        <Setter Property="Width" Value="380" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="28,0,0,0" />
    </Style>

    <!-- Sosyal, Sunucular ve Profil'in yan panelleri: kenara yapışık şerit yerine yüzen yuvarlak kart -->
    <Style Selector="Window.kutuphane Border.side">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Window.kutuphane Border.side-left">
        <Setter Property="Margin" Value="14,6,0,16" />
    </Style>
    <Style Selector="Window.kutuphane Border.side-right">
        <Setter Property="Margin" Value="0,22,20,20" />
    </Style>
    <!-- Admin paneli: başlık ve sekmeler tek satırda, öbür Kütüphane sayfalarıyla aynı üst boşluk -->
    <Style Selector="Window.kutuphane StackPanel#AdminTitleRow">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="16" />
    </Style>
    <Style Selector="Window.kutuphane DockPanel#AdminRoot">
        <Setter Property="Margin" Value="28,14,20,0" />
    </Style>
    <!-- Profil: içerik ortalanmış dar sütun yerine öbür sayfalar gibi sol kenardan yan panele kadar -->
    <Style Selector="Window.kutuphane StackPanel.profile-body, Window.kutuphane Border.profile-body">
        <Setter Property="MaxWidth" Value="100000" />
    </Style>
    <!-- Sosyal › Liderlik / Harita: sekme adı zaten üstte; büyük başlık tekrarlanmaz -->
    <Style Selector="Window.kutuphane v|WorldView TextBlock.page-title">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Logo simgesi rayın simgeleriyle aynı dikey çizgide (ray 56 genişliğinde, simge 20) -->
    <Style Selector="Window.kutuphane StackPanel#TitleLogo">
        <Setter Property="Margin" Value="18,0,14,0" />
    </Style>

    <!-- Sosyal: Akış/Liderlik/Harita üstteki sekmelerde; listedeki satırları gizlenir -->
    <Style Selector="Window.kutuphane Button.navlink">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ── Simge rayı ── -->
    <Style Selector="Button.rail-tab">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Dim}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.rail-tab /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <!-- Zemin yok: üstüne gelince yalnızca simge aydınlanır (simgenin rengi düğmenin Foreground'undan gelir) -->
    <Style Selector="Button.rail-tab:pointerover:not(.active)">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    </Style>
    <Style Selector="Button.rail-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    </Style>
    <Style Selector="Button.rail-tab /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /><BrushTransition Property="Foreground" Duration="0:0:0.2" /></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.rail-tab.glow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
    </Style>
    <!-- Seçili sekmenin zemini kayan işaretten gelir (MainWindow RailMark); düğmenin kendisi saydam kalır -->
    <!-- Seçili: simge amber; işaret soldaki amber hap ve arkasındaki ışık (MainWindow RailMark) -->
    <Style Selector="Button.rail-tab.active">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
    </Style>
    <Style Selector="Button.rail-tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
    </Style>
    <Style Selector="Button.rail-tab:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <!-- Üstüne gelince simge hafifçe büyür -->
    <Style Selector="Button.rail-tab Path.tab-icon">
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" /></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.rail-tab:pointerover Path.tab-icon">
        <Setter Property="RenderTransform" Value="scale(1.12)" />
    </Style>
    <Style Selector="Button.rail-tab Path.tab-icon">
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>
    <Style Selector="Button.rail-tab TextBlock">
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button.rail-btn">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rail-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.rail-btn Path.icon">
        <Setter Property="Stroke" Value="{StaticResource AccentHi}" />
    </Style>
    <Style Selector="Button.rail-avatar">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>
    <Style Selector="Button.rail-avatar /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="22" />
    </Style>
    <!-- Üstüne gelince: düğmenin çevresinde halka yok; resim hafifçe büyür, çerçevesi amber tona döner -->
    <Style Selector="Button.rail-avatar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.rail-avatar:pressed">
        <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.rail-avatar Panel.avatar-wrap">
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" /></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.rail-avatar:pointerover Panel.avatar-wrap, Button.rail-avatar.hover Panel.avatar-wrap">
        <Setter Property="RenderTransform" Value="scale(1.07)" />
    </Style>
    <Style Selector="Button.rail-avatar:pressed Panel.avatar-wrap">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button.rail-avatar Border.avatar">
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.18" /></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.rail-avatar:pointerover Border.avatar, Button.rail-avatar.hover Border.avatar">
        <Setter Property="BorderBrush" Value="#B3F2A33A" />
    </Style>

    <!-- ── Kartlar: yuvarlak köşe, ince sıcak çizgi, gölge yok ── -->
    <Style Selector="Window.kutuphane Border.card, Window.kutuphane Border.row-card, Window.kutuphane Border.mcard">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource CardLine}" />
        <Setter Property="BoxShadow" Value="none" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Window.kutuphane Border.card:pointerover, Window.kutuphane Border.row-card:pointerover, Window.kutuphane Border.lift.hover">
        <Setter Property="BorderBrush" Value="{StaticResource CardLineStrong}" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Window.kutuphane v|SettingsView Border.section">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource CardLine}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Window.kutuphane TextBlock.page-title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.6" />
    </Style>
</Styles>
