<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:VuluLauncher.Views"
        x:Class="VuluLauncher.Views.KutuphaneStyles">
    <!--
        "Kütüphane" teması. Renkler vulu'nun (Meşale paleti: koyu kahve zemin, amber vurgu), iskelet bambaşka:
          • başlık çubuğunda sekme ve logo yok; yerinde geniş arama kutusu, sağda bildirim ve pencere düğmeleri
          • sekmeler soldaki ince simge rayında (MainWindow.axaml Rail), Ayarlar rayın altında; radyo ve profil başlık çubuğunda
          • Oyna sayfası kapak ızgarası + sağda seçili paketin çekmecesi (LibraryView)
          • her yüzey yuvarlak köşeli, 1 px çizgili kart; ışıltı yok
        Hep yüklüdür; pencere "kutuphane" sınıfını taşıdığında geçerli olur (Services/Themes.cs).
    -->

    <!-- ── İskelet ── -->
    <!-- Varsayılan: gizli (öbür temalarda); Kütüphane'de görünür. Yerel IsVisible stili ezeceği için burada. -->
    <Style Selector="Border#Rail, Border#SearchPillHost">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.kutuphane Border#Rail">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Başlık çubuğundaki radyo: Grafit'te radyo Oyna'nın sol kartında durduğu için orada gizli (öbür temalarda görünür) -->
    <Style Selector="Window.grafit Border#RadioHost">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Başlık çubuğu tam genişlik (sol üst köşe boş kalmasın); logo köşede, ray çubuğun altından başlar -->
    <Style Selector="Window.kutuphane Border#TitleBar, Window.kutuphane Border#TitleBar.overlay">
        <Setter Property="Margin" Value="0" />
        <!-- Yarı saydam: arkadaki ortam rengi çubuğa da hafifçe vursun -->
        <Setter Property="Background" Value="#B3090807" />
        <Setter Property="BorderBrush" Value="{StaticResource RailLine}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Window.kutuphane Border#TabsHost, Window.kutuphane Border#SearchIconHost, Window.kutuphane Border#SettingsIconHost, Window.kutuphane Border#ProfileHost">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.kutuphane Border#SearchPillHost">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Window.kutuphane Button.search-pill">
        <Setter Property="Width" Value="380" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Window.kutuphane Button.search-pill /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Window.kutuphane Button.search-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardLineStrong}" />
    </Style>
    <Style Selector="Window.kutuphane Button.search-pill Path.icon">
        <Setter Property="Stroke" Value="{StaticResource Dim}" />
    </Style>

    <!-- ── Bütün sayfalar: düğmeler, kutular, seçenek grupları yuvarlak (Meşale'de köşeli) ── -->
    <Style Selector="Window.kutuphane Button">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Window.kutuphane TextBox">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlLine}" />
    </Style>
    <Style Selector="Window.kutuphane TextBox /template/ Border#PART_BorderElement">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Window.kutuphane TextBox:pointerover /template/ Border#PART_BorderElement, Window.kutuphane TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource Panel}" />
    </Style>
    <Style Selector="Window.kutuphane ComboBox">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Window.kutuphane ItemsControl.segmented">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardLine}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Window.kutuphane Border.segmented">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardLine}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Window.kutuphane Button.seg">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="30" />
    </Style>
    <Style Selector="Window.kutuphane Button.seg.active">
        <Setter Property="Background" Value="{StaticResource AccentTint}" />
        <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
    </Style>
    <Style Selector="Window.kutuphane Button.seg.active /template/ ContentPresenter#PART_ContentPresenter, Window.kutuphane Button.seg.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="none" />
        <Setter Property="Background" Value="{StaticResource AccentTint}" />
        <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
    </Style>
    <Style Selector="Window.kutuphane Button.seg.loose">
        <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Window.kutuphane Button.chip">
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Window.kutuphane Border.tag">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="Window.kutuphane Border.tag.accent, Window.kutuphane Border.tag.friends">
        <Setter Property="Background" Value="{StaticResource AccentTint}" />
    </Style>
    <Style Selector="Window.kutuphane Border.filters">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardLine}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Window.kutuphane Border.skel">
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Window.kutuphane Border.zoom">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Window.kutuphane Border.bubble">
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Window.kutuphane Border.bubble.mine">
        <Setter Property="Background" Value="{StaticResource AccentTintStrong}" />
    </Style>
    <Style Selector="Window.kutuphane Border.row">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Ayarlar ve Sosyal'in sol menüleri: soldaki çizgi yerine yuvarlak, amber yazılı seçili satır -->
    <Style Selector="Window.kutuphane Button.nav, Window.kutuphane Button.row">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Window.kutuphane Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter, Window.kutuphane Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverFill}" />
    </Style>
    <Style Selector="Window.kutuphane Button.nav.current, Window.kutuphane Button.row.active">
        <Setter Property="Background" Value="{StaticResource AccentTint}" />
        <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
    </Style>
    <Style Selector="Window.kutuphane Button.nav.current:pointerover /template/ ContentPresenter#PART_ContentPresenter, Window.kutuphane Button.row.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentTintHover}" />
        <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
    </Style>
    <Style Selector="Window.kutuphane Button.address">
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Window.kutuphane Border.section, Window.kutuphane Border.done, Window.kutuphane Border.locked, Window.kutuphane Border.worn">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Sosyal, Sunucular ve Profil'in yan panelleri: kenara yapışık şerit yerine yüzen yuvarlak kart -->
    <Style Selector="Window.kutuphane Border.side">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Window.kutuphane Border.side-left">
        <Setter Property="Margin" Value="14,6,0,16" />
    </Style>
    <Style Selector="Window.kutuphane Border.side-right">
        <Setter Property="Margin" Value="0,22,20,20" />
    </Style>
    <!-- Profil: içerik ortalanmış dar sütun yerine öbür sayfalar gibi sol kenardan yan panele kadar -->
    <Style Selector="Window.kutuphane StackPanel.profile-body, Window.kutuphane Border.profile-body">
        <Setter Property="MaxWidth" Value="100000" />
    </Style>
    <!-- Sosyal › Liderlik / Harita: sekme adı zaten üstte; büyük başlık tekrarlanmaz -->
    <Style Selector="Window.kutuphane v|WorldView TextBlock.page-title">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Logo simgesi rayın simgeleriyle aynı dikey çizgide (ray 56 genişliğinde, simge 20) -->
    <Style Selector="Window.kutuphane StackPanel#TitleLogo">
        <Setter Property="Margin" Value="18,0,14,0" />
    </Style>

    <!-- Sosyal: Akış/Liderlik/Harita üstteki sekmelerde; listedeki satırları gizlenir -->
    <Style Selector="Window.kutuphane Button.navlink">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ── Simge rayı ── -->
    <Style Selector="Button.rail-tab">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Dim}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.rail-tab /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <!-- Zemin yok: üstüne gelince yalnızca simge aydınlanır (simgenin rengi düğmenin Foreground'undan gelir) -->
    <Style Selector="Button.rail-tab:pointerover:not(.active)">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    </Style>
    <Style Selector="Button.rail-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    </Style>
    <Style Selector="Button.rail-tab /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /><BrushTransition Property="Foreground" Duration="0:0:0.2" /></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.rail-tab.glow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
    </Style>
    <!-- Seçili sekmenin zemini kayan işaretten gelir (MainWindow RailMark); düğmenin kendisi saydam kalır -->
    <!-- Seçili: simge amber; işaret soldaki amber hap ve arkasındaki ışık (MainWindow RailMark) -->
    <Style Selector="Button.rail-tab.active">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
    </Style>
    <Style Selector="Button.rail-tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentHi}" />
    </Style>
    <Style Selector="Button.rail-tab:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <!-- Üstüne gelince simge hafifçe büyür -->
    <Style Selector="Button.rail-tab Path.tab-icon">
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" /></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.rail-tab:pointerover Path.tab-icon">
        <Setter Property="RenderTransform" Value="scale(1.12)" />
    </Style>
    <Style Selector="Button.rail-tab Path.tab-icon">
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>
    <Style Selector="Button.rail-tab TextBlock">
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button.rail-btn">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rail-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.rail-btn Path.icon">
        <Setter Property="Stroke" Value="{StaticResource AccentHi}" />
    </Style>
    <Style Selector="Button.rail-avatar">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>
    <Style Selector="Button.rail-avatar /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="22" />
    </Style>
    <Style Selector="Button.rail-avatar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BoxShadow" Value="0 0 0 2 #F2A33A" />
    </Style>

    <!-- ── Kartlar: yuvarlak köşe, ince sıcak çizgi, gölge yok ── -->
    <Style Selector="Window.kutuphane Border.card, Window.kutuphane Border.row-card, Window.kutuphane Border.mcard">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource CardLine}" />
        <Setter Property="BoxShadow" Value="none" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Window.kutuphane Border.card:pointerover, Window.kutuphane Border.row-card:pointerover, Window.kutuphane Border.lift.hover">
        <Setter Property="BorderBrush" Value="{StaticResource CardLineStrong}" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Window.kutuphane v|SettingsView Border.section">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource CardLine}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Window.kutuphane Border.toast-card">
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Window.kutuphane Border.modal-box">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BorderBrush" Value="{StaticResource CardLineHover}" />
        <Setter Property="BoxShadow" Value="0 24 60 0 #CC000000" />
    </Style>
    <Style Selector="Window.kutuphane Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Window.kutuphane TextBlock.page-title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.6" />
    </Style>
</Styles>
