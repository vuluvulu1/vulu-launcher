<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             xmlns:v="using:VuluLauncher.Views"
             x:Class="VuluLauncher.Views.RadioPill"
             x:DataType="vm:RadioViewModel">
    <!-- Başlık çubuğundaki mini çalar: istasyon logosu, adı, çalarken ses çubukları ve çal/durdur. Hapın kendisine basınca
         radyo paneli açılır (RadioPanel). -->
    <UserControl.Styles>
        <Style Selector="Button.rpill">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="3,3,10,3" />
            <Setter Property="CornerRadius" Value="17" /><Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rpill /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="CornerRadius" Value="17" /></Style>
        <Style Selector="Button.rpill:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource Hover}" /></Style>
        <Style Selector="Button.rmini">
            <Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{StaticResource Accent}" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rmini /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="CornerRadius" Value="13" /></Style>
        <Style Selector="Button.rmini:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource AccentHi}" /></Style>
    </UserControl.Styles>

    <Border x:Name="Pill" Height="34" CornerRadius="17" Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
            VerticalAlignment="Center" Margin="0,0,6,0">
        <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="rpill" ToolTip.Tip="Radyo: istasyonlar, türler, favoriler" AutomationProperties.Name="Radyo">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Raised}" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentHi}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Logo}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" MaxWidth="128" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <v:EqBars IsVisible="{Binding Playing}" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="radio">
                        <v:RadioPanel />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Classes="rmini" Margin="0,0,4,0" Command="{Binding ToggleCommand}" ToolTip.Tip="Çal / durdur" VerticalAlignment="Center">
                <Panel>
                    <Path Data="M7 4l13 8-13 8z" Fill="{StaticResource AccentInk}" Width="10" Height="10" Stretch="Uniform" IsVisible="{Binding !Playing}" Margin="2,0,0,0" />
                    <Path Data="M6 4h4v16H6zM14 4h4v16h-4z" Fill="{StaticResource AccentInk}" Width="9" Height="10" Stretch="Uniform" IsVisible="{Binding Playing}" />
                </Panel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
