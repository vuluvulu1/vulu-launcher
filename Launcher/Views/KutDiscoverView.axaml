<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             xmlns:v="using:VuluLauncher.Views"
             x:Class="VuluLauncher.Views.KutDiscoverView"
             x:DataType="vm:DiscoverViewModel">
    <!-- Kütüphane temasının Keşfet sayfası. vulu paketleri: öne çıkan büyük kart + kapak ızgarası. CurseForge/Modrinth: büyük
         arama, üstte süzgeç satırı (kategoriler açılır menüde), üç sütun sonuç kartı. Aynı model (DiscoverViewModel). -->
    <UserControl.Styles>
        <Style Selector="Border.tag"><Setter Property="Background" Value="#1B1510" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="7,2" /><Setter Property="Margin" Value="0,0,5,5" /></Style>
        <Style Selector="Border.tag.accent"><Setter Property="Background" Value="#2A1E10" /></Style>
        <Style Selector="Border.tag TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#DCD0C2" /></Style>
        <Style Selector="Border.kcard">
            <Setter Property="Background" Value="#14100C" /><Setter Property="BorderBrush" Value="#2A2118" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" /><Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions"><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.15" /><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" /></Transitions></Setter>
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Border.kcard:pointerover"><Setter Property="BorderBrush" Value="#4A3A28" /><Setter Property="RenderTransform" Value="translateY(-2px)" /></Style>
        <Style Selector="Button.link"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Foreground" Value="#FFC873" /><Setter Property="FontSize" Value="12.5" /></Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#FFD69A" /></Style>
        <Style Selector="Button.act"><Setter Property="Height" Value="34" /><Setter Property="Padding" Value="16,0" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
        <Style Selector="Button.chip"><Setter Property="Padding" Value="10,4" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,5,5" /><Setter Property="CornerRadius" Value="14" /></Style>
        <Style Selector="Button.chip.active"><Setter Property="Background" Value="#2A1E10" /><Setter Property="BorderBrush" Value="#F2A33A" /><Setter Property="Foreground" Value="#FFC873" /></Style>
        <Style Selector="ComboBox.flt"><Setter Property="MinWidth" Value="150" /><Setter Property="Height" Value="38" /></Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="TagTemplate" x:DataType="vm:Tag">
            <Border Classes="tag" Classes.accent="{Binding Accent}"><TextBlock Text="{Binding Text}" /></Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="28,14,24,0">
        <!-- ── Başlık: kaynak seçici ve sağda bağlama göre işlem ── -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,16">
            <TextBlock Text="Keşfet" FontSize="30" FontWeight="SemiBold" LetterSpacing="-0.6" VerticalAlignment="Center" />
            <ItemsControl Grid.Column="1" Classes="segmented" ItemsSource="{Binding Sources}" Margin="16,0,0,0" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Choice">
                        <Button Classes="seg" Classes.active="{Binding IsSelected}" Content="{Binding Label}"
                                Command="{Binding $parent[UserControl].((vm:DiscoverViewModel)DataContext).SelectSourceCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Column="2" Text="{Binding Main.Home.LastActivity}" Classes="dim" FontSize="12" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPacks}" VerticalAlignment="Center">
                <Button Classes="act" Content="{Binding Packs.RequestText}" IsVisible="{Binding Packs.FeedbackEnabled}" Command="{Binding Packs.RequestsCommand}" />
                <Button Classes="act" Content="Yenile" Command="{Binding Packs.LoadCommand}" />
            </StackPanel>
            <ItemsControl Grid.Column="3" Classes="segmented" ItemsSource="{Binding Content.Types}" IsVisible="{Binding !IsPacks}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Choice">
                        <Button Classes="seg" Classes.active="{Binding IsSelected}" Content="{Binding Label}"
                                Command="{Binding $parent[UserControl].((vm:DiscoverViewModel)DataContext).Content.SelectTypeCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Panel>
            <!-- ── vulu paketleri ── -->
            <ScrollViewer IsVisible="{Binding $parent[UserControl].((vm:DiscoverViewModel)DataContext).IsPacks}" DataContext="{Binding Packs}" x:DataType="vm:PacksViewModel">
                <StackPanel Margin="0,0,0,24" Spacing="16">
                    <TextBlock Text="{Binding Status}" Classes="dim" FontSize="12.5" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{Binding StatusIsError, Converter={x:Static v:KutBrushes.ErrorOrDim}}" />
                    <v:EmptyState IsVisible="{Binding IsEmpty}" Margin="0,30,0,0" Icon="📦" Title="Henüz paylaşılan paket yok" Text="Admin bir paket paylaştığında burada görünecek." />
                    <Border Classes="kcard skel" Height="250" IsVisible="{Binding Skeleton}" IsHitTestVisible="False"><v:Skeleton Kind="card" /></Border>

                    <!-- Öne çıkan: ilk paket büyük -->
                    <Border x:Name="Featured" Classes="kcard" Height="250" Cursor="Hand" Tapped="OnCardTapped" x:DataType="vm:PackCard" IsVisible="False">
                        <Panel>
                            <Border Background="{StaticResource BannerFallback}" />
                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Offset="0" Color="#F00B0A09" />
                                        <GradientStop Offset="0.55" Color="#800B0A09" />
                                        <GradientStop Offset="1" Color="#000B0A09" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Margin="28,0" VerticalAlignment="Center" Spacing="8" MaxWidth="560" HorizontalAlignment="Left">
                                <TextBlock Text="ÖNE ÇIKAN PAKET" FontSize="12" FontWeight="SemiBold" Foreground="#FFC873" LetterSpacing="1" />
                                <TextBlock Text="{Binding Name}" FontSize="36" FontWeight="SemiBold" LetterSpacing="-0.8" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Meta}" FontSize="13.5" Classes="muted" />
                                <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" FontSize="14" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,6,0,0">
                                    <Button Classes="act" Classes.primary="{Binding ActionIsPrimary}" Height="42" Padding="22,0" Content="{Binding ActionText}" Command="{Binding ActCommand}" IsEnabled="{Binding !Busy}" />
                                    <Button Classes="link" Content="Ayrıntılar" Command="{Binding DetailsCommand}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <Border IsVisible="{Binding IsOutdated}" Background="{StaticResource Accent}" CornerRadius="6" Padding="9,3" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="Güncelleme var" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentInk}" />
                            </Border>
                        </Panel>
                    </Border>

                    <TextBlock x:Name="RestTitle" Text="Tüm paketler" FontSize="18" FontWeight="SemiBold" IsVisible="False" />
                    <ItemsControl x:Name="Rest" v:Reveal.Stagger="True">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PackCard">
                                <Border Classes="kcard" Margin="0,0,16,16" Cursor="Hand" Tapped="OnCardTapped">
                                    <StackPanel>
                                        <Panel Height="150">
                                            <Border Background="#281F17" />
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="12" Classes="dim" />
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                            <Border IsVisible="{Binding IsOutdated}" Background="{StaticResource Accent}" CornerRadius="6" Padding="8,3" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <TextBlock Text="Güncelleme var" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentInk}" />
                                            </Border>
                                        </Panel>
                                        <StackPanel Margin="14,12,14,14" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagTemplate}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                                                <Button Classes="act" Classes.primary="{Binding ActionIsPrimary}" Content="{Binding ActionText}" Command="{Binding ActCommand}" IsEnabled="{Binding !Busy}" />
                                                <Button Grid.Column="2" Classes="link" Content="Ayrıntılar" Command="{Binding DetailsCommand}" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ── CurseForge / Modrinth ── -->
            <DockPanel IsVisible="{Binding !$parent[UserControl].((vm:DiscoverViewModel)DataContext).IsPacks}" DataContext="{Binding Content}" x:DataType="vm:ContentSearchViewModel">
                <!-- Büyük arama ve hedef instance -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                    <ComboBox IsVisible="{Binding ShowTarget}" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" Width="240" Height="44" Margin="0,0,10,0"
                              ToolTip.Tip="İçeriğin kurulacağı instance; seçilince yalnızca ona uyanlar görünür" />
                    <TextBox x:Name="QueryBox" Grid.Column="1" Text="{Binding Query}" Watermark="{Binding SearchHint}" Height="44" VerticalContentAlignment="Center" FontSize="14" />
                </Grid>
                <!-- Süzgeç satırı -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" ItemSpacing="8" LineSpacing="8">
                    <ComboBox Classes="flt" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" ToolTip.Tip="Sırala" />
                    <ComboBox Classes="flt" IsVisible="{Binding FreeBrowse}" ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" MaxDropDownHeight="360" ToolTip.Tip="Minecraft sürümü" />
                    <ComboBox Classes="flt" IsVisible="{Binding ShowLoader}" ItemsSource="{Binding LoaderOptions}" SelectedItem="{Binding Loader}" ToolTip.Tip="Yükleyici" />
                    <Button Classes="act" Content="Kategoriler ▾" Height="38">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <ScrollViewer MaxHeight="440" Width="380">
                                    <StackPanel Margin="4" Spacing="4">
                                        <v:Loading Text="Filtreler yükleniyor…" HorizontalAlignment="Left" IsVisible="{Binding FiltersLoading}" />
                                        <ItemsControl ItemsSource="{Binding Groups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CategoryGroup">
                                                    <StackPanel Margin="0,0,0,10">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Classes="dim" Margin="0,0,0,4" />
                                                        <ItemsControl ItemsSource="{Binding Chips}">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:CategoryChip">
                                                                    <Button Classes="chip" Classes.active="{Binding IsSelected}" Content="{Binding Label}"
                                                                            Command="{Binding $parent[UserControl].((vm:DiscoverViewModel)DataContext).Content.ToggleCategoryCommand}" CommandParameter="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <CheckBox Content="Yalnızca açık kaynak" IsChecked="{Binding OpenSource}" IsVisible="{Binding !IsCurseForge}" VerticalAlignment="Center" />
                    <Button Classes="link" Content="{Binding ClearText}" IsEnabled="{Binding CanClear}" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Center" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Classes="dim" FontSize="12.5" Margin="0,0,0,8" TextWrapping="Wrap" />
                <ScrollViewer>
                    <StackPanel Margin="0,0,0,24" Spacing="8">
                        <ItemsControl ItemsSource="{Binding Hits}" v:Reveal.Stagger="True">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ContentHit">
                                    <Border Classes="kcard" Padding="14" Margin="0,0,14,14">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                    <Button Classes="link" Content="Sürüm seç" Command="{Binding PickVersionCommand}" />
                                                    <Button Classes="link" Content="Sayfa ↗" Command="{Binding OpenPageCommand}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="act" Classes.primary="{Binding IsPrimary}" Content="{Binding ButtonText}" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Button Classes="flat" Padding="0" VerticalAlignment="Top" Command="{Binding DetailsCommand}" ToolTip.Tip="Ayrıntıları göster">
                                                    <Border Width="52" Height="52" CornerRadius="12" Background="#1B1510" ClipToBounds="True"><Image Source="{Binding Icon}" Stretch="UniformToFill" /></Border>
                                                </Button>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                                                    <Button Classes="link" Command="{Binding DetailsCommand}" Foreground="{StaticResource Text}" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                    <TextBlock Text="{Binding Author}" Classes="dim" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                    <Border Classes="tag" IsVisible="{Binding ManualOnly}" HorizontalAlignment="Left" Margin="0,2,0,0"><TextBlock Text="Elle indirilir" /></Border>
                                                </StackPanel>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Daha fazla göster" IsVisible="{Binding HasMore}" Command="{Binding MoreCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Panel>
    </DockPanel>
</UserControl>
