<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             xmlns:v="using:VuluLauncher.Views"
             x:Class="VuluLauncher.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">
    <UserControl.Styles>
        <Style Selector="Button.sm">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,18,0,0" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,280">
        <ScrollViewer>
            <Panel>
            <v:Skeleton Height="420" Margin="28,22,28,30" MaxWidth="820" VerticalAlignment="Top" IsVisible="{Binding ShowSkeleton}" />
            <StackPanel Margin="28,22,28,30" MaxWidth="820" Spacing="18" IsVisible="{Binding !ShowSkeleton}">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- Banner -->
                <Grid Height="170" Background="{StaticResource Raised}" ClipToBounds="True">
                    <Border Background="{StaticResource BannerFallback}" />
                    <Image Source="{Binding Banner}" Stretch="UniformToFill" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding Editing}">
                        <Button Classes="sm" Content="Banner ekle / değiştir" Command="{Binding ChangeBannerCommand}" />
                        <Button Classes="sm danger" Content="Kaldır" IsVisible="{Binding HasBanner}" Command="{Binding RemoveBannerCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Baş: resim, ad, bilgiler, işlemler -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,-60,0,0">
                    <Border Width="112" Height="112" CornerRadius="56" Background="{StaticResource Raised}" BorderBrush="{StaticResource Bg}" BorderThickness="4" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Initial}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,64,12,0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Username}" FontSize="24" FontWeight="Bold" />
                            <Border IsVisible="{Binding IsAdminUser}" Background="{StaticResource AccentSoft}" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="Admin" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            </Border>
                            <Border IsVisible="{Binding HasProgress}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="6,1" VerticalAlignment="Center"
                                    ToolTip.Tip="vulu seviyesi: vulu sunucusunda oynadıkça yükselir">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"><Run Text="Seviye " /><Run Text="{Binding Level}" /></TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12.5" />
                        <ItemsControl ItemsSource="{Binding Roles}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RoleChip">
                                    <Border BorderBrush="{Binding Brush}" BorderThickness="1" Padding="7,1" Margin="0,4,6,0">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding Brush}" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,64,0,0" Spacing="6" Orientation="Horizontal" VerticalAlignment="Top">
                        <!-- Kendi profilin -->
                        <Button Classes="sm" Content="Ayarlar" IsVisible="{Binding ShowEditButton}" Command="{Binding OpenSettingsCommand}" />
                        <Button Classes="sm primary" Content="Profili düzenle" IsVisible="{Binding ShowEditButton}" Command="{Binding StartEditingCommand}" />
                        <Button Classes="sm" Content="Resmi değiştir" IsVisible="{Binding Editing}" Command="{Binding ChangeAvatarCommand}" />
                        <Button Classes="sm" Content="Kaldır" IsVisible="{Binding Editing}" IsEnabled="{Binding HasAvatar}" Command="{Binding RemoveAvatarCommand}" />
                        <Button Classes="sm primary" Content="Bitti" IsVisible="{Binding Editing}" Command="{Binding StopEditingCommand}" />
                        <!-- Başkasının profili -->
                        <Button Classes="sm" Classes.primary="{Binding IsIncoming}" Content="{Binding FriendText}" IsVisible="{Binding IsOther}" Command="{Binding FriendCommand}" />
                        <Button Classes="sm" Content="Reddet" IsVisible="{Binding IsIncoming}" Command="{Binding DeclineFriendCommand}" />
                        <Button Classes="sm primary" Content="Mesaj gönder" IsVisible="{Binding IsOther}" Command="{Binding MessageCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Hakkında -->
                <Border Classes="section">
                    <StackPanel>
                        <TextBlock Classes="h2" Text="Hakkında" />
                        <TextBlock Text="{Binding BioText}" TextWrapping="Wrap" IsVisible="{Binding ShowBioView}" Classes.dim="{Binding BioEmpty}" />
                        <StackPanel IsVisible="{Binding Editing}" Spacing="6">
                            <TextBox Text="{Binding BioDraft}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" MaxLength="300"
                                     Watermark="Kendinden bahset: ne oynarsın, hangi sunucudasın…" />
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding BioCounter}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BioNote}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                                <Button Classes="sm primary" Content="Kaydet" IsEnabled="{Binding CanSaveBio}" Command="{Binding SaveBioCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Skin: dönen 3B karakter (sürükleyerek çevrilir) ve dolap -->
                <Border Classes="section" IsVisible="{Binding ShowSkin}">
                    <StackPanel>
                        <TextBlock Classes="h2" Text="Skin" />
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="190" Height="290" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <Grid>
                                    <v:SkinViewer3D Skin="{Binding SkinBytes}" Cape="{Binding CapeBytes}" Slim="{Binding Slim}" Margin="8"
                                                    ToolTip.Tip="Her yöne çevirmek için sürükle · çift tık: dik duruş" />
                                    <TextBlock Text="Varsayılan skin" Classes="dim" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                               IsVisible="{Binding !HasSkin}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="10">
                                <StackPanel Spacing="10" IsVisible="{Binding IsOwn}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Classes="sm primary" Content="{Binding SkinButton}" Command="{Binding PickSkinCommand}" />
                                        <Button Classes="sm" Content="Kaldır" IsVisible="{Binding HasSkin}" Command="{Binding RemoveSkinCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="Beden tipi" Classes="label" />
                                    <Border Classes="segmented" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasSkin}">
                                        <Button Classes="seg" Classes.active="{Binding !Slim}" Content="Klasik (Steve)" Command="{Binding SetSkinModelCommand}" CommandParameter="default" />
                                        <Button Classes="seg" Classes.active="{Binding Slim}" Content="İnce (Alex)" Command="{Binding SetSkinModelCommand}" CommandParameter="slim" />
                                    </StackPanel>
                                    </Border>
                                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left"
                                               Text="64×64 PNG. Tek oyunculu dünyada, LAN'da ve vulu sunucularında görünür; değişiklik oyunu bir sonraki açışında geçerli olur." />
                                </StackPanel>

                                <!-- Dolap: yüklenen skinler saklanır, tek tıkla giyilir -->
                                <StackPanel Spacing="6" IsVisible="{Binding ShowWardrobe}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Dolap" Classes="label" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding WardrobeCount}" Classes="dim" FontSize="11.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Classes="dim" FontSize="12" IsVisible="{Binding !HasWardrobe}" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left"
                                               Text="Yüklediğin skinler burada saklanır; aralarında tek tıkla geçersin." />
                                    <ItemsControl ItemsSource="{Binding Wardrobe}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WardrobeItem">
                                                <Button Classes="flat" Padding="4" Margin="0,0,6,6" Command="{Binding WearCommand}" ToolTip.Tip="{Binding Name}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Giy" Command="{Binding WearCommand}" />
                                                            <MenuItem Header="Adını değiştir" Command="{Binding RenameCommand}" />
                                                            <MenuItem Header="Dolaptan çıkar" Command="{Binding RemoveCommand}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Border Width="58" Height="92" Background="{StaticResource Card}" BorderThickness="2"
                                                            BorderBrush="{StaticResource Line}" Classes.worn="{Binding IsWorn}">
                                                        <Border.Styles>
                                                            <Style Selector="Border.worn"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Style>
                                                        </Border.Styles>
                                                        <Grid RowDefinitions="*,Auto">
                                                            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="6,4" RenderOptions.BitmapInterpolationMode="None" />
                                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="2,0,2,3" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="dim" FontSize="11.5" IsVisible="{Binding HasWardrobe}" Text="Giymek için tıkla · sağ tık: ad değiştir, dolaptan çıkar" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Seviye ve sezon: vulu sunucusunun istatistiklerinden -->
                <Border Classes="section" IsVisible="{Binding HasProgress}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="Seviye" />
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="64" Height="64" CornerRadius="32" BorderBrush="{StaticResource Accent}" BorderThickness="3" Background="{StaticResource AccentSoft}">
                                <TextBlock Text="{Binding Level}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentHi}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,4,0,0" Spacing="6" VerticalAlignment="Center">
                                <ProgressBar Value="{Binding LevelFraction}" Maximum="1" Height="8" />
                                <TextBlock Text="{Binding LevelText}" Classes="dim" FontSize="12" />
                                <TextBlock Text="{Binding StatsText}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="8" IsVisible="{Binding HasSeason}" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding SeasonName}" FontWeight="Bold" FontSize="14.5" />
                                <Border Background="{StaticResource AccentSoft}" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentHi}"><Run Text="Sezon seviyesi " /><Run Text="{Binding SeasonLevel}" /></TextBlock>
                                </Border>
                            </StackPanel>
                            <ProgressBar Value="{Binding SeasonFraction}" Maximum="1" Height="6" />
                            <TextBlock Text="{Binding SeasonText}" Classes="dim" FontSize="12" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Quests}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:QuestItem">
                                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,8" Margin="0,0,8,8"
                                                Classes.done="{Binding Done}">
                                            <Border.Styles>
                                                <Style Selector="Border.done"><Setter Property="BorderBrush" Value="{StaticResource Ok}" /></Style>
                                            </Border.Styles>
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Desc}" Classes="dim" FontSize="11.5" TextWrapping="Wrap" />
                                                    <ProgressBar Value="{Binding Fraction}" Maximum="1" Height="4" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding ProgressText}" Classes="muted" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- vulu Pelerinleri: satılmaz, oynayarak ve etkinliklerle kazanılır; oyunda herkes görür -->
                <Border Classes="section" IsVisible="{Binding HasCapes}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h2" Text="Pelerinler" />
                        <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsOwn}"
                                   Text="Pelerinler satılmaz: oynayarak, sezon görevleriyle ve etkinlik kazanarak alınır. Taktığın pelerini oyunda herkes görür." />
                        <ItemsControl ItemsSource="{Binding Capes}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CapeItem">
                                    <Button Classes="flat" Padding="4" Margin="0,0,8,8" Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding Tip}">
                                        <Border Width="84" Background="{StaticResource Card}" BorderThickness="2" BorderBrush="{StaticResource Line}" Padding="6"
                                                Classes.worn="{Binding IsWorn}" Classes.locked="{Binding Locked}">
                                            <Border.Styles>
                                                <Style Selector="Border.worn"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Style>
                                                <Style Selector="Border.locked"><Setter Property="Opacity" Value="0.42" /></Style>
                                            </Border.Styles>
                                            <StackPanel Spacing="4">
                                                <Image Source="{Binding Preview}" Width="40" Height="64" RenderOptions.BitmapInterpolationMode="None" />
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Text="Kilitli" FontSize="10" Classes="dim" HorizontalAlignment="Center" IsVisible="{Binding Locked}" />
                                                <TextBlock Text="Takılı" FontSize="10" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" IsVisible="{Binding IsWorn}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding CapeNote}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding CapeNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <!-- Admin: pelerin ver / geri al -->
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding CanGrantCapes}">
                            <ComboBox ItemsSource="{Binding GrantableCapes}" SelectedItem="{Binding GrantCape}" PlaceholderText="Pelerin seç" MinWidth="180" />
                            <Button Classes="sm" Content="Ver" Command="{Binding GrantCapeToUserCommand}" />
                            <Button Classes="sm danger" Content="Geri al" Command="{Binding RevokeCapeFromUserCommand}" />
                            <TextBlock Text="{Binding GrantNote}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Rozetler -->
                <Border Classes="section" IsVisible="{Binding HasBadges}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h2" Text="{Binding BadgesTitle}" />
                        <ItemsControl ItemsSource="{Binding Badges}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BadgeItem">
                                    <Border BorderBrush="{StaticResource Accent}" BorderThickness="1" Background="{StaticResource AccentSoft}" Padding="8,3" Margin="0,0,6,6" ToolTip.Tip="{Binding Tip}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Icon}" FontSize="13" />
                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentHi}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Oynama -->
                <Border Classes="section" IsVisible="{Binding HasPlaytime}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h2" Text="Oynama" />
                        <TextBlock><Run Text="{Binding PlaytimeTotal}" FontWeight="Bold" FontSize="18" /><Run Text=" toplam" Foreground="{StaticResource Muted}" /></TextBlock>
                        <ItemsControl ItemsSource="{Binding Playtime}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaytimeRow">
                                    <Grid ColumnDefinitions="180,*,90" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Column="1" Value="{Binding Fraction}" Maximum="1" VerticalAlignment="Center" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Time}" Classes="dim" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Classes="section" IsVisible="{Binding ShowPlaytimeHint}">
                    <StackPanel>
                        <TextBlock Classes="h2" Text="Oynama" />
                        <TextBlock Text="{Binding PlaytimeHint}" Classes="dim" />
                    </StackPanel>
                </Border>

                <!-- Paylaştığı paketler -->
                <Border Classes="section" IsVisible="{Binding HasPacks}">
                    <StackPanel>
                        <TextBlock Classes="h2" Text="{Binding PacksTitle}" />
                        <ItemsControl ItemsSource="{Binding Packs}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProfilePack">
                                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,8" Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- E-posta değiştir: yeni adrese giden bağlantı açılınca geçerli olur -->
                <Border Classes="section" IsVisible="{Binding Editing}">
                    <StackPanel Spacing="6" Width="360" HorizontalAlignment="Left">
                        <TextBlock Classes="h2" Text="E-posta adresi" />
                        <TextBlock Text="{Binding CurrentEmailText}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PendingEmailText}" Foreground="{StaticResource Accent}" FontSize="12.5" TextWrapping="Wrap"
                                   IsVisible="{Binding HasPendingEmail}" />
                        <TextBox Text="{Binding NewEmail}" MaxLength="254" Watermark="Yeni e-posta adresi" Margin="0,4,0,0" />
                        <TextBox Text="{Binding EmailPassword}" PasswordChar="•" Watermark="Şifren" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding EmailNote}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="220"
                                       Classes.ok="{Binding EmailOk}" Classes.err="{Binding !EmailOk}">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{StaticResource Ok}" /></Style>
                                    <Style Selector="TextBlock.err"><Setter Property="Foreground" Value="{StaticResource Error}" /></Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <Button Classes="sm primary" Content="Adresi değiştir" Command="{Binding ChangeEmailCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Şifre değiştir -->
                <Border Classes="section" IsVisible="{Binding Editing}">
                    <StackPanel Spacing="6" Width="360" HorizontalAlignment="Left">
                        <TextBlock Classes="h2" Text="Şifre değiştir" />
                        <TextBox Text="{Binding CurrentPassword}" PasswordChar="•" Watermark="Mevcut şifre" />
                        <TextBox Text="{Binding NewPassword}" PasswordChar="•" Watermark="Yeni şifre" />
                        <TextBox Text="{Binding RepeatPassword}" PasswordChar="•" Watermark="Yeni şifre tekrar" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding PasswordNote}" FontSize="12" VerticalAlignment="Center" Classes.ok="{Binding PasswordOk}" Classes.err="{Binding !PasswordOk}">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{StaticResource Ok}" /></Style>
                                    <Style Selector="TextBlock.err"><Setter Property="Foreground" Value="{StaticResource Error}" /></Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <Button Classes="sm primary" Content="Şifreyi değiştir" Command="{Binding ChangePasswordCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Classes="sm danger" Content="Çıkış yap" IsVisible="{Binding IsOwn}" Command="{Binding LogoutCommand}" HorizontalAlignment="Left" />
            </StackPanel>
            </Panel>
        </ScrollViewer>

        <!-- Üyeler -->
        <Border Grid.Column="1" Background="{StaticResource SidePanel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <DockPanel Margin="14,22,14,14">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Text="Topluluk" FontSize="16" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{Binding MembersCount}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                </Grid>
                <TextBox DockPanel.Dock="Top" Text="{Binding MemberSearch}" Watermark="Üye ara…" Margin="0,0,0,10" />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Members}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonItem">
                                <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,5"
                                        Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).OpenMemberCommand}" CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Avatar}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                                                <Border IsVisible="{Binding IsAdmin}" Background="{StaticResource AccentSoft}" Padding="4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="admin" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentHi}" />
                                                </Border>
                                                <TextBlock IsVisible="{Binding IsYou}" Text="sen" FontSize="11" Classes="dim" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Sub}" IsVisible="{Binding HasSub}" FontSize="12" FontWeight="Normal"
                                                       Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
