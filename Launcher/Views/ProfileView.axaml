<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             x:Class="VuluLauncher.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">
    <UserControl.Styles>
        <Style Selector="Button.sm">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,18,0,0" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,280">
        <ScrollViewer>
            <StackPanel Margin="28,22,28,30" MaxWidth="820" Spacing="18">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- Banner -->
                <Grid Height="170" Background="{StaticResource Raised}" ClipToBounds="True">
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#3A2410" Offset="0" />
                                <GradientStop Color="#14100C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Image Source="{Binding Banner}" Stretch="UniformToFill" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding Editing}">
                        <Button Classes="sm" Content="Banner ekle / değiştir" Command="{Binding ChangeBannerCommand}" />
                        <Button Classes="sm danger" Content="Kaldır" IsVisible="{Binding HasBanner}" Command="{Binding RemoveBannerCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Baş: resim, ad, bilgiler, işlemler -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,-60,0,0">
                    <Border Width="112" Height="112" CornerRadius="56" Background="{StaticResource Raised}" BorderBrush="{StaticResource Bg}" BorderThickness="4" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Initial}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,64,12,0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Username}" FontSize="24" FontWeight="Bold" />
                            <Border IsVisible="{Binding IsAdminUser}" Background="{StaticResource AccentSoft}" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="Admin" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12.5" />
                        <ItemsControl ItemsSource="{Binding Roles}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RoleChip">
                                    <Border BorderBrush="{Binding Brush}" BorderThickness="1" Padding="7,1" Margin="0,4,6,0">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding Brush}" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,64,0,0" Spacing="6" Orientation="Horizontal" VerticalAlignment="Top">
                        <!-- Kendi profilin -->
                        <Button Classes="sm" Content="Ayarlar" IsVisible="{Binding ShowEditButton}" Command="{Binding OpenSettingsCommand}" />
                        <Button Classes="sm primary" Content="Profili düzenle" IsVisible="{Binding ShowEditButton}" Command="{Binding StartEditingCommand}" />
                        <Button Classes="sm" Content="Resmi değiştir" IsVisible="{Binding Editing}" Command="{Binding ChangeAvatarCommand}" />
                        <Button Classes="sm" Content="Kaldır" IsVisible="{Binding Editing}" IsEnabled="{Binding HasAvatar}" Command="{Binding RemoveAvatarCommand}" />
                        <Button Classes="sm primary" Content="Bitti" IsVisible="{Binding Editing}" Command="{Binding StopEditingCommand}" />
                        <!-- Başkasının profili -->
                        <Button Classes="sm" Classes.primary="{Binding IsIncoming}" Content="{Binding FriendText}" IsVisible="{Binding IsOther}" Command="{Binding FriendCommand}" />
                        <Button Classes="sm" Content="Reddet" IsVisible="{Binding IsIncoming}" Command="{Binding DeclineFriendCommand}" />
                        <Button Classes="sm primary" Content="Mesaj gönder" IsVisible="{Binding IsOther}" Command="{Binding MessageCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Hakkında -->
                <Border Classes="section">
                    <StackPanel>
                        <TextBlock Classes="h2" Text="Hakkında" />
                        <TextBlock Text="{Binding BioText}" TextWrapping="Wrap" IsVisible="{Binding ShowBioView}" Classes.dim="{Binding BioEmpty}" />
                        <StackPanel IsVisible="{Binding Editing}" Spacing="6">
                            <TextBox Text="{Binding BioDraft}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" MaxLength="300"
                                     Watermark="Kendinden bahset: ne oynarsın, hangi sunucudasın…" />
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding BioCounter}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BioNote}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                                <Button Classes="sm primary" Content="Kaydet" IsEnabled="{Binding CanSaveBio}" Command="{Binding SaveBioCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Skin -->
                <Border Classes="section" IsVisible="{Binding ShowSkin}">
                    <StackPanel>
                        <TextBlock Classes="h2" Text="Skin" />
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="128" Height="256" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="Varsayılan skin" Classes="dim" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding !HasSkin}" />
                                    <Image Source="{Binding Skin}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="10" IsVisible="{Binding IsOwn}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="sm primary" Content="{Binding SkinButton}" Command="{Binding PickSkinCommand}" />
                                    <Button Classes="sm" Content="Kaldır" IsVisible="{Binding HasSkin}" Command="{Binding RemoveSkinCommand}" />
                                </StackPanel>
                                <TextBlock Text="Beden tipi" Classes="label" />
                                <Border Classes="segmented">
                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasSkin}">
                                    <Button Classes="seg" Classes.active="{Binding !Slim}" Content="Klasik (Steve)" Command="{Binding SetSkinModelCommand}" CommandParameter="default" />
                                    <Button Classes="seg" Classes.active="{Binding Slim}" Content="İnce (Alex)" Command="{Binding SetSkinModelCommand}" CommandParameter="slim" />
                                </StackPanel>
                                </Border>
                                <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"
                                           Text="64×64 PNG. Tek oyunculu dünyada, LAN'da ve vulu sunucularında görünür; değişiklik oyunu bir sonraki açışında geçerli olur." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Oynama -->
                <Border Classes="section" IsVisible="{Binding HasPlaytime}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h2" Text="Oynama" />
                        <TextBlock><Run Text="{Binding PlaytimeTotal}" FontWeight="Bold" FontSize="18" /><Run Text=" toplam" Foreground="{StaticResource Muted}" /></TextBlock>
                        <ItemsControl ItemsSource="{Binding Playtime}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaytimeRow">
                                    <Grid ColumnDefinitions="180,*,90" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Column="1" Value="{Binding Fraction}" Maximum="1" VerticalAlignment="Center" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Time}" Classes="dim" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Classes="section" IsVisible="{Binding ShowPlaytimeHint}">
                    <StackPanel>
                        <TextBlock Classes="h2" Text="Oynama" />
                        <TextBlock Text="{Binding PlaytimeHint}" Classes="dim" />
                    </StackPanel>
                </Border>

                <!-- Paylaştığı paketler -->
                <Border Classes="section" IsVisible="{Binding HasPacks}">
                    <StackPanel>
                        <TextBlock Classes="h2" Text="{Binding PacksTitle}" />
                        <ItemsControl ItemsSource="{Binding Packs}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProfilePack">
                                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,8" Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Şifre değiştir -->
                <Border Classes="section" IsVisible="{Binding Editing}">
                    <StackPanel Spacing="6" MaxWidth="360" HorizontalAlignment="Left">
                        <TextBlock Classes="h2" Text="Şifre değiştir" />
                        <TextBox Text="{Binding CurrentPassword}" PasswordChar="•" Watermark="Mevcut şifre" />
                        <TextBox Text="{Binding NewPassword}" PasswordChar="•" Watermark="Yeni şifre" />
                        <TextBox Text="{Binding RepeatPassword}" PasswordChar="•" Watermark="Yeni şifre tekrar" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding PasswordNote}" FontSize="12" VerticalAlignment="Center" Classes.ok="{Binding PasswordOk}" Classes.err="{Binding !PasswordOk}">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{StaticResource Ok}" /></Style>
                                    <Style Selector="TextBlock.err"><Setter Property="Foreground" Value="{StaticResource Error}" /></Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <Button Classes="sm primary" Content="Şifreyi değiştir" Command="{Binding ChangePasswordCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Classes="sm danger" Content="Çıkış yap" IsVisible="{Binding IsOwn}" Command="{Binding LogoutCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>

        <!-- Üyeler -->
        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <DockPanel Margin="14,22,14,14">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Text="Topluluk" FontSize="16" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{Binding MembersCount}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                </Grid>
                <TextBox DockPanel.Dock="Top" Text="{Binding MemberSearch}" Watermark="Üye ara…" Margin="0,0,0,10" />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Members}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonItem">
                                <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,5"
                                        Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).OpenMemberCommand}" CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Avatar}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                                                <Border IsVisible="{Binding IsAdmin}" Background="{StaticResource AccentSoft}" Padding="4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="admin" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentHi}" />
                                                </Border>
                                                <TextBlock IsVisible="{Binding IsYou}" Text="sen" FontSize="11" Classes="dim" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Sub}" IsVisible="{Binding HasSub}" FontSize="12" FontWeight="Normal"
                                                       Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
