<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluLauncher.ViewModels"
             xmlns:v="using:VuluLauncher.Views"
             x:Class="VuluLauncher.Views.WorldView"
             x:DataType="vm:WorldViewModel">
    <UserControl.Styles>
        <Style Selector="Button.sm">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.row.you">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="26,22,26,20">
        <!-- Başlık ve görünüm seçici -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" Classes="page-title" />
                <TextBlock Text="{Binding Description}" Classes="muted" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Classes="sm" Content="Yenile" Command="{Binding ReloadCommand}" />
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{StaticResource Error}" Margin="0,0,0,10" TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Panel>
            <!-- ── Liderlik ──────────────────────────────────────────── -->
            <ScrollViewer IsVisible="{Binding IsBoard}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="segmented">
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="seg" Classes.active="{Binding IsWeek}" Content="Bu hafta" Command="{Binding SetPeriodCommand}" CommandParameter="week" />
                                <Button Classes="seg" Classes.active="{Binding IsSeason}" Content="Sezon" Command="{Binding SetPeriodCommand}" CommandParameter="season" />
                                <Button Classes="seg" Classes.active="{Binding IsAll}" Content="Tüm zamanlar" Command="{Binding SetPeriodCommand}" CommandParameter="all" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Subtitle}" Classes="dim" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </Grid>

                    <!-- Geçen haftanın birincileri -->
                    <Border Classes="card" Padding="14,10" IsVisible="{Binding HasWinners}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Geçen haftanın şampiyonları" FontWeight="Bold" />
                            <ItemsControl ItemsSource="{Binding Winners}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WinnerItem">
                                        <Border BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="8,4" Margin="0,0,8,4">
                                            <TextBlock FontSize="12"><Run Text="{Binding Icon}" /><Run Text=" " /><Run Text="{Binding Category}" Foreground="{StaticResource Muted}" /><Run Text=": " /><Run Text="{Binding Username}" FontWeight="Bold" Foreground="{StaticResource AccentHi}" /><Run Text=" · " /><Run Text="{Binding Value}" /></TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RankCategory">
                                <Border Classes="card" Padding="14,12" Margin="0,0,12,12">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontSize="15" FontWeight="Bold"><Run Text="{Binding Icon}" /><Run Text="  " /><Run Text="{Binding Name}" /></TextBlock>
                                        <TextBlock Text="Henüz kimse yok. İlk sen ol!" Classes="dim" FontSize="12" IsVisible="{Binding Empty}" Margin="0,6" />
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RankRow">
                                                    <Border Classes="row" Classes.you="{Binding You}" Padding="4,2">
                                                        <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4,3" Command="{Binding OpenCommand}">
                                                            <Grid ColumnDefinitions="30,Auto,*,Auto">
                                                                <TextBlock Text="{Binding Medal}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                           Classes.dim="{Binding !Top}" />
                                                                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" ClipToBounds="True" Background="{StaticResource Raised}" Margin="6,0,8,0">
                                                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                                                </Border>
                                                                <TextBlock Grid.Column="2" Text="{Binding Username}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="3" Text="{Binding Value}" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            </Grid>
                                                        </Button>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                               Text="Sayılar vulu sunucusunun kendi istatistiklerinden 5 dakikada bir okunur. Oyuncu çıkınca ya da sunucu kaydedince güncellenir." />
                </StackPanel>
            </ScrollViewer>

            <!-- ── Harita ─────────────────────────────────────────────── -->
            <Grid IsVisible="{Binding IsMap}" RowDefinitions="*,Auto">
                <Border Classes="card" ClipToBounds="True">
                    <Panel>
                        <v:WorldMapControl x:Name="MapView" Markers="{Binding Markers}" Background="{StaticResource Surface}" Accent="{StaticResource Accent}"
                                           IsVisible="{Binding MapEnabled}" />
                        <TextBlock Text="{Binding MapStatus}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                   IsVisible="{Binding !MapEnabled}" MaxWidth="420" TextAlignment="Center" />
                        <Button Classes="sm" Content="Beni bul" Command="{Binding CenterOnMeCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                IsVisible="{Binding MapEnabled}" />
                    </Panel>
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBlock Text="{Binding MapStatus}" Classes="dim" FontSize="12" IsVisible="{Binding MapEnabled}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="dim" FontSize="12" FontFamily="{StaticResource Mono}"><Run Text="{Binding Hover}" /><Run Text="   " /><Run Text="{Binding MapUpdated}" /></TextBlock>
                </Grid>
            </Grid>
        </Panel>
    </DockPanel>
</UserControl>
