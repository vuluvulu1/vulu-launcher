<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>vulu Launcher</AssemblyName>
    <RootNamespace>VuluLauncher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <!-- Yayınlarken tools/publish-release.ps1 bunu -p:Version ile ezer -->
    <Version>0.9.0</Version>
    <Authors>vuluvulu1</Authors>
    <Company>vuluvulu1</Company>
    <Product>vulu Launcher</Product>
    <Copyright>Copyright (c) 2026 vuluvulu1. Licensed under AGPL-3.0.</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Updater ile ortak: pencere simgesi ve kurulum kaydı (Releases.cs Vulu.Core'da) -->
    <Compile Include="..\Shared\WindowIcon.cs" Link="Shared\WindowIcon.cs" />
    <Compile Include="..\Shared\InstallInfo.cs" Link="Shared\InstallInfo.cs" />
    <Compile Include="..\Shared\ScriptTitle*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Arayüz: Avalonia (kendi çizer; WebView2 gerekmez) -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Paket görselleri (PackCatalog'daki yollar wwwroot'a göre) exe'nin yanına kopyalanır -->
    <Content Include="wwwroot\assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Yazı tipleri ve arayüz görselleri programın içine gömülür -->
    <AvaloniaResource Include="wwwroot\fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <AvaloniaResource Include="wwwroot\assets\logo.png" Link="Assets\logo.png" />
    <Content Include="logo.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Açık kaynak lisansları (Ayarlar → Açık kaynak lisansları) -->
    <Content Include="wwwroot\licenses\**" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="wwwroot\fonts\OFL-*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Arayüz komutları ve servisler; Android sürümüyle ortak -->
    <ProjectReference Include="..\Core\Vulu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Updater ayrı bir exe; önce o derlenir, çıktısı aşağıdaki hedefle launcher'ın yanına konur. -->
    <ProjectReference Include="..\Updater\Updater.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Yayında (win-x64) Updater ayrıca aynı klasöre yayınlanır; bu kopya yalnızca geliştirme derlemesi içindir -->
  <Target Name="CopyUpdater" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <UpdaterFiles Include="..\Updater\bin\$(Configuration)\net10.0-windows10.0.19041.0\Updater.*;..\Updater\bin\$(Configuration)\net10.0-windows10.0.19041.0\vuluLauncher-logo-prototip.ico" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Vulu.Tests" />
  </ItemGroup>

</Project>
