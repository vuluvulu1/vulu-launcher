<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>vulu Launcher</AssemblyName>
    <RootNamespace>VuluLauncher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <!-- Yayınlarken tools/publish-release.ps1 bunu -p:Version ile ezer -->
    <Version>0.8.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Updater ile ortak: GitHub release bilgisi ve sürüm karşılaştırma -->
    <Compile Include="..\Shared\Releases.cs" Link="Shared\Releases.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.9.0" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Arayüz dosyaları exe'nin yanına kopyalanır; Photino bunları wwwroot klasöründen yükler. -->
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Updater ayrı bir exe; önce o derlenir, çıktısı aşağıdaki hedefle launcher'ın yanına konur. -->
    <ProjectReference Include="..\Updater\Updater.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyUpdater" AfterTargets="Build">
    <ItemGroup>
      <UpdaterFiles Include="..\Updater\bin\$(Configuration)\net10.0-windows\Updater.*;..\Updater\bin\$(Configuration)\net10.0-windows\vuluLauncher-logo-prototip.ico" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
