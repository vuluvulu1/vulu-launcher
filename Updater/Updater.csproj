<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Launcher ile aynı hedef: aynı klasöre yayınlandıklarında ortak paketlerin (CommunityToolkit vb.) aynı dosyası seçilir -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Updater</RootNamespace>
    <ApplicationIcon>vuluLauncher-logo-prototip.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.9.0</Version>
    <Authors>vuluvulu1</Authors>
    <Company>vuluvulu1</Company>
    <Product>vulu Launcher</Product>
    <Copyright>Copyright (c) 2026 vuluvulu1. Licensed under AGPL-3.0.</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Launcher ile aynı arayüz kütüphanesi ve sürümü: yayında aynı klasördeki dosyaları paylaşırlar -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Launcher ile ortak: GitHub release bilgisi ve sürüm karşılaştırma -->
    <Compile Include="..\Shared\Releases.cs" Link="Shared\Releases.cs" />
    <Compile Include="..\Shared\ServerConnection.cs" Link="Shared\ServerConnection.cs" />
    <Compile Include="..\Shared\WindowIcon.cs" Link="Shared\WindowIcon.cs" />
    <Compile Include="..\Shared\InstallInfo.cs" Link="Shared\InstallInfo.cs" />

    <!-- Yazı tipleri ve logo exe'nin içine gömülür; güncelleme sırasında diskteki dosyalar değişse de etkilenmez -->
    <AvaloniaResource Include="..\Launcher\wwwroot\fonts\IBMPlexSans.ttf" Link="Assets\Fonts\IBMPlexSans.ttf" />
    <AvaloniaResource Include="..\Launcher\wwwroot\fonts\IBMPlexMono-Medium.ttf" Link="Assets\Fonts\IBMPlexMono-Medium.ttf" />
    <AvaloniaResource Include="..\Launcher\wwwroot\assets\logo.png" Link="Assets\logo.png" />
    <Content Include="vuluLauncher-logo-prototip.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
