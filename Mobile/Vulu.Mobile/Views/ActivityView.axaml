<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluMobile.ViewModels"
             xmlns:v="using:VuluMobile.Views"
             x:Class="VuluMobile.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="20,32,20,0">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
                <TextBlock Classes="title" Text="Bildirimler" />
                <TextBlock Classes="dim" FontSize="13" Text="Son bir hafta." />
            </StackPanel>
            <Button Grid.Column="1" Content="Yenile" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
        </Grid>
        <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="{StaticResource Error}" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Spacing="8" Margin="0,0,0,24">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding Loading}" />
                <TextBlock IsVisible="{Binding IsEmpty}" Classes="muted" TextWrapping="Wrap" Text="Yeni bir şey yok." />
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActivityItem">
                            <Border Classes="card" Padding="0">
                                <Button Classes="row" Command="{Binding $parent[ItemsControl].((vm:ActivityViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <v:Avatar Username="{Binding User}" Size="40" />
                                        <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding User}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Text}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding When}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
