<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluMobile.ViewModels"
             x:Class="VuluMobile.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
    <StackPanel Margin="20,32,20,20" Spacing="10">
        <TextBlock Classes="title" Text="{Binding Title}" />
        <TextBlock Classes="muted" Text="{Binding Text}" TextWrapping="Wrap" />
        <TextBlock Classes="dim" FontSize="13" Text="Yakında." />
    </StackPanel>
</UserControl>
