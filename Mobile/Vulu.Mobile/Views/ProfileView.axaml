<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VuluMobile.ViewModels"
             x:Class="VuluMobile.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">
    <StackPanel Margin="20,32,20,20" Spacing="14">
        <TextBlock Classes="title" Text="{Binding Username}" />
        <TextBlock Classes="muted" Text="{Binding Role}" />
        <Button Classes="danger" Content="Çıkış yap" Command="{Binding LogoutCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
