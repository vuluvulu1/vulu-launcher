<Project Sdk="Microsoft.NET.Sdk">

  <!--
    vulu Launcher'ın Android sürümü: aynı arayüz (Launcher/wwwroot) MAUI HybridWebView içinde, aynı komutlar ve
    servisler (Core). Faz 1: oyun başlatma yok; giriş, sosyal, mesajlar, paketler, sunucular ve Modrinth çalışır.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <AssemblyName>vuluLauncher.Android</AssemblyName>
    <RootNamespace>VuluLauncher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <ApplicationTitle>vulu Launcher</ApplicationTitle>
    <ApplicationId>com.vuluvulu.launcher</ApplicationId>
    <!-- Android sürümleri kendi numarasıyla ilerler; tools/android-build.ps1 -Version ile ikisini birlikte ezer.
         ApplicationVersion her APK'da artmalı (Android daha küçük numaralı APK'yı güncelleme olarak kabul etmez). -->
    <Version>0.1.1</Version>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>101</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <!-- APK telefona elle de kurulur: Debug'da da .NET derlemeleri APK'nın içinde olmalı (Fast Deployment yok) -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <Authors>vuluvulu1</Authors>
    <Company>vuluvulu1</Company>
    <Product>vulu Launcher</Product>
    <Copyright>Copyright (c) 2026 vuluvulu1. Licensed under AGPL-3.0.</Copyright>
  </PropertyGroup>

  <!-- Deneme APK'sı yalnızca telefonlar için (arm64); emülatör kullanılmıyor -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Yayın APK'sı: telefonlar (arm64). Kırpma kapalı: köprü ve servisler System.Text.Json'u yansımayla kullanır,
       kırpılırsa çalışma anında bozulurdu. İmza anahtarı android-build.ps1'den gelir (repoda değil).
       AOT ve marshal methods da kapalı: SDK Release'te ikisini varsayılan açar, ama AOT kırpılmamış derlemelerle
       desteklenmiyor (XA1030) ve bu ayarlarla derlenen 0.1.0 APK'sı açılır açılmaz kapanıyordu. Böylece yayın APK'sı
       telefonda denenen Debug APK'sıyla aynı şekilde çalışır (JIT), yalnızca hata ayıklayıcı olmadan. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Vulu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows sürümüyle aynı arayüz dosyaları; HybridWebView bunları Resources/Raw/wwwroot'tan yükler -->
    <MauiAsset Include="..\Launcher\wwwroot\**" LogicalName="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />

    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#141412" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#141412" BaseSize="128,128" />
  </ItemGroup>

</Project>
